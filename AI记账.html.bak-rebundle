   */
  function fillVars(tpl, ctx) {
    var s = String(tpl === undefined || tpl === null ? '' : tpl);
    return s.replace(/\{(\w+)\}/g, function (m0, name) {
      var fn = VARS[name];
      if (typeof fn !== 'function') { return '—'; }
