    if (sfx && typeof sfx.tierOf === 'function') { return sfx.tierOf(cents); }
    var yuan = (Number(cents) || 0) / 100;
    if (yuan >= 100) { return 3; }
    if (yuan >= 50) { return 2; }
    if (yuan >= 10) { return 1; }
    return 0;
  }

  /** 统一出口：音效 + 震动都走 sfx.js（缺模块时静默，主流程不受影响） */
