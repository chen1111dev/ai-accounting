<script>
/**
 * nlp.js — 自然语言账单解析器（纯函数，可 Node 直接测试）
 *
 * 对外主函数：parseBill(text, options) -> { items: BillDraft[], unparsed: string[] }
 *
 * BillDraft = {
 *   date: 'YYYY-MM-DD', amount: Number, category: String, note: String,
 *   motivation: '刚需'|'情绪', want: Boolean, type: 'expense'|'income',
 *   meal: String, raw: String
 * }
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);
  var DATA;
  if (isNode) {
    DATA = require('./data.js');
  } else {
    global.AJ = global.AJ || {};
    DATA = global.AJ.data;
  }

  var CATEGORIES = DATA.CATEGORIES;
  var CATEGORY_KEYWORDS = DATA.CATEGORY_KEYWORDS;
  var EMOTION_KEYWORDS = DATA.EMOTION_KEYWORDS;
  var WANT_KEYWORDS = DATA.WANT_KEYWORDS;
  var INCOME_KEYWORDS = DATA.INCOME_KEYWORDS;
  var DATE_WORDS = DATA.DATE_WORDS;
  var MEAL_WORDS = DATA.MEAL_WORDS;
  var STOP_WORDS = DATA.STOP_WORDS;
  var LEADING_CONNECTORS = DATA.LEADING_CONNECTORS;

  /** 连接词：出现即视为分句边界 */
  var CONNECTORS = ['还有', '然后', '另外', '加上', '以及', '顺便'];

  /** 停用词按长度倒序，保证 "买了" 先于 "买" 被剔除 */
  var STOP_SORTED = STOP_WORDS.slice().sort(function (a, b) {
    return b.length - a.length;
  });

  /* ------------------------------------------------------------------ */
  /* 通用工具                                                            */
  /* ------------------------------------------------------------------ */

  /** 补零到两位 */
  function pad2(n) {
    return n < 10 ? '0' + n : '' + n;
  }

  /** Date -> 'YYYY-MM-DD' */
  function toDateStr(date) {
    var d = (date instanceof Date) ? date : new Date(date);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  /** 四舍五入保留两位小数 */
  function round2(n) {
    var v = Number(n);
    if (!isFinite(v)) { return 0; }
    return Math.round((v + Number.EPSILON) * 100) / 100;
  }

  /**
   * 全角字符归一化：０-９ → 0-9，． → . ，；：！？ → 半角。
   * 归一化是 1:1 字符替换，不改变字符串长度，因此索引仍然有效。
   * @param {string} text
   * @return {string}
   */
  function normalizeWidth(text) {
    return String(text)
      .replace(/[\uFF10-\uFF19]/g, function (c) {
        return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
      })
      .replace(/\uFF0E/g, '.')
      .replace(/\uFF0C/g, ',')
      .replace(/\uFF1B/g, ';')
      .replace(/\uFF1A/g, ':')
      .replace(/\uFF01/g, '!')
      .replace(/\uFF1F/g, '?');
  }

  /* ------------------------------------------------------------------ */
  /* 中文数字                                                            */
  /* ------------------------------------------------------------------ */

  var CN_DIGITS = {
    '零': 0, '〇': 0, '一': 1, '壹': 1, '二': 2, '两': 2, '贰': 2,
    '三': 3, '叁': 3, '四': 4, '肆': 4, '五': 5, '伍': 5,
    '六': 6, '陆': 6, '七': 7, '柒': 7, '八': 8, '捌': 8, '九': 9, '玖': 9
  };

  var CN_UNITS = { '十': 10, '拾': 10, '百': 100, '佰': 100, '千': 1000, '仟': 1000 };

  /**
   * 中文数字转阿拉伯数字。
   * 支持：十八 / 五十 / 两百 / 一百二（120）/ 一百零二（102）/ 一千二（1200）
   * @param {string} cn 中文数字串
   * @return {number}
   */
  function chineseToNumber(cn) {
    if (!cn) { return 0; }
    var section = 0;
    var num = 0;
    var lastUnit = 0;
    var hasLing = false;
    var i;
    var c;
    for (i = 0; i < cn.length; i++) {
      c = cn.charAt(i);
      if (Object.prototype.hasOwnProperty.call(CN_DIGITS, c)) {
        num = CN_DIGITS[c];
        if (c === '零' || c === '〇') { hasLing = true; }
      } else if (Object.prototype.hasOwnProperty.call(CN_UNITS, c)) {
        var u = CN_UNITS[c];
        if (num === 0) { num = 1; }
        section += num * u;
        num = 0;
        lastUnit = u;
      }
    }
    var total = section + num;
    if (!hasLing && num > 0 && num < 10 && lastUnit >= 100) {
      total = section + num * (lastUnit / 10);
    }
    return total;
  }

  /* ------------------------------------------------------------------ */
  /* 金额识别                                                            */
  /* ------------------------------------------------------------------ */

  /** 判断区间是否与已识别金额重叠 */
  function overlaps(list, start, end) {
    var i;
    for (i = 0; i < list.length; i++) {
      if (start < list[i].end && end > list[i].start) { return true; }
    }
    return false;
  }

  var RE_ARABIC = /\d+(?:\.\d{1,2})?/g;
  var RE_CHINESE = /[零〇一二两三四五六七八九十百千]+/g;
  var RE_CN_UNIT_AFTER = /^(元|块钱|块|毛|角)/;
  var RE_CN_TRIGGER_BEFORE = /(花了|花费|付了|付款|支付|用了|一共|总共|合计|消费|充值|充了|买了|买|才|就|价格|价)$/;

  /**
   * 【统一排除表】数字后面紧跟这些字时，它表示"数量"或"时间"，不是钱。
   * 例：9点 / 3号线 / 30分钟 / 两包 / 三折 / 12岁
   * 注意：绝对不要把 元/块/毛/角/钱 放进来，否则所有金额都会被误杀。
   */
  var RE_NON_MONEY_SUFFIX = /^(点|号|线|楼|层|岁|折|个|只|张|份|杯|瓶|件|斤|袋|盒|碗|串|根|支|把|套|位|人|家|门|台|本|条|顿|箱|包|桶|罐|卷|片|颗|粒|双|次|天|年|月|日|时|分|秒|%|％)/;

  /**
   * 数量词子集：只用于"口语小数合成"场景。
   * 「十块三个包子」里的 "3" 是数量，不能和前面的 "十块" 合成 10.3。
   * 刻意不含 毛/角 —— 「399块9毛」仍然要合成 399.9。
   */
  var RE_QUANTITY_SUFFIX = /^(个|只|张|份|杯|瓶|件|斤|袋|盒|碗|串|根|支|把|套|位|人|条|顿|箱|包|桶|罐|卷|片|颗|粒|双)/;

  /** 口语法小数：9块9 / 19块9 / 3块5 -> 9.9 / 19.9 / 3.5 */
  var RE_ARABIC_DECIMAL = /(\d+)\s*(?:块|元)\s*([1-9])(?![\d.])/g;
  /** 口语法小数（中文数字）：五块五 / 两块五 -> 5.5 / 2.5 */
  var RE_CHINESE_DECIMAL = /([零〇一二两三四五六七八九十百千]+)\s*(?:块|元)\s*([一二三四五六七八九])(?![\d.一二三四五六七八九十百千])/g;

  /**
   * 取 idx 处的后置字符片段（允许跳过最多 1 个空格，兼容 "9 点"）。
   * @param {string} text
   * @param {number} idx
   * @return {string} 最多两个字符
   */
  function suffixAt(text, idx) {
    var i = idx;
    if (i < text.length && text.charAt(i) === ' ') { i++; }
    return text.slice(i, i + 2);
  }

  /**
   * 统一判定：idx 处是否紧跟"非金额单位"（数量词 / 时间词）。
   * 三处扫描（阿拉伯数字、小数预扫描、中文数字）复用此函数，逻辑只有一份。
   * @param {string} text
   * @param {number} idx 数字结束位置
   * @return {boolean}
   */
  function isNonMoneySuffix(text, idx) {
    return RE_NON_MONEY_SUFFIX.test(suffixAt(text, idx));
  }

  /**
   * 统一判定：idx 处是否是"数量词"（用于小数合成场景）。
   * @param {string} text
   * @param {number} idx
   * @return {boolean}
   */
  function isQuantitySuffix(text, idx) {
    return RE_QUANTITY_SUFFIX.test(suffixAt(text, idx));
  }

  /**
   * 从文本中按出现顺序抽取所有金额。
   * 阿拉伯数字直接采信；中文数字必须带单位或带触发动词，避免 "三食堂" 被误判。
   * "9块9" 这类口语小数先合成一笔，避免被拆成 9 和 9 两笔。
   * @param {string} text
   * @return {Array<{value:number,start:number,end:number,raw:string}>}
   */
  function findAmounts(text) {
    var out = [];
    var m;
    var v;

    /* ① 预扫描：口语小数（数字 + 块/元 + 个位数字） */
    RE_ARABIC_DECIMAL.lastIndex = 0;
    while ((m = RE_ARABIC_DECIMAL.exec(text)) !== null) {
      var whole = Number(m[1]);
      var dec = Number(m[2]);
      if (!isFinite(whole) || !isFinite(dec)) { continue; }
      // 尾部数字后面若是"数量词"，说明它是数量不是角分（十块三个包子 -> 10，不是 10.3）；
      // 若是 毛/角 则照常合成小数（399块9毛 -> 399.9）
      var decEnd = m.index + m[0].length;
      if (isQuantitySuffix(text, decEnd)) { continue; }
      out.push({
        value: round2(whole + dec / 10),
        start: m.index,
        end: decEnd,
        raw: m[0]
      });
    }

    /* ①b 预扫描：中文数字口语小数（五块五） */
    RE_CHINESE_DECIMAL.lastIndex = 0;
    while ((m = RE_CHINESE_DECIMAL.exec(text)) !== null) {
      var cs = m.index;
      var ce = m.index + m[0].length;
      if (overlaps(out, cs, ce)) { continue; }
      if (isQuantitySuffix(text, ce)) { continue; }
      var wholeCn = chineseToNumber(m[1]);
      var decCn = chineseToNumber(m[2]);
      if (wholeCn > 0 && decCn > 0) {
        out.push({
          value: round2(wholeCn + decCn / 10),
          start: cs,
          end: ce,
          raw: m[0]
        });
      }
    }

    /* ② 阿拉伯数字（跳过已被预扫描消费的区间 / 后跟非金额单位） */
    RE_ARABIC.lastIndex = 0;
    while ((m = RE_ARABIC.exec(text)) !== null) {
      var aStart = m.index;
      var aEnd = m.index + m[0].length;
      if (overlaps(out, aStart, aEnd)) { continue; }
      // 9点 / 3号线 / 30分钟 / 两包 都不是钱
      if (isNonMoneySuffix(text, aEnd)) { continue; }
      v = parseFloat(m[0]);
      if (!isNaN(v) && v > 0) {
        out.push({ value: v, start: aStart, end: aEnd, raw: m[0] });
      }
    }

    RE_CHINESE.lastIndex = 0;
    while ((m = RE_CHINESE.exec(text)) !== null) {
      var s = m.index;
      var e = m.index + m[0].length;
      if (overlaps(out, s, e)) { continue; }
      var after = text.slice(e, e + 3);
      var before = text.slice(Math.max(0, s - 6), s);
      var hasUnit = RE_CN_UNIT_AFTER.test(after);
      if (hasUnit) {
        // 五块 / 二十元：直接采信
      } else if (isNonMoneySuffix(text, e)) {
        // 一双鞋 / 三百米 / 十点 / 三折：数字后跟非金额单位，视为非金额
        continue;
      } else {
        var atEnd = (e >= text.length) || /^[，。；、,!！?？~～\s]/.test(after);
        var hasTrigger = RE_CN_TRIGGER_BEFORE.test(before);
        // 句末的两位以上中文数字（"打车二十"）也视为金额
        var isTrailingAmount = atEnd && m[0].length >= 2;
        if (!hasTrigger && !isTrailingAmount) { continue; }
      }
      var cnVal = chineseToNumber(m[0]);
      if (cnVal > 0 && cnVal < 1000000) {
        out.push({ value: cnVal, start: s, end: e, raw: m[0] });
      }
    }

    out.sort(function (a, b) { return a.start - b.start; });
    return out;
  }

  /* ------------------------------------------------------------------ */
  /* 分句                                                                */
  /* ------------------------------------------------------------------ */

  /**
   * 按标点与连接词切分句子。
   * @param {string} text
   * @return {string[]}
   */
  function splitSentences(text) {
    var t = String(text);
    var i;
    for (i = 0; i < CONNECTORS.length; i++) {
      t = t.split(CONNECTORS[i]).join('|');
    }
    var raw = t.split(/[，。；、,;!！?？~～\n\r|]+/);
    var out = [];
    for (i = 0; i < raw.length; i++) {
      var s = raw[i].trim();
      if (s) { out.push(s); }
    }
    return out;
  }

  /**
   * 把无金额的分句合并到相邻分句，返回"必定含金额"的语义组。
   * @param {string} text
   * @return {string[]}
   */
  function buildGroups(text) {
    var sentences = splitSentences(text);
    var groups = [];
    var pending = '';
    var i;
    for (i = 0; i < sentences.length; i++) {
      var s = sentences[i];
      if (findAmounts(s).length > 0) {
        groups.push(pending + s);
        pending = '';
      } else {
        pending += s;
      }
    }
    if (pending) {
      if (groups.length > 0) {
        groups[groups.length - 1] += pending;
      } else {
        groups.push(pending);
      }
    }
    return groups;
  }

  /**
   * 组内按金额数量切段：一句话多笔时按顺序配对。
   * 例："打车 15 和奶茶 12" -> ["打车 15", "和奶茶 12"]
   * @param {string} groupText
   * @return {Array<{text:string, amount:number}>}
   */
  function splitByAmounts(groupText) {
    var amts = findAmounts(groupText);
    if (amts.length === 0) { return []; }
    var parts = [];
    var cursor = 0;
    var i;
    for (i = 0; i < amts.length; i++) {
      parts.push({ text: groupText.slice(cursor, amts[i].end), amount: amts[i].value, raw: amts[i].raw });
      cursor = amts[i].end;
    }
    if (cursor < groupText.length) {
      parts[parts.length - 1].text += groupText.slice(cursor);
    }
    return parts;
  }

  /* ------------------------------------------------------------------ */
  /* 时间 / 餐段                                                         */
  /* ------------------------------------------------------------------ */

  /** 按当前钟点推断餐段 */
  function inferMealByHour(hour) {
    if (hour < 10) { return '早餐'; }
    if (hour >= 11 && hour <= 14) { return '午餐'; }
    if (hour >= 17 && hour <= 21) { return '晚餐'; }
    return '';
  }

  /**
   * 解析时间词与餐段词。
   * @param {string} text
   * @param {Date} now 基准时间
   * @return {{date:string, meal:string, hasDate:boolean}}
   */
  function parseTime(text, now) {
    var offset = null;
    var meal = '';
    var hasDate = false;
    var i;
    for (i = 0; i < DATE_WORDS.length; i++) {
      if (text.indexOf(DATE_WORDS[i].word) !== -1) {
        offset = DATE_WORDS[i].offset;
        hasDate = true;
        break;
      }
    }
    for (i = 0; i < MEAL_WORDS.length; i++) {
      if (text.indexOf(MEAL_WORDS[i].word) !== -1) {
        meal = MEAL_WORDS[i].meal;
        break;
      }
    }
    var d = new Date(now.getTime());
    d.setDate(d.getDate() + (offset === null ? 0 : offset));
    return { date: toDateStr(d), meal: meal, hasDate: hasDate };
  }

  /* ------------------------------------------------------------------ */
  /* 收入 / 分类 / 动机                                                  */
  /* ------------------------------------------------------------------ */

  var RE_EXPENSE_VERB = /(花了|付了|买了|支付|消费|充了|充值|交了)/;
  var RE_REDPACKET_IN = /(收到|收了|领到|领了|抢到|抢了|来了|给我发|退回)/;

  /**
   * 判断该句是否为收入。
   * @param {string} text
   * @return {boolean}
   */
  function detectIncome(text) {
    if (RE_EXPENSE_VERB.test(text)) { return false; }
    if (text.indexOf('红包') !== -1) {
      return RE_REDPACKET_IN.test(text);
    }
    var i;
    for (i = 0; i < INCOME_KEYWORDS.length; i++) {
      if (text.indexOf(INCOME_KEYWORDS[i]) !== -1) { return true; }
    }
    return false;
  }

  /**
   * 推断收入来源（生活费 / 兼职 / 奖学金 / 助学金 / 红包 / 退款 / 其他）。
   * @param {string} text
   * @return {string}
   */
  function detectIncomeSource(text) {
    var groups = DATA.INCOME_SOURCE_KEYWORDS || [];
    var i;
    var j;
    var t = String(text || '');
    for (i = 0; i < groups.length; i++) {
      for (j = 0; j < groups[i].keywords.length; j++) {
        if (t.indexOf(groups[i].keywords[j]) !== -1) {
          return groups[i].source;
        }
      }
    }
    return '其他';
  }

  /** 强社交信号：命中即显著抬高"社交"分类得分（"火锅AA"/"和舍友吃饭" 应判社交而非餐饮） */
  var SOCIAL_BOOST_WORDS = ['AA', '聚餐', '请客', '请吃', '舍友', '室友', '同学', '朋友'];

  /**
   * 分类打分：最长命中词长度 * 10 + 命中词个数，平手按 CATEGORIES 顺序取先者。
   * @param {string} text
   * @return {string} 分类 key
   */
  function classify(text) {
    var bestKey = '其他';
    var bestScore = 0;
    var i;
    var j;
    var socialBoost = 0;
    for (i = 0; i < SOCIAL_BOOST_WORDS.length; i++) {
      if (text.indexOf(SOCIAL_BOOST_WORDS[i]) !== -1) { socialBoost += 8; }
    }
    for (i = 0; i < CATEGORIES.length; i++) {
      var key = CATEGORIES[i].key;
      var kws = CATEGORY_KEYWORDS[key];
      if (!kws) { continue; }
      var maxLen = 0;
      var hits = 0;
      for (j = 0; j < kws.length; j++) {
        if (text.indexOf(kws[j]) !== -1) {
          hits++;
          if (kws[j].length > maxLen) { maxLen = kws[j].length; }
        }
      }
      if (hits === 0) { continue; }
      var score = maxLen * 10 + hits;
      if (key === '社交') { score += socialBoost; }
      if (score > bestScore) {
        bestScore = score;
        bestKey = key;
      }
    }
    return bestKey;
  }

  /**
   * 消费动机判定。
   * @param {string} text
   * @return {{motivation:string, want:boolean}}
   */
  function detectMotivation(text) {
    var isEmotion = false;
    var want = false;
    var i;
    for (i = 0; i < EMOTION_KEYWORDS.length; i++) {
      if (text.indexOf(EMOTION_KEYWORDS[i]) !== -1) {
        isEmotion = true;
        break;
      }
    }
    for (i = 0; i < WANT_KEYWORDS.length; i++) {
      if (text.indexOf(WANT_KEYWORDS[i]) !== -1) {
        want = true;
        break;
      }
    }
    return { motivation: isEmotion ? '情绪' : '刚需', want: want };
  }

  /* ------------------------------------------------------------------ */
  /* 备注                                                                */
  /* ------------------------------------------------------------------ */

  /**
   * 生成备注：剔除金额、时间词、动词量词后剩余文本；为空用分类名 / 餐段兜底。
   * @param {string} segText 单笔对应的原始片段
   * @param {string} category 分类
   * @param {string} meal 餐段
   * @return {string}
   */
  function buildNote(segText, category, meal) {
    var t = String(segText);
    // 先整体抹掉"数字 + 非金额单位"的时间/数量表达（12点 / 3号线 / 30分钟 / 20岁），
    // 避免备注里残留孤零零的"点""号线"
    t = t.replace(/\d+(?:\.\d{1,2})?\s*(?:点钟|点|号线|号|分钟|小时|个月|岁|折|楼|层)/g, ' ');
    t = t.replace(/\d+(?:\.\d{1,2})?/g, ' ');
    t = t.replace(/[零〇一二两三四五六七八九十百千]+(?:元|块钱|块|毛|角)/g, ' ');
    t = t.replace(/[，。；、,!！?？~～|]+/g, ' ');
    var i;
    for (i = 0; i < LEADING_CONNECTORS.length; i++) {
      if (t.replace(/^\s+/, '').indexOf(LEADING_CONNECTORS[i]) === 0) {
        t = t.replace(/^\s+/, '').slice(LEADING_CONNECTORS[i].length);
        break;
      }
    }
    for (i = 0; i < STOP_SORTED.length; i++) {
      t = t.split(STOP_SORTED[i]).join(' ');
    }
    t = t.replace(/\s+/g, ' ').trim();
    t = t.replace(/^[的与及]+/, '').trim();
    // 清掉残留的孤立中文数字（如 "一 鞋" -> "鞋"）
    t = t.replace(/(^|\s)[零〇一二两三四五六七八九十百千]+(?=\s|$)/g, ' ');
    t = t.replace(/\s+/g, ' ').trim();
    if (!t) { t = meal || category; }
    return t;
  }

  /* ------------------------------------------------------------------ */
  /* 主函数                                                              */
  /* ------------------------------------------------------------------ */

  /**
   * 解析一句自然语言，得到若干笔账单草稿。
   * @param {string} text 用户输入
   * @param {{now?:Date}} [options] 基准时间（便于测试）
   * @return {{items:Array, unparsed:string[]}}
   */
  function parseBill(text, options) {
    var opts = options || {};
    var now = opts.now ? new Date(opts.now) : new Date();
    var result = { items: [], unparsed: [] };
    if (typeof text !== 'string' || !text.trim()) { return result; }
    text = normalizeWidth(text);

    var groups = buildGroups(text);
    var lastDate = null;
    var i;
    var j;

    for (i = 0; i < groups.length; i++) {
      var parts = splitByAmounts(groups[i]);
      for (j = 0; j < parts.length; j++) {
        var part = parts[j];
        var noteSource = part.text;
        // 先把已识别的金额原文从备注里剔除（中文数字金额没有单位时尤其需要）
        if (part.raw) {
          var pos = noteSource.lastIndexOf(part.raw);
          if (pos >= 0) {
            noteSource = noteSource.slice(0, pos) + ' ' + noteSource.slice(pos + part.raw.length);
          }
        }
        // 一句多笔时，"和/跟/与" 属于连接词，不属于备注内容
        if (parts.length > 1 && j > 0) {
          noteSource = noteSource.replace(/^\s*(和|跟|与|还有|然后|另外|加上|以及|顺便|再)\s*/, '');
        }
        var time = parseTime(part.text, now);
        if (time.hasDate) { lastDate = time.date; }
        var date = lastDate || toDateStr(now);
        var meal = time.meal || inferMealByHour(now.getHours());
        var income = detectIncome(part.text);
        var category = income ? (DATA.INCOME_CATEGORY || '收入') : classify(part.text);
        // 分段后上下文可能丢失（"9块9的奶茶和18块的黄焖鸡" 的 "奶茶" 被切到下一段），
        // 单段打不出分类时回退到整句再打一次分，仍无命中才归"其他"。
        if (!income && category === '其他') {
          var ctxCategory = classify(text);
          if (ctxCategory !== '其他') { category = ctxCategory; }
        }
        var motive = detectMotivation(part.text);
        var note = buildNote(noteSource, category, meal);

        result.items.push({
          date: date,
          amount: round2(part.amount),
          category: category,
          source: income ? detectIncomeSource(part.text) : '',
          note: note,
          motivation: income ? '刚需' : motive.motivation,
          want: income ? false : motive.want,
          type: income ? 'income' : 'expense',
          meal: meal,
          raw: part.text.trim()
        });
      }
    }

    if (result.items.length === 0) {
      result.unparsed.push(String(text).trim());
    }
    return result;
  }

  var API = {
    parseBill: parseBill,
    findAmounts: findAmounts,
    splitSentences: splitSentences,
    buildGroups: buildGroups,
    splitByAmounts: splitByAmounts,
    parseTime: parseTime,
    classify: classify,
    detectIncome: detectIncome,
    detectIncomeSource: detectIncomeSource,
    detectMotivation: detectMotivation,
    buildNote: buildNote,
    chineseToNumber: chineseToNumber,
    normalizeWidth: normalizeWidth,
    inferMealByHour: inferMealByHour,
    toDateStr: toDateStr,
    round2: round2
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.nlp = API;
  }
})(typeof globalThis !== 'undefined' ? globalThis : this);

  </script>
<script>
/**
 * engine.js — 预算引擎 / 平替建议 / 冷静期 / 目标测算（纯函数，可 Node 直接测试）
 *
 * 对外主要 API：
 *   getCycle(today, payday, cycleLen)
 *   getBudgetState({total, spent, remainingDays, todaySpent})
 *   simulatePurchase({amount, state, remainingDays})
 *   getAlternative(item)
 *   getGoalProjection(goal, monthlySurplus, today)
 *   aggregate(bills, startDate, endDate)
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);
  var DATA;
  if (isNode) {
    DATA = require('./data.js');
  } else {
    global.AJ = global.AJ || {};
    DATA = global.AJ.data;
  }

  var ALTERNATIVES = DATA.ALTERNATIVES;
  var CATEGORY_KEYS = DATA.CATEGORY_KEYS;
  var CATEGORY_KEYWORDS = DATA.CATEGORY_KEYWORDS;
  var ALL_MERCHANTS = DATA.MERCHANTS;
  var COOLDOWN_KEYWORDS = DATA.COOLDOWN_KEYWORDS;

  /** 业务规则：餐饮支出占比超过 60% 触发恩格尔预警 */
  var ENGEL_ALERT_RATIO = 0.6;

  var MS_PER_DAY = 24 * 60 * 60 * 1000;

  /* ------------------------------------------------------------------ */
  /* 基础工具                                                            */
  /* ------------------------------------------------------------------ */

  function pad2(n) {
    return n < 10 ? '0' + n : '' + n;
  }

  /** 任意值转 Date（支持 'YYYY-MM-DD' / Date / 时间戳） */
  function toDate(value) {
    if (value instanceof Date) {
      return new Date(value.getFullYear(), value.getMonth(), value.getDate());
    }
    if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
      var p = value.split('-');
      return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
    }
    var d = new Date(value === undefined || value === null ? Date.now() : value);
    if (isNaN(d.getTime())) { return new Date(); }
    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
  }

  /** Date -> 'YYYY-MM-DD' */
  function formatDate(value) {
    var d = toDate(value);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  /** 日期加天数 */
  function addDays(value, days) {
    var d = toDate(value);
    d.setDate(d.getDate() + Math.round(days));
    return d;
  }

  /** b - a 的天数差 */
  function diffDays(a, b) {
    var da = toDate(a);
    var db = toDate(b);
    return Math.round((db.getTime() - da.getTime()) / MS_PER_DAY);
  }

  function num(v) {
    var n = Number(v);
    return isFinite(n) ? n : 0;
  }

  function round2(n) {
    var v = Number(n);
    if (!isFinite(v)) { return 0; }
    return Math.round((v + Number.EPSILON) * 100) / 100;
  }

  /** 一位小数金额，用于文案 */
  function fmt1(n) {
    var v = round2(n);
    return Math.abs(v - Math.round(v)) < 0.05 ? String(Math.round(v)) : v.toFixed(1);
  }

  /** 两位小数金额，带千分位 */
  function fmtMoney(n) {
    var v = round2(n);
    var neg = v < 0;
    var abs = Math.abs(v);
    var s = abs.toFixed(2);
    var parts = s.split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return (neg ? '-¥' : '¥') + parts[0] + '.' + parts[1];
  }

  function clampInt(v, min, max, fallback) {
    var n = Math.round(num(v));
    if (!isFinite(n) || n < min || n > max) { return fallback; }
    return n;
  }

  /* ------------------------------------------------------------------ */
  /* 周期                                                                */
  /* ------------------------------------------------------------------ */

  /**
   * 按"发生活费日"计算当前预算周期。
   * 发钱日 15 号则周期为 15 号到次月 14 号。
   *
   * 第 3 参同时兼容三种写法（保持 v1 调用方零改动）：
   *   getCycle(today, payday)                       // v1 行为
   *   getCycle(today, payday, 30)                   // 固定周期长度（v1 已支持）
   *   getCycle(today, payday, null, '2025-10-23')    // 自定义起点
   *   getCycle(today, payday, '2025-10-23')         // 自定义起点（便捷写法）
   *
   * @param {Date|string} today 今天
   * @param {number} payday 发钱日（1-28）
   * @param {number|string} [cycleLenOrStart] 周期长度（天）或自定义起点 'YYYY-MM-DD'
   * @param {string} [overrideStart] 自定义起点 'YYYY-MM-DD'
   * @return {{start:string,end:string,totalDays:number,passedDays:number,remainingDays:number,isCustom:boolean}}
   */
  function getCycle(today, payday, cycleLenOrStart, overrideStart) {
    var now = toDate(today);
    var pd = clampInt(payday, 1, 28, 1);
    var cycleLen = 0;
    var customStart = null;
    var arg3 = cycleLenOrStart;

    if (typeof arg3 === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(arg3)) {
      customStart = arg3;
    } else if (typeof arg3 === 'number' && arg3 >= 1) {
      cycleLen = Math.round(arg3);
    } else if (arg3 && typeof arg3 === 'object') {
      if (typeof arg3.cycleLen === 'number' && arg3.cycleLen >= 1) {
        cycleLen = Math.round(arg3.cycleLen);
      }
      if (typeof arg3.overrideStart === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(arg3.overrideStart)) {
        customStart = arg3.overrideStart;
      }
    }
    if (typeof overrideStart === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(overrideStart)) {
      customStart = overrideStart;
    }

    /* ---- 分支 A：自定义起点（必须 <= 今天才生效，否则回退发钱日） ---- */
    var start;
    var end;
    var isCustom = false;

    if (customStart) {
      var cs = toDate(customStart);
      if (cs.getTime() <= now.getTime()) {
        start = cs;
        // 该起点之后（严格晚于起点）的第一个发钱日，再减 1 天
        var nextPayday = new Date(cs.getFullYear(), cs.getMonth(), pd);
        if (nextPayday.getTime() <= cs.getTime()) {
          nextPayday = new Date(cs.getFullYear(), cs.getMonth() + 1, pd);
        }
        end = addDays(nextPayday, -1);
        isCustom = true;
      }
    }

    /* ---- 分支 B：v1 行为（发钱日推算 / 固定长度） ---- */
    if (!isCustom) {
      var y = now.getFullYear();
      var m = now.getMonth();
      var d = now.getDate();
      start = (d >= pd) ? new Date(y, m, pd) : new Date(y, m - 1, pd);
      if (cycleLen > 0) {
        end = addDays(start, cycleLen - 1);
      } else {
        end = addDays(new Date(start.getFullYear(), start.getMonth() + 1, pd), -1);
      }
    }

    var totalDays = diffDays(start, end) + 1;
    if (totalDays < 1) { totalDays = 1; }
    var passedDays = diffDays(start, now) + 1;
    if (passedDays < 1) { passedDays = 1; }
    if (passedDays > totalDays) { passedDays = totalDays; }
    var remainingDays = totalDays - passedDays + 1;
    if (remainingDays < 1) { remainingDays = 1; }

    return {
      start: formatDate(start),
      end: formatDate(end),
      totalDays: totalDays,
      passedDays: passedDays,
      remainingDays: remainingDays,
      isCustom: isCustom
    };
  }

  /* ------------------------------------------------------------------ */
  /* 预算状态                                                            */
  /* ------------------------------------------------------------------ */

  /**
   * 计算预算状态。
   * @param {{total:number, spent:number, remainingDays:number, todaySpent?:number}} opts
   * @return {{remaining:number, dailyAllowance:number, isOver:boolean, overBy:number,
   *           todayRemain:number, status:string, spendPercent:number}}
   */
  function getBudgetState(opts) {
    var o = opts || {};
    var total = num(o.total);
    var spent = num(o.spent);
    var remainingDays = Math.max(1, Math.round(num(o.remainingDays) || 1));
    var todaySpent = num(o.todaySpent);

    var remaining = round2(total - spent);
    var dailyAllowance = round2(remaining / remainingDays);
    var isOver = remaining < 0;
    var overBy = isOver ? round2(-remaining) : 0;
    var todayRemain = round2(Math.max(0, dailyAllowance - todaySpent));
    var spendPercent = total > 0 ? round2(Math.min(999, spent / total * 100)) : 0;

    var status;
    if (remaining <= 0) {
      status = 'danger';
    } else if (dailyAllowance < 20) {
      status = 'danger';
    } else if (dailyAllowance < 40) {
      status = 'tight';
    } else {
      status = 'safe';
    }

    return {
      remaining: remaining,
      dailyAllowance: dailyAllowance,
      isOver: isOver,
      overBy: overBy,
      todaySpent: round2(todaySpent),
      todayRemain: todayRemain,
      status: status,
      spendPercent: spendPercent
    };
  }

  /* ------------------------------------------------------------------ */
  /* 购买模拟                                                            */
  /* ------------------------------------------------------------------ */

  /**
   * 模拟一笔消费对日均可用额度的影响。
   * @param {{amount:number, state:Object, remainingDays:number}} opts
   * @return {{verdict:string,newDaily:number,afterBalance:number,noodleDays:number,message:string}}
   */
  function simulatePurchase(opts) {
    var o = opts || {};
    var amount = num(o.amount);
    var state = o.state || {};
    var remainingDays = Math.max(1, Math.round(num(o.remainingDays) || num(state.remainingDays) || 1));
    var remaining = num(state.remaining);

    var afterBalance = round2(remaining - amount);
    var newDaily = round2(afterBalance / remainingDays);
    var verdict = 'ok';
    var noodleDays = 0;
    var message;

    if (afterBalance < 0) {
      verdict = 'danger';
      noodleDays = remainingDays;
      message = '买完这笔，本周期生活费直接超支 ¥' + fmt1(-afterBalance) +
        '，接下来 ' + remainingDays + ' 天只能靠 ' + noodleDays + ' 天泡面配食堂免费汤。';
      return {
        verdict: verdict,
        newDaily: newDaily,
        afterBalance: afterBalance,
        noodleDays: noodleDays,
        message: message
      };
    }

    if (newDaily < 15) {
      verdict = 'danger';
      noodleDays = Math.max(1, Math.ceil((15 - newDaily) / 15 * remainingDays));
      message = '买完这笔，接下来 ' + remainingDays + ' 天日均只剩 ¥' + fmt1(newDaily) +
        '。真买的话大概要 ' + noodleDays + ' 天泡面配食堂免费汤。';
    } else if (newDaily < 30) {
      verdict = 'tight';
      message = '买完这笔，接下来 ' + remainingDays + ' 天日均只剩 ¥' + fmt1(newDaily) +
        '，只够吃食堂，别的花销先停一停吧。';
    } else {
      verdict = 'ok';
      message = '买完这笔，接下来 ' + remainingDays + ' 天日均还有 ¥' + fmt1(newDaily) +
        '，问题不大，放心买。';
    }

    return {
      verdict: verdict,
      newDaily: newDaily,
      afterBalance: afterBalance,
      noodleDays: noodleDays,
      message: message
    };
  }

  /* ------------------------------------------------------------------ */
  /* 平替推荐                                                            */
  /* ------------------------------------------------------------------ */

  /**
   * 查找校园平替方案。
   * @param {string|{note?:string,category?:string,amount?:number}} item
   * @return {?{id:string,brand:string,altName:string,altPrice:number,paid:number,
   *            save:number,weeklySave:number,times:number,unit:string,tip:string}}
   */
  function getAlternative(item) {
    var text = '';
    var paidAmount = 0;
    if (typeof item === 'string') {
      text = item;
    } else if (item && typeof item === 'object') {
      text = (item.note || '') + ' ' + (item.category || '');
      paidAmount = num(item.amount);
    }
    if (!text.trim()) { return null; }

    var best = null;
    var bestLen = 0;
    var i;
    var j;
    for (i = 0; i < ALTERNATIVES.length; i++) {
      var alt = ALTERNATIVES[i];
      for (j = 0; j < alt.keywords.length; j++) {
        var kw = alt.keywords[j];
        if (text.indexOf(kw) !== -1 && kw.length > bestLen) {
          best = alt;
          bestLen = kw.length;
        }
      }
    }
    if (!best) { return null; }

    // 取"品牌单价"与"实付金额"中较小的一个：
    // ① 批量消费（一次打印 36 元）不会算出几十元的荒谬省钱数；
    // ② 用券后实付很低时，省钱额也随之收敛，不会出现"省的钱比花的多"。
    var effectivePaid = best.brandPrice;
    if (paidAmount > 0 && paidAmount < effectivePaid) {
      effectivePaid = paidAmount;
    }
    // 实付都不够买平替（用券场景），推荐没有意义，直接不返回
    if (effectivePaid <= best.altPrice) { return null; }

    var save = round2(effectivePaid - best.altPrice);
    var times = (typeof best.times === 'number' && best.times > 0) ? best.times : 1;
    return {
      id: best.id,
      brand: best.brand,
      altName: best.altName,
      altPrice: round2(best.altPrice),
      paid: round2(effectivePaid),
      save: save,
      times: times,
      weeklySave: round2(save * times),
      unit: best.unit,
      tip: best.tip || best.timesText
    };
  }

  /* ------------------------------------------------------------------ */
  /* 汇总                                                                */
  /* ------------------------------------------------------------------ */

  /**
   * 汇总指定日期区间内的账单。
   * @param {Array} bills
   * @param {string} [startDate] 'YYYY-MM-DD'，含
   * @param {string} [endDate] 'YYYY-MM-DD'，含
   * @return {{expense:number,income:number,count:number,byCategory:Object,dailyMap:Object}}
   */
  function aggregate(bills, startDate, endDate) {
    /* 容错：调用方若传 Date，内部比较（b.date 是 YYYY-MM-DD 字符串）会静默失效、
       退化成统计全量账单。这里统一归一到日期串，避免周期/环比口径算错。 */
    if (startDate instanceof Date) { startDate = formatDate(startDate); }
    if (endDate instanceof Date) { endDate = formatDate(endDate); }
    var result = {
      expense: 0,
      income: 0,
      count: 0,
      byCategory: {},
      dailyMap: {}
    };
    var i;
    for (i = 0; i < CATEGORY_KEYS.length; i++) {
      result.byCategory[CATEGORY_KEYS[i]] = 0;
    }
    var list = Array.isArray(bills) ? bills : [];
    for (i = 0; i < list.length; i++) {
      var b = list[i];
      if (!b || !b.date) { continue; }
      if (startDate && b.date < startDate) { continue; }
      if (endDate && b.date > endDate) { continue; }
      var amount = num(b.amount);
      if (b.type === 'income') {
        result.income = round2(result.income + amount);
        continue;
      }
      result.count++;
      result.expense = round2(result.expense + amount);
      if (!Object.prototype.hasOwnProperty.call(result.byCategory, b.category)) {
        result.byCategory[b.category] = 0;
      }
      result.byCategory[b.category] = round2(result.byCategory[b.category] + amount);
      result.dailyMap[b.date] = round2((result.dailyMap[b.date] || 0) + amount);
    }
    return result;
  }

  /**
   * 恩格尔系数（餐饮支出 / 总支出）。
   * @param {Object} byCategory aggregate().byCategory
   * @return {{ratio:number, percent:number, alert:boolean}}
   */
  function getEngel(byCategory, totalExpense) {
    var food = num(byCategory && byCategory['餐饮']);
    var total = num(totalExpense);
    var ratio = total > 0 ? food / total : 0;
    var percent = round2(ratio * 100);
    return { ratio: ratio, percent: percent, alert: percent > 60 };
  }

  /**
   * 业务规则 1：从记账语句里提取「商家」（南海北区商家词典，最长词优先）。
   * @param {string} text 原始语句 / 备注
   * @return {string} 商家名，未命中返回 ''
   */
  function extractMerchant(text) {
    var s = String(text || '');
    if (!s) { return ''; }
    var best = '';
    var bestLen = 0;
    for (var i = 0; i < ALL_MERCHANTS.length; i++) {
      var m = ALL_MERCHANTS[i];
      for (var j = 0; j < m.words.length; j++) {
        var w = m.words[j];
        if (s.indexOf(w) !== -1 && w.length > bestLen) {
          best = m.key;
          bestLen = w.length;
        }
      }
    }
    return best;
  }

  /**
   * 业务规则：单笔非刚需支出（游戏充值、盲盒、潮玩、超出日常预算的聚会）命中关键词。
   * @param {Object|string} billOrText
   * @return {boolean}
   */
  function hitsCooldownKeyword(billOrText) {
    var text = '';
    if (typeof billOrText === 'string') {
      text = billOrText;
    } else if (billOrText) {
      text = (billOrText.note || '') + ' ' + (billOrText.category || '');
    }
    if (!text) { return false; }
    for (var i = 0; i < COOLDOWN_KEYWORDS.length; i++) {
      if (text.indexOf(COOLDOWN_KEYWORDS[i]) !== -1) { return true; }
    }
    return false;
  }

  /**
   * 周期收支概览（看板「收支概览」卡数据源）。
   * 储蓄率 = (收入 - 支出) / 收入 * 100；收入为 0 时返回 null，避免 NaN / Infinity。
   * @param {Array} bills 账单
   * @param {{start:string,end:string}} cycle 周期（getCycle 返回值）
   * @return {{income:number,expense:number,balance:number,savingsRate:?number,
   *           incomeCount:number,expenseCount:number,hasIncome:boolean}}
   */
  function getIncomeStats(bills, cycle) {
    var c = cycle || {};
    var agg = aggregate(bills, c.start, c.end);
    var income = round2(agg.income);
    var expense = round2(agg.expense);
    var balance = round2(income - expense);
    var savingsRate = income > 0 ? round2(balance / income * 100) : null;
    var incomeCount = 0;
    var list = Array.isArray(bills) ? bills : [];
    var i;
    for (i = 0; i < list.length; i++) {
      var b = list[i];
      if (!b || !b.date || b.type !== 'income') { continue; }
      if (c.start && b.date < c.start) { continue; }
      if (c.end && b.date > c.end) { continue; }
      incomeCount++;
    }
    return {
      income: income,
      expense: expense,
      balance: balance,
      savingsRate: savingsRate,
      incomeCount: incomeCount,
      expenseCount: agg.count,
      hasIncome: income > 0
    };
  }

  /* ------------------------------------------------------------------ */
  /* 目标测算                                                            */
  /* ------------------------------------------------------------------ */

  /**
   * 计算目标进度与"还需几个月"。
   * @param {{name:string,target:number,saved:number,deadline:string}} goal
   * @param {number} monthlySurplus 每月可结余金额
   * @param {Date|string} today
   * @return {{need:number,percent:number,monthsLeft:?number,monthsToDeadline:?number,
   *           lateMonths:?number,extraPerMonth:number}}
   */
  function getGoalProjection(goal, monthlySurplus, today) {
    var g = goal || {};
    var target = num(g.target);
    var saved = num(g.saved);
    var surplus = Math.max(0, num(monthlySurplus));
    var need = round2(Math.max(0, target - saved));
    var percent = target > 0 ? round2(Math.min(100, saved / target * 100)) : 0;

    var monthsLeft = null;
    if (need <= 0) {
      monthsLeft = 0;
    } else if (surplus > 0) {
      monthsLeft = Math.ceil(need / surplus);
    }

    var monthsToDeadline = null;
    if (g.deadline && /^\d{4}-\d{2}-\d{2}$/.test(g.deadline)) {
      var days = diffDays(toDate(today), toDate(g.deadline));
      monthsToDeadline = days <= 0 ? 0 : Math.ceil(days / 30.44);
    }

    var lateMonths = null;
    var extraPerMonth = 0;
    if (monthsToDeadline !== null) {
      if (monthsLeft !== null) {
        lateMonths = Math.max(0, monthsLeft - monthsToDeadline);
      }
      if (need > 0 && monthsToDeadline > 0) {
        var needPerMonth = need / monthsToDeadline;
        extraPerMonth = Math.max(0, Math.ceil(round2(needPerMonth - surplus)));
      }
    }

    return {
      need: need,
      percent: percent,
      monthsLeft: monthsLeft,
      monthsToDeadline: monthsToDeadline,
      lateMonths: lateMonths,
      extraPerMonth: extraPerMonth
    };
  }

  var API = {
    toDate: toDate,
    formatDate: formatDate,
    addDays: addDays,
    diffDays: diffDays,
    round2: round2,
    fmt1: fmt1,
    fmtMoney: fmtMoney,
    getCycle: getCycle,
    getBudgetState: getBudgetState,
    simulatePurchase: simulatePurchase,
    getAlternative: getAlternative,
    aggregate: aggregate,
    getEngel: getEngel,
    extractMerchant: extractMerchant,
    hitsCooldownKeyword: hitsCooldownKeyword,
    getIncomeStats: getIncomeStats,
    getGoalProjection: getGoalProjection
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.engine = API;
  }
})(typeof globalThis !== 'undefined' ? globalThis : this);

  </script>
<script>
/**
 * coach.js — 理财专家模式（核心附加能力）
 *
 * 定位：除了记账与预算预警之外的「校园理财专家」。
 * 触发场景：
 *   1. 记录【娱乐 / 冲动消费 / 高溢价品牌】账单后，给出「💡 理财专家说」卡片（≤50 字）；
 *   2. 用户问「怎么省钱 / 怎么赚钱」时，输出校园场景具体建议；
 *   3. 用户表达「想买 XX」时，引导走「剁手冷静法」三步问答。
 *
 * 对外 API（window.AJ.coach）：
 *   adviceForBill(bill, alt)   -> ?string  账单触发的一条专家建议（≤50 字，不触发返回 null）
 *   saveMoneyAnswer()          -> string  「怎么省钱」结构化回答（HTML）
 *   makeMoneyAnswer()          -> string  「怎么赚钱」结构化回答（HTML）
 *   isWantBuy(text)            -> ?{item, price}  识别「想买 XX」意图
 *   COOLING_STEPS              -> 剁手冷静法三步问题定义
 *   coolingVerdict(answers)    -> {level, title, text}  三步问答后的结论
 *   ACADEMY                    -> 理财学院课程列表
 *   personalTips(state, ov)    -> [tip]  基于账本数据生成的专属建议
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);
  var DATA = isNode ? require('./data.js') : global.AJ.data;
  var ENG = isNode ? require('./engine.js') : global.AJ.engine;

  var ALTERNATIVES = DATA.ALTERNATIVES;
  var CATEGORY_BUDGET_RATIO = DATA.CATEGORY_BUDGET_RATIO;

  /** 专家建议硬性长度上限（用户规格：不超过 50 字） */
  var ADVICE_MAX_LEN = 50;

  /** 兜底裁剪：无论如何都不超过 50 字 */
  function fit50(text) {
    var s = String(text || '').trim();
    if (s.length <= ADVICE_MAX_LEN) { return s; }
    return s.slice(0, ADVICE_MAX_LEN - 1) + '…';
  }

  function fmtMoney(n) {
    return ENG.fmtMoney(n);
  }

  /** 金额短格式：整数不带小数，否则 1 位小数（用于卡片正文，避免 ¥12.00 太啰嗦） */
  function fmt1(n) {
    return ENG.fmt1(n);
  }

  /** 行内小图标（与 app.js 的 ic 同义；各模块独立闭包，不能跨文件取名） */
  function ic(name, cls, label) {
    return DATA.inlineIcon('i-' + name, cls, label);
  }

  /* ================================================================== */
  /* 一、账单触发规则（记账后主动建议）                                    */
  /* ================================================================== */

  /* 冲动消费（情绪 / 想要）建议轮换，避免每次同一句 */
  var IMPULSE_ADVICE = [
    '先加购物车晾 48 小时，两天后还想买再找我记。',
    '冲动是魔鬼：把商品放进收藏夹，这周过去再看。',
    '给未来的自己发条消息：「三天后还想要吗？」'
  ];

  /* 娱乐类支出建议轮换 */
  var FUN_ADVICE = [
    '校园影院、免费展览也香，娱乐预算省着点造。',
    '快乐不靠烧钱：操场、图书馆、社团活动零成本。',
    '设个娱乐月上限，花超了就用免费项目补位。'
  ];

  var adviceCursor = { impulse: 0, fun: 0 };

  /**
   * 判断一笔支出是否触发专家建议，并返回建议文案。
   * 触发优先级：高溢价品牌（有平替） > 冲动消费 > 娱乐类。
   * @param {Object} bill 归一化后的账单
   * @param {?Object} alt ENG.getAlternative(bill) 的结果（可不传，内部自算）
   * @return {?string} ≤50 字建议；不触发返回 null
   */
  function adviceForBill(bill, alt) {
    if (!bill || bill.type !== 'expense') { return null; }
    if (alt === undefined) { alt = ENG.getAlternative(bill); }

    // 1) 高溢价品牌：有校园平替
    if (alt && alt.save > 0) {
      var line = '试试' + alt.altName + '（' + ENG.fmt1(alt.altPrice) + '元），' +
        (alt.tip || '更划算') + '更香。';
      return fit50(line);
    }

    // 2) 冲动消费：情绪消费 / 想要
    if (bill.motivation === '情绪' || bill.want === true) {
      var pool = IMPULSE_ADVICE;
      var txt = pool[adviceCursor.impulse % pool.length];
      adviceCursor.impulse++;
      return fit50(txt);
    }

    // 3) 娱乐类支出
    if (bill.category === '娱乐') {
      var fpool = FUN_ADVICE;
      var ftxt = fpool[adviceCursor.fun % fpool.length];
      adviceCursor.fun++;
      return fit50(ftxt);
    }

    return null;
  }

  /* ================================================================== */
  /* 二、怎么省钱 / 怎么赚钱（校园场景具体建议）                           */
  /* ================================================================== */

  function saveMoneyAnswer() {
    return '' +
      '<div class="coach-qa-title">' + ic('bulb', 'bico-brand', '省钱攻略') + '理财专家说 · 校园省钱攻略</div>' +
      '<ol class="coach-qa-list">' +
      '<li><b>食堂平替外卖</b>：一荤一素 10 元上下，一周少点 3 次外卖立省 50+</li>' +
      '<li><b>拿铁因子</b>：奶茶咖啡改自泡茶包 / 食堂现磨，一周省 30+</li>' +
      '<li><b>二手真香</b>：教材、电子产品去校园二手群 / 闲鱼，毕业季一折捡漏</li>' +
      '<li><b>白嫖资源</b>：图书馆数据库、MOOC、校园影院和展览，免费也快乐</li>' +
      '<li><b>每周复盘</b>：周日看一次分类占比，超支的类别下周设上限</li>' +
      '</ol>' +
      '<div class="coach-qa-foot">先挑 1 条执行，比一次全改更容易坚持。</div>';
  }

  /* ------------------------------------------------------------------ */
  /* 2.5 团购省钱指导（校外餐饮 / 娱乐：先搜券再下单）                       */
  /*                                                                     */
  /* 用户诉求（逐条对应）：                                                 */
  /*   1) 只要涉及校外餐饮 / 娱乐，无论几个人（哪怕一个人），都优先提醒去     */
  /*      美团 / 抖音搜「单人套餐」或「代金券」；                            */
  /*   2) 提到多人聚餐时，提醒搜「双人餐 / 多人餐」，并算出人均差价；         */
  /*   3) 代金券通常不限人数，结账金额达标就能抵扣；                         */
  /*   4) 说明团购的本质（商家线上引流的特价套餐），并点明「团购比会员日香」   */
  /*      —— 肯德基疯狂星期四只是会员日，团购券周几去都能用。                */
  /*                                                                     */
  /* 设计约束：本段全部是纯函数，不读写 DOM、不依赖 app.js，便于 Node 单测。   */
  /* ------------------------------------------------------------------ */

  /** 校外餐饮品牌（既用于 brand 识别，也并入 FOOD_KW 的关键词扫描） */
  var GB_BRANDS = [
    '肯德基', '麦当劳', '必胜客', '塔斯汀', '华莱士', '德克士', '海底捞',
    '瑞幸', '库迪', '喜茶', 'CoCo', '蜜雪', '茶百道', '古茗', '益禾堂',
    '好想来', '达美乐'
  ];

  /** 校外餐饮关键词 */
  var FOOD_KW = [
    '吃', '火锅', '烧烤', '烤串', '烤肉', '日料', '韩料', '自助', '下馆子', '夜宵',
    '早茶', '串串', '麻辣烫', '小龙虾', '披萨', '汉堡', '炸鸡', '快餐', '奶茶', '咖啡',
    '餐厅', '聚餐'
  ].concat(GB_BRANDS);

  /** 娱乐关键词 */
  var FUN_KW = [
    'KTV', '唱K', '唱歌', '剧本杀', '密室', '桌游', '台球', '网吧', '电竞', '电影',
    '影院', '演出', '演唱会', 'livehouse', '电玩', '蹦床', '脱口秀', '展览'
  ];

  /**
   * 校内场景关键词：需求明确是「**校外**餐饮 / 娱乐」才推团购券，
   * 食堂 / 饭堂 / 宿舍这些属于校内，本来就没有美团团购，命中即一律不推。
   */
  var CAMPUS_KW = ['食堂', '饭堂', '宿舍', '校内', '校园', '学校'];

  /**
   * 过去场景关键词：命中即视为「回述已经发生的事」（昨天吃过了 / 上周聚过餐），
   * 这时推「下次去先搜券」是错的，强制 planning=false、hit=false。
   */
  var PAST_KW = ['昨天', '前天', '上次', '上周', '上个月', '之前', '刚才'];

  /** 多人信号词 */
  var MULTI_KW = [
    '舍友', '室友', '朋友', '同学', '大家', '一起', '聚餐', '团建', '请客',
    '我们', '咱', '约', '几个人', '两人', '三人', '四人', '五人'
  ];

  /** 单人信号词 */
  var SINGLE_KW = [
    '我自己', '一个人', '单人', '单独', '自己吃', '自己去', '自己玩', '就我'
  ];

  /** 「打算去做」信号词（区分「准备去吃」与「已经记账」） */
  var PLANNING_KW = [
    '去', '打算', '准备', '想', '要', '约', '周末', '今晚', '待会', '明天', '后天',
    '晚上', '中午', '想去', '要去', '准备去', '要不要', '一起', '聚餐'
  ];

  /** 明显的「不去了」反悔语气：命中则不算 planning，避免误弹团购卡 */
  var CANCEL_PAT = /(不想去|不打算|不准备|别去|不去了|算了|吃不起|不吃了)/;

  /** 中文数字（「两人 / 三个人」这类写法） */
  var CN_NUM = {
    '两': 2, '二': 2, '三': 3, '四': 4, '五': 5,
    '六': 6, '七': 7, '八': 8, '九': 9, '十': 10
  };

  /**
   * 数字后面紧跟这些量词时，说明是「人数 / 日期 / 份数」而不是金额。
   * 顺序有意义：'个人' 必须排在 '个' 前面，否则「3 个人」会被判成单个「个」。
   */
  var NON_AMOUNT_UNIT = [
    '个人', '人', '位', '个', '月', '日', '号', '点', '岁',
    '次', '份', '杯', '碗', '张', '天', '周', '折'
  ];

  /** 统一的转小写（关键词表里有 CoCo / KTV / livehouse 这类大小写混写） */
  function gbLower(text) {
    return String(text == null ? '' : text).toLowerCase();
  }

  /** text 是否命中 list 中任意一个关键词（大小写不敏感） */
  function gbHasAny(text, list) {
    var s = gbLower(text);
    for (var i = 0; i < list.length; i++) {
      var kw = gbLower(list[i]);
      if (kw && s.indexOf(kw) !== -1) { return true; }
    }
    return false;
  }

  /** 返回 list 中第一个命中的关键词（保持 list 顺序，便于稳定输出品牌名） */
  function gbFirstAny(text, list) {
    var s = gbLower(text);
    for (var i = 0; i < list.length; i++) {
      var kw = gbLower(list[i]);
      if (kw && s.indexOf(kw) !== -1) { return list[i]; }
    }
    return null;
  }

  /** 严格数值转换：非数字 / 空串 / 非有限值一律 NaN（禁止 Number(null) 悄悄变 0） */
  function gbToNum(v) {
    if (typeof v === 'number') { return isFinite(v) ? v : NaN; }
    if (typeof v === 'string' && v.replace(/\s/g, '') !== '') {
      var n = Number(v);
      return isFinite(n) ? n : NaN;
    }
    return NaN;
  }

  /** 数字后面的量词是否表示「非金额」 */
  function gbIsCountUnit(rest) {
    for (var i = 0; i < NON_AMOUNT_UNIT.length; i++) {
      if (rest.indexOf(NON_AMOUNT_UNIT[i]) === 0) { return true; }
    }
    return false;
  }

  /**
   * 从文本里抽金额候选：跳过「3 个人」「10 月 26 日」「2 份」这类非金额数字。
   * 只返回 > 0 的数值，顺序与出现顺序一致。
   * @param {string} raw
   * @return {Array<number>}
   */
  function gbAmounts(raw) {
    var out = [];
    var s = String(raw == null ? '' : raw);
    var re = /(\d+(?:\.\d+)?)/g;
    var m;
    while ((m = re.exec(s)) !== null) {
      var rest = s.slice(re.lastIndex).replace(/^\s+/, '');
      if (gbIsCountUnit(rest)) { continue; }
      var v = Number(m[1]);
      if (isFinite(v) && v > 0) { out.push(v); }
    }
    return out;
  }

  /**
   * 抽取人数：优先「N 人 / N 个人 / N 位」，其次「两人 / 三个人」，
   * 都没有时若命中多人信号词则保守按 2 人算；仍无则 null。
   * @param {string} raw
   * @return {?number}
   */
  function gbPeople(raw) {
    var s = String(raw == null ? '' : raw);
    var m = s.match(/(\d{1,2})\s*(?:个)?\s*(?:人|位)/);
    if (m) {
      var n = Number(m[1]);
      if (n >= 1 && n <= 50) { return n; }
    }
    m = s.match(/([两二三四五六七八九十])\s*(?:个)?\s*(?:人|位)/);
    if (m) {
      var cn = CN_NUM[m[1]];
      if (cn && cn >= 1) { return cn; }
    }
    if (gbHasAny(s, MULTI_KW)) { return 2; }
    return null;
  }

  /**
   * 判定单人 / 多人：单人信号词优先（「我自己一个人去」），其次多人信号词，
   * 再其次按人数推断。
   * @param {string} raw
   * @param {?number} people
   * @return {string} 'single' | 'multi' | 'unknown'
   */
  function gbParty(raw, people) {
    if (gbHasAny(raw, SINGLE_KW)) { return 'single'; }
    if (gbHasAny(raw, MULTI_KW)) { return 'multi'; }
    if (people !== null && people >= 2) { return 'multi'; }
    if (people === 1) { return 'single'; }
    return 'unknown';
  }

  /**
   * 判定「是在计划去做」而不是「在记账」。
   * 关键门控：句子里有金额且句子很短（如「火锅 80」「奶茶 18」）视为纯记账，
   * 一定返回 false —— 记账优先级高于建议，绝不能被团购卡抢走。
   * @param {string} raw
   * @param {Array<number>} amounts gbAmounts(raw) 的结果
   * @return {boolean}
   */
  function gbPlanning(raw, amounts) {
    var s = String(raw == null ? '' : raw);
    if (CANCEL_PAT.test(s)) { return false; }
    /* 过去场景（昨天 / 上周 / 上次…）是回述已发生的事，不算「打算去」 */
    if (gbHasAny(s, PAST_KW)) { return false; }
    if (!gbHasAny(s, PLANNING_KW)) { return false; }
    var compact = s.replace(/\s+/g, '');
    if (amounts.length > 0 && compact.length <= 12) { return false; }
    return true;
  }

  /**
   * 团购场景识别：校外餐饮 / 娱乐 + 「打算去做」才算命中。
   * @param {string} text 用户原始输入
   * @return {{hit:boolean, kind:?string, party:string, people:?number,
   *           planning:boolean, brand:?string, amounts:Array<number>}}
   *   hit      是否命中团购场景（kind 非空 且 planning 为真；校内 / 过去场景强制 false）
   *   kind     'food'（校外餐饮，含品牌）| 'fun'（娱乐）| null
   *   party    'single' | 'multi' | 'unknown'
   *   people   人数（推断值），无法判断为 null
   *   planning 是否表示「要去 / 打算去」
   *   brand    命中的餐饮品牌名，未命中为 null
   *   amounts  句子里的金额候选（已剔除人数 / 日期 / 份数）
   */
  function detectGroupBuy(text) {
    var raw = String(text == null ? '' : text).trim();
    var result = {
      hit: false,
      kind: null,
      party: 'unknown',
      people: null,
      planning: false,
      brand: null,
      amounts: []
    };
    if (!raw) { return result; }

    result.amounts = gbAmounts(raw);
    result.kind = gbHasAny(raw, FOOD_KW) ? 'food' : (gbHasAny(raw, FUN_KW) ? 'fun' : null);
    result.brand = gbFirstAny(raw, GB_BRANDS);
    result.people = gbPeople(raw);
    result.party = gbParty(raw, result.people);
    result.planning = gbPlanning(raw, result.amounts);
    /* 命中校内场景（食堂 / 饭堂 / 宿舍 / 学校…）或过去场景（昨天 / 上周 / 上次…）
     * 一律不算团购场景：「我要吃食堂」「昨天去吃火锅」不推，「我要吃海底捞」
     * 「明天去吃火锅」照推。 */
    result.hit = (result.kind !== null) && (result.planning === true) &&
      !gbHasAny(raw, CAMPUS_KW) && !gbHasAny(raw, PAST_KW);
    return result;
  }

  /**
   * 团购后人均差价：(原价合计 - 团购价) / 人数，保留 1 位小数。
   * @param {number} originalTotal 原价合计
   * @param {number} groupTotal    团购价合计
   * @param {number} people        人数
   * @return {?number} 人均省下的钱；入参非法或人数 < 1 返回 null
   */
  function perPersonSaving(originalTotal, groupTotal, people) {
    var orig = gbToNum(originalTotal);
    var group = gbToNum(groupTotal);
    var n = gbToNum(people);
    if (isNaN(orig) || isNaN(group) || isNaN(n)) { return null; }
    if (n < 1) { return null; }
    var saving = (orig - group) / n;
    if (!isFinite(saving)) { return null; }
    return Math.round(saving * 10) / 10;
  }

  /** 极简 HTML 转义（品牌名虽然来自内部白名单，仍统一转义，避免将来改成用户输入时漏防） */
  function gbEsc(text) {
    return String(text == null ? '' : text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /**
   * 生成「团购先搜券」卡片 HTML（与 saveMoneyAnswer 同一套 coach-qa-* 样式）。
   * @param {Object} ctx detectGroupBuy(text) 的返回对象
   * @return {string} HTML
   */
  function groupBuyAdvice(ctx) {
    var c = ctx || {};
    var isFun = (c.kind === 'fun');
    var party = (c.party === 'single' || c.party === 'multi') ? c.party : 'unknown';
    var people = (typeof c.people === 'number' && c.people >= 1) ? Math.floor(c.people) : null;
    var amounts = (c.amounts && c.amounts.length) ? c.amounts.slice() : [];
    var brand = (typeof c.brand === 'string' && c.brand) ? c.brand : null;

    var scene = isFun ? 'KTV / 剧本杀 / 电影' : '校外吃饭';
    var singleWord = isFun ? '单人畅玩' : '单人套餐';
    var multiWord = isFun ? '双人套餐 / 多人套餐' : '双人餐 / 多人餐';

    var html = '' +
      '<div class="coach-qa-title">' + ic('ticket', 'bico-brand', '团购') +
      '省钱助手 · 团购先搜券' +
      (brand && !isFun ? '（' + gbEsc(brand) + '）' : '') + '</div>' +
      '<ol class="coach-qa-list">';

    /* 规则 1（永远出现）：几个人去都要先搜券 */
    html += '<li><b>几个人去都先搜券</b>：' + scene + '下单前先在<b>美团 / 抖音</b>搜「<b>' +
      singleWord + '</b>」或「<b>代金券</b>」再下单，别到店按原价点。' +
      (party === 'single' ? '一个人去也有单人券，团购不是两个人的专利。' : '') + '</li>';

    /* 规则 2（仅多人）：双人餐 / 多人餐 + 人均差价 */
    if (party === 'multi') {
      var saveLine = '';
      if (amounts.length >= 2) {
        var sorted = amounts.slice().sort(function (a, b) { return b - a; });
        var origTotal = sorted[0];
        var groupTotal = sorted[1];
        var ppl = (people !== null) ? people : 2;
        var saving = perPersonSaving(origTotal, groupTotal, ppl);
        if (saving !== null && saving > 0) {
          saveLine = '按你提到的数算：原价合计 ' + fmt1(origTotal) + ' 元、团购价 ' +
            fmt1(groupTotal) + ' 元，' + ppl + ' 人一起去，<b>团购后人均能省 ' +
            fmt1(saving) + ' 元</b>。';
        }
      }
      if (!saveLine) {
        saveLine = isFun
          ? 'KTV / 剧本杀原价人均约 60-80，团购人均约 40-55，一般人均能省 15-25 元。'
          : '火锅 / 烤肉类原价人均约 80，团购人均约 55，一般人均能省 20-30 元。';
      }
      html += '<li><b>多人搜「' + multiWord + '」</b>：' +
        ((people !== null && people >= 3) ? '你们 ' + people + ' 人，' : '你们几位，') +
        '在美团 / 抖音搜「<b>' + multiWord + '</b>」，' + saveLine + '</li>';
    }

    /* 规则 3（永远出现）：代金券不限人数 */
    html += '<li><b>代金券通常不限人数</b>：只要结账金额达标，不管几个人去都能直接抵扣，' +
      '人多人少都不亏，付款前记得先验券。</li>';

    /* 背景说明：团购的本质 + 团购比会员日香 */
    html += '</ol><div class="coach-qa-foot">' +
      '团购不是低配：美团 / 抖音 / 大众点评的「团购」，本质是商家为了线上引流打的特价套餐。' +
      '<b>团购比会员日香</b>——肯德基疯狂星期四只是会员日，但肯德基在美团 / 抖音常年有' +
      '「19.9 元双人餐」甚至「9.9 元汉堡 + 可乐」的团购券，买了券周几去吃都行，完全不用死等周四。' +
      '</div>';

    return html;
  }

  /**
   * 团购规则文案单一数据源。
   * 聊天气泡（groupBuyAnswer）与理财专家面板（groupBuyPanelHtml）共用同一份文案，
   * 避免同一套规则在两处出现措辞漂移：
   *   chat  聊天气泡里的小标题（口语化、带情绪）
   *   panel 专家面板里的小标题（精简、标签化）
   *   body  两条路径共用的正文
   */
  var GB_RULES = {
    solo: {
      chat: '单人也有券',
      panel: '先搜券',
      body: '哪怕自己去，也先上美团 / 抖音搜「单人套餐」或「代金券」再下单'
    },
    multi: {
      chat: '多人搜套餐',
      panel: '多人搜「双人餐 / 多人餐」',
      body: '舍友聚餐搜「双人餐 / 多人餐」，火锅烧烤团购后人均一般能省 20-30 元'
    },
    voucher: {
      chat: '代金券不限人数',
      panel: '代金券不限人数',
      body: '只要结账金额达标就能抵扣，跟几个人去没关系'
    },
    member: {
      chat: '团购比会员日香',
      panel: '团购比会员日香',
      body: '肯德基疯狂星期四只是会员日，美团 / 抖音常年有 19.9 元双人餐、' +
        '9.9 元汉堡 + 可乐，买了券周几去吃都行'
    }
  };

  /** 团购「本质」说明：聊天用长句（含平台名），面板用短句（省空间） */
  var GB_ESSENCE = {
    chat: '团购＝美团 / 抖音 / 大众点评上商家为线上引流打的特价套餐，' +
      '先搜券再点单，一年能省出好几顿饭。',
    panel: '团购本质是商家线上引流的特价套餐，比会员日灵活：券随时买，周几去都能用。'
  };

  /** 面板里按顺序展示的三条规则（第 4 条「团购比会员日香」已并入 GB_ESSENCE.panel） */
  var GB_PANEL_ORDER = ['solo', 'multi', 'voucher'];

  /**
   * 「怎么省钱」指南里的团购精简版块（静态文案，无场景参数）。
   * @return {string} HTML
   */
  function groupBuyAnswer() {
    var html = '' +
      '<div class="coach-qa-title">' + ic('ticket', 'bico-brand', '团购') +
      '省钱助手 · 校外吃玩先搜团购</div>' +
      '<ol class="coach-qa-list">';
    var keys = GB_PANEL_ORDER.concat(['member']);
    for (var i = 0; i < keys.length; i++) {
      var r = GB_RULES[keys[i]];
      html += '<li><b>' + r.chat + '</b>：' + r.body + '</li>';
    }
    html += '</ol>' +
      '<div class="coach-qa-foot">' + GB_ESSENCE.chat + '</div>';
    return html;
  }

  /**
   * 理财专家面板「团购省钱」卡片正文（不含 card / card-head，只填 #groupBuyBody）。
   * 三条规则的精简版 + 一句团购本质 + 「在聊天里问我怎么省」按钮；
   * 按钮点击由 app.js 用事件委托绑定，节点重建后依然有效。
   * @return {string} HTML
   */
  function groupBuyPanelHtml() {
    var html = '' +
      '<p class="gb-lead">' + ic('ticket', 'bico-brand', '团购') +
      '校外吃玩（火锅 / 烧烤 / KTV / 剧本杀）先在美团、抖音搜团购券再下单。</p>' +
      '<ul class="gb-rules">';
    for (var i = 0; i < GB_PANEL_ORDER.length; i++) {
      var r = GB_RULES[GB_PANEL_ORDER[i]];
      html += '<li><b>' + r.panel + '</b><span>' + r.body + '</span></li>';
    }
    html += '</ul>' +
      '<p class="gb-note">' + GB_ESSENCE.panel + '</p>' +
      '<div class="gb-actions">' +
      '<button class="btn-mini" id="btnGroupBuyAsk" type="button">在聊天里问我怎么省</button>' +
      '</div>';
    return html;
  }

  function makeMoneyAnswer() {
    return '' +
      '<div class="coach-qa-title">' + ic('wallet', 'bico-brand', '搞钱路子') + '理财专家说 · 校园搞钱路子</div>' +
      '<ol class="coach-qa-list">' +
      '<li><b>勤工俭学</b>：图书馆助理 / 实验室值班 / 助教，时薪 15-25，稳定靠谱</li>' +
      '<li><b>技能变现</b>：PPT 代做、约拍、家教，校园群 / 闲鱼接单，一单 50-300</li>' +
      '<li><b>闲置回血</b>：教材、电子产品、用不上的会员挂闲鱼，毕业季集中清</li>' +
      '<li><b>奖学金</b>：国奖 8000、校奖 1000-3000，性价比最高的「赚钱」</li>' +
      '<li><b>竞赛奖金</b>：创新创业 / 程序设计大赛，拿钱同时给简历加分</li>' +
      '</ol>' +
      '<div class="coach-qa-foot warn">' + ic('alert', 'bico-warn', '防骗提醒') + '先交钱的兼职都是骗子，天上不会掉馅饼。</div>';
  }

  /* ================================================================== */
  /* 三、剁手冷静法（想买 XX 时引导）                                      */
  /* ================================================================== */

  /**
   * 识别「想买 XX」意图。
   * 注意：只匹配「想 / 打算 / 准备 买」这类购买意图，不匹配「买了」（已消费，应正常记账）。
   * @return {?{item:string, price:number}}
   */
  function isWantBuy(text) {
    var raw = String(text || '').trim();
    if (!raw) { return null; }
    // 负向意图（不想买了 / 别买 / 没想买）不触发
    if (/(不|别|没|甭|何必)(好想|想要|很想|想|买)/.test(raw)) { return null; }
    // 已完成的购买描述（含金额 + 买了/花了/充值等）-> 交给正常记账，不拦截
    if (/\d/.test(raw) && /(买了|花了|付了|充值|已购|剁手了|下单了|入手了)/.test(raw)) { return null; }

    // 强意图：句首的「我想买 / 好想买 / 打算买 / 准备买…」（避免把「心情不好想买的」这类
    // 已消费描述误判为购买意图）；弱意图：句中「心痒 / 长草 / 看中」。
    var strong = /^(?:我|俺|咱)?\s*(?:好想|很想要?|超想|想|想要|打算|准备|计划)\s*(?:买|购入|入手|下单)/;
    var weak = /(心痒|长草|看中了?)/;
    if (!strong.test(raw) && !weak.test(raw)) { return null; }

    // 金额：优先带货币单位 / 「左右」的数字，其次末尾裸数字
    var price = 0;
    var pm = raw.match(/(\d+(?:\.\d+)?)\s*(?:元|块|圆|rmb|¥|左右|上下|前后)/i) ||
      raw.match(/(\d+(?:\.\d+)?)\s*$/);
    if (pm) { price = Number(pm[1]) || 0; }

    // 商品名：剥离意图动词、量词、金额与口语词
    var item = raw
      .replace(/^(我|俺|咱)?\s*(好想|想要|很想|想|打算|准备|计划)/, '')
      .replace(/(看中了|心痒了?|长草了?)/, '')
      .replace(/^(看到|看见|瞧见|发现|觉得|感觉)/, '')
      .replace(/(买|购入|入手|下单)/g, ' ')
      .replace(/\d+(?:\.\d+)?\s*(?:元|块|圆|rmb|¥)/gi, ' ')
      .replace(/\d+(?:\.\d+)?\s*(左右|上下|前后)/g, ' ')
      .replace(/\s*\d+(?:\.\d+)?\s*$/, ' ')
      .replace(/(大概|大约|左右|差不多)/g, ' ')
      .replace(/^\s*(那个|这个|一个|一件|一台|一部|一双|一款|个|台|部|双|件|款)/, ' ')
      .replace(/[，。！？!?,~～、\s]+/g, ' ')
      .trim();

    if (!item) { return null; }
    if (item.length > 16) { item = item.slice(0, 16); }
    return { item: item, price: price };
  }

  /** 剁手冷静法三步问题定义 */
  var COOLING_STEPS = [
    {
      key: 'reason',
      q: '第 1 问 · 买它的核心原因是？',
      options: [
        { val: 'need', label: '真的需要' },
        { val: 'want', label: '就是想要' },
        { val: 'mood', label: '犒劳自己' },
        { val: 'follow', label: '别人有我也要' }
      ]
    },
    {
      key: 'freq',
      q: '第 2 问 · 买来后使用频率？',
      options: [
        { val: 'often', label: '每周都用' },
        { val: 'sometimes', label: '偶尔用用' },
        { val: 'dust', label: '说不定吃灰' }
      ]
    },
    {
      key: 'pressure',
      q: '第 3 问 · 这笔钱对你来说？',
      options: [
        { val: 'easy', label: '轻松拿下' },
        { val: 'think', label: '要掂量一下' },
        { val: 'hard', label: '咬牙 / 分期' }
      ]
    }
  ];

  /** 三步问答结论 */
  function coolingVerdict(answers) {
    var score = 0;
    var map = {
      need: 2, want: 1, mood: 0, follow: 0,
      often: 2, sometimes: 1, dust: 0,
      easy: 2, think: 1, hard: 0
    };
    for (var i = 0; i < answers.length; i++) {
      score += (map[answers[i]] || 0);
    }
    if (score >= 5) {
      return {
        level: 'ok',
        icon: 'check',
        title: '可以买',
        text: '刚需、高频、无压力，下单前记得比价，学生优惠 / 教育资格能用就用。'
      };
    }
    if (score >= 3) {
      return {
        level: 'warn',
        icon: 'alert',
        title: '建议晾 48 小时',
        text: '先加进购物车，两天后还想要，再来找我，我帮你记上这笔。'
      };
    }
    return {
      level: 'stop',
      icon: 'stop',
      title: '建议先不买',
      text: '多半是情绪 / 从众冲动。先去做别的事转移注意力，真需要了再说。'
    };
  }

