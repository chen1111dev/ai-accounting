  var SPRITE_SVG = '' +
    '<svg viewBox="0 0 120 124" aria-hidden="true">' +
    /* ---- 星星睡帽（先画，盖在头顶） ---- */
    '  <ellipse cx="58" cy="34" rx="46" ry="20" fill="#A5DBF4"/>' +
