      <symbol id="i-robot" viewBox="0 0 24 24"><rect x="6" y="9" width="12" height="9" rx="2"/><path d="M12 3v3M9 3h6"/><circle cx="9.5" cy="13" r="1" fill="currentColor" stroke="none"/><circle cx="14.5" cy="13" r="1" fill="currentColor" stroke="none"/><path d="M9 18v2M15 18v2"/></symbol>
