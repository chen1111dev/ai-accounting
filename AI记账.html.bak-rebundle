    DOC.addEventListener('keydown', h);
  }

  if (DOC.readyState === 'loading') {
    DOC.addEventListener('DOMContentLoaded', bindUnlockOnce);
  } else {
    bindUnlockOnce();
  }

  global.AJ = global.AJ || {};
  global.AJ.sfx = {
    play: play,
    buzz: buzz,
    both: both,
    combo: combo,
    milestone: milestone,
    tierOf: tierOf,
    isEnabled: isEnabled,
    setEnabled: setEnabled
