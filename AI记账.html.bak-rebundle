    { id: 'promo.manjian.106', cat: 'promo', title: '满减凑单反套路：刚需凑，凑完退',
      action: '满 300 减 50 是让你多花钱的陷阱：差一点凑单就买纸巾、洗衣液等刚需必需品，坚决不买「可能有用」的垃圾；凑单件不想留就等发货后再退——发货后退只退凑单件，满减依然生效（外卖满减凑单详见简餐外卖类）。',
      who: '大促忍不住凑单的人', gate: '需平台支持发货后退货',
      scene: 'seasonal', risk: '发货前退货会整单退、满减作废，务必等发货后再退；频繁退货可能被平台限权；凑单件选 7 天无理由可退的，生鲜定制类别凑',
      trigger: null,
      save: { type: 'range', min: 10, max: 50 }, priceRef: {},
      billCats: ['购物'], keywords: ['满减', '凑单', '反凑单', '退货', '套路'],
      certainty: 'varies', source: '电商满减与退货规则' }
  ];

  /* ================================================================== */
  /* 校验                                                                */
  /* ================================================================== */

  var CERTAINTY = ['stable', 'varies', 'local'];
  var SAVE_TYPES = ['fixed', 'ratio', 'range', 'none'];
  var CAT_KEYS = CATS.map(function (c) { return c.key; });

  function isStr(v) { return typeof v === 'string' && v.trim() !== ''; }
  function isNum(v) { return typeof v === 'number' && isFinite(v); }

  /**
   * 数据自检。返回 {ok, errors:[{id, field, msg}], count}
   * 任何一条不合规都会被列出来——渲染层据此跳过该条，绝不渲染半截卡片。
   */
  function validate(list) {
    var arr = Array.isArray(list) ? list : ENTRIES;
    var errors = [];
    var seen = {};

    function err(id, field, msg) { errors.push({ id: id || '(no id)', field: field, msg: msg }); }

    for (var i = 0; i < arr.length; i++) {
      var e = arr[i] || {};
      var id = e.id;

      if (!isStr(id)) { err(id, 'id', '缺少 id'); }
      else if (seen[id]) { err(id, 'id', 'id 重复'); }
      else { seen[id] = true; }

      if (CAT_KEYS.indexOf(e.cat) === -1) { err(id, 'cat', '分类不在 10 类之内：' + e.cat); }

      ['title', 'action', 'who', 'gate', 'scene', 'risk', 'source'].forEach(function (f) {
        if (!isStr(e[f])) { err(id, f, '必填字段为空'); }
      });

      if (CERTAINTY.indexOf(e.certainty) === -1) { err(id, 'certainty', '取值非法：' + e.certainty); }

      /* billCats */
      if (!Array.isArray(e.billCats) || e.billCats.length === 0) {
        err(id, 'billCats', '至少关联一个账本分类');
      } else {
        e.billCats.forEach(function (c) {
          if (BILL_CATS.indexOf(c) === -1) { err(id, 'billCats', '未知账本分类：' + c); }
        });
      }

      /* keywords */
      if (!Array.isArray(e.keywords) || e.keywords.length === 0) {
        err(id, 'keywords', '至少一个关键词');
      } else {
        e.keywords.forEach(function (k) {
          if (!isStr(k)) { err(id, 'keywords', '关键词必须是非空字符串'); }
        });
      }

      /* save */
      var s = e.save || {};
      if (s.once !== undefined && typeof s.once !== 'boolean') {
        err(id, 'save.once', 'once 必须是布尔值');
      }
      if (s.onceLabel !== undefined && !isStr(s.onceLabel)) {
        err(id, 'save.onceLabel', 'onceLabel 必须是非空字符串');
      }
      if (SAVE_TYPES.indexOf(s.type) === -1) {
        err(id, 'save', '未知 save.type：' + s.type);
      } else if (s.type === 'fixed') {
        if (!isNum(s.amount) || s.amount < 0) { err(id, 'save.amount', 'fixed 需要非负数字'); }
      } else if (s.type === 'ratio') {
        if (!isNum(s.rate) || s.rate <= 0 || s.rate >= 1) { err(id, 'save.rate', 'rate 必须在 (0,1) 之间'); }
        if (s.cap !== undefined && (!isNum(s.cap) || s.cap <= 0)) { err(id, 'save.cap', 'cap 必须为正数'); }
        if (e.priceRef && isNum(e.priceRef.before) && e.priceRef.before <= 0) {
          err(id, 'priceRef.before', '原价必须为正数');
        }
      } else if (s.type === 'range') {
        if (!isNum(s.min) || !isNum(s.max)) { err(id, 'save', 'range 需要 min / max 数字'); }
        else if (s.max < s.min) { err(id, 'save', 'max 不能小于 min'); }
      }

      /* trigger */
      var t = e.trigger;
      if (t !== null && t !== undefined) {
        if (typeof t !== 'object') { err(id, 'trigger', 'trigger 必须是对象或 null'); }
        else {
          if (t.weekday !== undefined) {
            if (!Array.isArray(t.weekday) || !t.weekday.length) { err(id, 'trigger.weekday', '必须是非空数组'); }
            else { t.weekday.forEach(function (w) { if (!(w >= 1 && w <= 7)) { err(id, 'trigger.weekday', '取值须 1-7：' + w); } }); }
          }
          if (t.monthday !== undefined) {
            if (!Array.isArray(t.monthday) || !t.monthday.length) { err(id, 'trigger.monthday', '必须是非空数组'); }
            else { t.monthday.forEach(function (d) { if (!(d >= 1 && d <= 28)) { err(id, 'trigger.monthday', '取值须 1-28（规避 2 月缺日）：' + d); } }); }
          }
          if (t.timeRange !== undefined) {
            var tr = t.timeRange;
            if (!Array.isArray(tr) || tr.length !== 2 || !/^\d{2}:\d{2}$/.test(tr[0]) || !/^\d{2}:\d{2}$/.test(tr[1])) {
              err(id, 'trigger.timeRange', '必须是 ["HH:MM","HH:MM"]');
            }
          }
          if (t.mmdd !== undefined) {
            if (!Array.isArray(t.mmdd) || !t.mmdd.length) { err(id, 'trigger.mmdd', '必须是非空数组'); }
            else { t.mmdd.forEach(function (m) { if (!/^\d{2}-\d{2}$/.test(m)) { err(id, 'trigger.mmdd', '格式须 MM-DD：' + m); } }); }
          }
          if (t.window !== undefined) {
            if (!Array.isArray(t.window) || !t.window.length) { err(id, 'trigger.window', '必须是非空数组'); }
            else {
              t.window.forEach(function (w) {
                if (!w || !/^\d{2}-\d{2}$/.test(w.from) || !/^\d{2}-\d{2}$/.test(w.to)) {
                  err(id, 'trigger.window', '区间必须是 {from:"MM-DD", to:"MM-DD"}');
                }
              });
            }
          }
        }
      }
    }

    return { ok: errors.length === 0, errors: errors, count: arr.length };
  }

  /* ================================================================== */
  /* 导出                                                                */
  /* ================================================================== */

  var API = {
    VERSION: '1.0.0',
    DATA_VERSION: DATA_VERSION,
    CATS: CATS,
    CAT_KEYS: CAT_KEYS,
    BILL_CATS: BILL_CATS,
    CERTAINTY: CERTAINTY,
    SAVE_TYPES: SAVE_TYPES,
    ENTRIES: ENTRIES,
    validate: validate,
    catByKey: function (key) {
      for (var i = 0; i < CATS.length; i++) { if (CATS[i].key === key) { return CATS[i]; } }
      return null;
    },
    byId: function (id) {
      for (var i = 0; i < ENTRIES.length; i++) { if (ENTRIES[i].id === id) { return ENTRIES[i]; } }
      return null;
    },
    byCat: function (cat) {
      return ENTRIES.filter(function (e) { return e.cat === cat; });
    }
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.savingsData = API;
  }
})(typeof window !== 'undefined' ? window : this);

  </script>
<script>
/**
 * savings.js — 省钱图谱 · 引擎（纯函数 + UMD）
 *
 * 定位：把 100 条「怎么操作才省」的动作，算成「今天哪几条能用、值多少、先看哪条」。
 * 与省钱雷达的分工：
 *   deals.js    → 哪天有活动、谁更便宜（时间 + 价格口径）
 *   savings.js  → 具体怎么操作才省（动作 + 门槛 + 弊端 + 打卡）
 *
 * 对外 API（window.AJ.savings）：
 *   READY / ENTRIES                   数据是否就绪、条目列表
 *   estimateSave(entry)               可省金额估算 → number | null
 *   saveText(entry)                   「≈ 省 ¥6.10」/「省多少看用量」
 *   matchTrigger(entry, now)          今天是否命中（OR 语义，多维度任一满足）
 *   rankToday(entries, ctx)           今日清单（稳定排序，已打卡的排除）
 *   search(entries, q)                搜索（标题 / 动作 / 关键词 / 门槛）
 *   entriesForBill(cat, entries)      某账本分类关联的条目（账本联动用）
 *   summary(logs, opts)               省钱账汇总（累计 / 本周期）
 *   isChecked(logs, id, day)          某天是否已打卡
 *   toggleCheck(logs, id, day, saved) 打卡 / 取消（幂等，返回新数组）
 *   entryCardHtml / todayCardHtml     卡片 HTML
 *
 * 约定：所有日期用**本地时间**，dateKey 与 deals.dateKey 同语义（YYYY-MM-DD）。
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);
  var DATA = isNode ? require('./savings_data.js') : (global.AJ && global.AJ.savingsData);

  var READY = !!(DATA && Array.isArray(DATA.ENTRIES) && DATA.ENTRIES.length);

  var ENTRIES = READY ? DATA.ENTRIES : [];
  var CATS = READY ? DATA.CATS : [];
  var CERT_LABEL = { stable: '', varies: '力度常变', local: '以你学校为准' };

  /** 场景码 → 人话（详情页「什么时候用」那一行） */
  var SCENE_LABEL = {
    always: '随时', weekday: '工作日', 'weekday-lunch': '工作日午餐', 'weekday-dinner': '工作日晚餐',
    weekend: '周末', 'weekend-meal': '周末正餐', lunch: '午餐', dinner: '晚餐',
    'late-dinner': '晚 8 点后', meal: '正餐', morning: '早餐', night: '夜间',
    holiday: '节假日', seasonal: '换季 / 开学', monthly: '每月固定', weekly: '每周固定',
    order: '下单那一刻', emergency: '应急'
  };

  /* ================================================================== */
  /* 一、日期与格式化工具（与 deals.js 同语义）                            */
  /* ================================================================== */

  var WEEK_CN = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];

  function pad2(n) { return (n < 10 ? '0' : '') + n; }

  function toDate(d) {
    if (d instanceof Date) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
    if (typeof d === 'string') {
      var m = d.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
      if (m) { return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])); }
    }
    var t = new Date();
    return new Date(t.getFullYear(), t.getMonth(), t.getDate());
  }

  function dateKey(d) {
    var x = toDate(d);
    return x.getFullYear() + '-' + pad2(x.getMonth() + 1) + '-' + pad2(x.getDate());
  }

  /** 'MM-DD'，用于 mmdd / window 比较（跨年无意义，只比月日） */
  function mmddKey(d) {
    var x = toDate(d);
    return pad2(x.getMonth() + 1) + '-' + pad2(x.getDate());
  }

  /** JS getDay 0=周日；本模块统一 1=周一 … 7=周日 */
  function isoWeekday(d) {
    var w = toDate(d).getDay();
    return w === 0 ? 7 : w;
  }

  function weekdayCn(d) { return WEEK_CN[toDate(d).getDay()]; }

  /** 当前时刻 'HH:MM' */
  function hhmm(d) {
    var x = (d instanceof Date) ? d : new Date();
    return pad2(x.getHours()) + ':' + pad2(x.getMinutes());
  }

  function toMin(hhmmStr) {
    var p = String(hhmmStr || '').split(':');
    var h = parseInt(p[0], 10), m = parseInt(p[1], 10);
    if (!isFinite(h) || !isFinite(m)) { return NaN; }
    return h * 60 + m;
  }

  function round2(n) { return Math.round(n * 100) / 100; }

  function fmt(n) {
    if (n === null || n === undefined || !isFinite(n)) { return '—'; }
    return (Math.round(n * 100) / 100).toFixed(2);
  }

  function esc(s) {
    return String(s === null || s === undefined ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  /* ================================================================== */
  /* 二、可省金额估算                                                     */
  /* ================================================================== */

  /**
   * estimateSave(entry) → number | null
   *   fixed  → amount
   *   ratio  → min(before × rate, cap)；缺 priceRef.before 返回 null（不是 0！）
   *   range  → (min + max) / 2
   *   none   → null（省多少看用量，不参与金额累计）
   */
  function estimateSave(entry) {
    if (!entry || !entry.save) { return null; }
    var s = entry.save;

    if (s.type === 'fixed') {
      return (typeof s.amount === 'number' && isFinite(s.amount) && s.amount >= 0) ? round2(s.amount) : null;
    }
    if (s.type === 'ratio') {
      var before = entry.priceRef && entry.priceRef.before;
      if (typeof before !== 'number' || !isFinite(before) || before <= 0) { return null; }
      var v = before * s.rate;
      if (typeof s.cap === 'number' && isFinite(s.cap) && s.cap > 0) { v = Math.min(v, s.cap); }
      return round2(v);
    }
    if (s.type === 'range') {
      if (typeof s.min !== 'number' || typeof s.max !== 'number') { return null; }
      return round2((s.min + s.max) / 2);
    }
    return null;
  }

  /** 金额展示文案：< 0.5 元不显示 ¥0.00，避免看起来「这条没用」 */
  function saveText(entry) {
    /* 总额型（once：大促总额 / 年卡 / 课程总价）：这个数不是「今天能省多少」，必须说清楚 */
    if (entry && entry.save && entry.save.once) {
      var label = entry.save.onceLabel || '一次性省';
      if (entry.save.type === 'range') {
        return label + ' ¥' + fmt(entry.save.min) + '-' + fmt(entry.save.max);
      }
      var ov = estimateSave(entry);
      return ov === null ? label : label + ' ¥' + fmt(ov);
    }
    var v = estimateSave(entry);
    if (v === null) { return '省多少看用量'; }
    if (v <= 0) { return '省心操作'; }
    if (v < 0.5) { return '≈ 几毛钱'; }
    return '≈ 省 ¥' + fmt(v);
  }

  /** 金额区间文案（详情页用） */
  /**
   * ratioText(save) → '省 12%（约 8.8 折），单次最多省 ¥20.00'
   * rate 存的是「省掉的比例」，直接写「12% 折扣」会被读成「打 12% 折」（差 8 倍），
   * 所以两个说法都给：省多少 + 相当于几折。
   */
  function ratioText(s) {
    var pct = Math.round(s.rate * 100);
    var t = '省 ' + pct + '%（约 ' + (Math.round((1 - s.rate) * 1000) / 100) + ' 折）';
    if (typeof s.cap === 'number') { t += '，单次最多省 ¥' + fmt(s.cap); }
    return t;
  }

  function saveRangeText(entry) {
    var s = entry && entry.save;
    if (!s) { return '—'; }
    if (s.type === 'range') { return '¥' + fmt(s.min) + ' - ¥' + fmt(s.max) + '（每次估算）'; }
    if (s.type === 'ratio') { return ratioText(s); }
    if (s.type === 'fixed') { return '¥' + fmt(s.amount) + '（固定省额）'; }
    return '无法量化（长期习惯型）';
  }

  /* ================================================================== */
  /* 三、今日命中判定                                                     */
  /* ================================================================== */

  /**
   * triggerText(entry) → '每周一 / 每月 8 / 18 / 28 号' / '随时可用'
   * 纯展示用，与 matchTrigger 一一对应，改了那边记得同步这里。
   */
  function triggerText(entry) {
    var t = entry && entry.trigger;
    if (!t) { return '随时可用'; }
    var parts = [], i;

    if (Array.isArray(t.weekday) && t.weekday.length) {
      parts.push('每' + t.weekday.map(function (w) { return WEEK_CN[w % 7]; }).join(' / '));
    }
    if (Array.isArray(t.monthday) && t.monthday.length) {
      parts.push('每月 ' + t.monthday.join(' / ') + ' 号');
    }
    if (Array.isArray(t.mmdd) && t.mmdd.length) {
      parts.push('每年 ' + t.mmdd.join('、'));
    }
    if (Array.isArray(t.timeRange) && t.timeRange.length === 2) {
      parts.push('每天 ' + t.timeRange[0] + '-' + t.timeRange[1]);
    }
    if (Array.isArray(t.window)) {
      var ws = [];
      for (i = 0; i < t.window.length; i++) {
        var w = t.window[i] || {};
        if (w.from && w.to) { ws.push(w.from + ' ~ ' + w.to); }
      }
      if (ws.length) { parts.push('每年 ' + ws.join('、') + ' 期间'); }
    }
    return parts.length ? parts.join(' 或 ') : '随时可用';
  }

  function sceneText(entry) {
    var s = entry && entry.scene;
    if (!s) { return '不限场景'; }
    return SCENE_LABEL[s] || '不限场景';
  }

  /**
   * matchTrigger(entry, now) → boolean
   * trigger 为 null 视为「常驻可用」，恒 true。
   * 多维度时 **任一维度满足即命中**（OR）。
   */
  function matchTrigger(entry, now) {
    var t = entry && entry.trigger;
    if (!t) { return true; }
    var d = (now instanceof Date) ? now : new Date();

    if (Array.isArray(t.weekday) && t.weekday.indexOf(isoWeekday(d)) !== -1) { return true; }
    if (Array.isArray(t.monthday) && t.monthday.indexOf(d.getDate()) !== -1) { return true; }
    if (Array.isArray(t.mmdd) && t.mmdd.indexOf(mmddKey(d)) !== -1) { return true; }

    if (Array.isArray(t.timeRange) && t.timeRange.length === 2) {
      var start = toMin(t.timeRange[0]), end = toMin(t.timeRange[1]), cur = toMin(hhmm(d));
      if (isFinite(start) && isFinite(end) && isFinite(cur)) {
        if (start <= end) { if (cur >= start && cur <= end) { return true; } }
        else { if (cur >= start || cur <= end) { return true; } }  // 跨零点
      }
    }

    if (Array.isArray(t.window)) {
      var today = mmddKey(d);
      for (var i = 0; i < t.window.length; i++) {
        var w = t.window[i] || {};
        if (!/^\d{2}-\d{2}$/.test(w.from || '') || !/^\d{2}-\d{2}$/.test(w.to || '')) { continue; }
        if (w.from <= w.to) { if (today >= w.from && today <= w.to) { return true; } }
        else { if (today >= w.from || today <= w.to) { return true; } }  // 跨年
      }
    }

    return false;
  }

  /* ================================================================== */
  /* 四、今日清单（稳定排序）                                              */
  /* ================================================================== */

  function scoreOne(entry, ctx) {
    var now = ctx.now || new Date();
    var hit = entry.trigger ? matchTrigger(entry, now) : false;
    var est = estimateSave(entry);
    var s = 0;

    if (hit) { s += 40; }
    if (ctx.topCat && entry.billCats && entry.billCats.indexOf(ctx.topCat) !== -1) { s += 25; }
    if (ctx.catSpend) {
      for (var i = 0; i < entry.billCats.length; i++) {
        if ((ctx.catSpend[entry.billCats[i]] || 0) > 0) { s += 20; break; }
      }
    }
    if (ctx.budgetStatus === 'danger' || ctx.budgetStatus === 'tight') { s += 15; }
    if (entry.certainty === 'stable') { s += 10; }
    /* 大促（once）那个数是整场活动的总额，不能拿来当「今天省多少」参与加榜 */
    if (est !== null && est > 0 && !(entry.save && entry.save.once)) { s += 5; }

    return { entry: entry, score: s, est: est, hit: hit };
  }

  /** 排序用的金额键：once 型与无法量化的都算 -1，避免大促总额霸榜 */
  function sortEst(entry, est) {
    if (est === null) { return -1; }
    if (entry.save && entry.save.once) { return -1; }
    return est;
  }

  /**
   * rankToday(entries, ctx) → 条目数组
   * ctx: { now, logs, topCat, catSpend:{餐饮:320,...}, budgetStatus:'danger'|'tight'|'safe', limit }
   *
   * 硬规则（比排序更重要）：
   *   ① **今天用不了的条目一律不进清单**——「周四肯德基」周一推给用户就是在骗人；
   *   ② 命中今天的条目优先，不限条数（受 limit）；
   *   ③ 常驻条（trigger=null）只做填充，最多 3 条，避免挤掉「今天才有」的。
   * 排序：score ↓ → estimateSave ↓（null 视为 -1）→ id 字典序 ↑（保证同日期两次渲染结果一致）
   */
  function rankToday(entries, ctx) {
    ctx = ctx || {};
    var list = Array.isArray(entries) ? entries : ENTRIES;
    var now = ctx.now || new Date();
    var day = dateKey(now);
    var limit = typeof ctx.limit === 'number' ? ctx.limit : 5;
    var logs = ctx.logs || [];
    var ALWAYS_MAX = 3;
    var rows = [], i;

    for (i = 0; i < list.length; i++) {
      var e = list[i];
      if (!e) { continue; }
      if (isChecked(logs, e.id, day)) { continue; }
      /* ① 有 trigger 但今天不命中 → 直接排除，不参与排序 */
      if (e.trigger && !matchTrigger(e, now)) { continue; }
      rows.push(scoreOne(e, ctx));
    }

    rows.sort(function (a, b) {
      if (b.score !== a.score) { return b.score - a.score; }
      var ea = sortEst(a.entry, a.est);
      var eb = sortEst(b.entry, b.est);
      if (eb !== ea) { return eb - ea; }
      return a.entry.id < b.entry.id ? -1 : (a.entry.id > b.entry.id ? 1 : 0);
    });

    /* ②③ 先取命中今天的，再用常驻条补位（最多 3 条） */
    var out = [], alwaysUsed = 0;
    for (i = 0; i < rows.length && out.length < limit; i++) {
      if (rows[i].hit) { out.push(rows[i].entry); }
    }
    for (i = 0; i < rows.length && out.length < limit && alwaysUsed < ALWAYS_MAX; i++) {
      if (!rows[i].entry.trigger) {
        out.push(rows[i].entry);
        alwaysUsed++;
      }
    }
    return out;
  }

  /* ================================================================== */
  /* 五、搜索与分类                                                       */
  /* ================================================================== */

  /**
   * search(entries, q) → 条目数组
   * 命中范围：标题 / 动作 / 关键词 / 门槛；命中数多的排前面，同分按 id。
   */
  function search(entries, q) {
    var list = Array.isArray(entries) ? entries : ENTRIES;
    var kw = String(q || '').trim().toLowerCase();
    if (!kw) { return list.slice(); }

    var scored = [];
    for (var i = 0; i < list.length; i++) {
      var e = list[i];
      var hit = 0;
      if (String(e.title || '').toLowerCase().indexOf(kw) !== -1) { hit += 4; }
      if (String(e.action || '').toLowerCase().indexOf(kw) !== -1) { hit += 2; }
      if (String(e.gate || '').toLowerCase().indexOf(kw) !== -1) { hit += 1; }
      for (var k = 0; k < (e.keywords || []).length; k++) {
        var kk = String(e.keywords[k]).toLowerCase();
        if (kk === kw) { hit += 5; }
        else if (kk.indexOf(kw) !== -1 || kw.indexOf(kk) !== -1) { hit += 3; }
      }
      if (hit > 0) { scored.push({ e: e, hit: hit }); }
    }

    scored.sort(function (a, b) {
      if (b.hit !== a.hit) { return b.hit - a.hit; }
      return a.e.id < b.e.id ? -1 : (a.e.id > b.e.id ? 1 : 0);
    });

    return scored.map(function (x) { return x.e; });
  }

  /** 某个账本分类关联的条目（账本联动：账本说你在餐饮花最多 → 找餐饮类动作） */
  function entriesForBill(cat, entries) {
    var list = Array.isArray(entries) ? entries : ENTRIES;
    return list.filter(function (e) {
      return e.billCats && e.billCats.indexOf(cat) !== -1;
    });
  }

  function byCat(cat, entries) {
    var list = Array.isArray(entries) ? entries : ENTRIES;
    if (!cat) { return list.slice(); }
    return list.filter(function (e) { return e.cat === cat; });
  }

  /* ================================================================== */
  /* 六、打卡与省钱账                                                     */
  /* ================================================================== */

  function isChecked(logs, id, day) {
    if (!Array.isArray(logs)) { return false; }
    for (var i = 0; i < logs.length; i++) {
      if (logs[i] && logs[i].id === id && logs[i].date === day) { return true; }
    }
    return false;
  }

  /**
   * toggleCheck(logs, id, day, saved, nowMs) → { logs, action:'add'|'remove' }
   * 纯函数：不改传入数组。同一 id 同一自然日只允许一条 → 第二次点击是「取消」。
   */
  function toggleCheck(logs, id, day, saved, nowMs) {
    var next = Array.isArray(logs) ? logs.slice() : [];
    for (var i = 0; i < next.length; i++) {
      if (next[i] && next[i].id === id && next[i].date === day) {
        next.splice(i, 1);
        return { logs: next, action: 'remove' };
      }
    }
    var manual = (saved !== undefined && saved !== null && isFinite(Number(saved)));
    next.push({
      id: id,
      date: day,
      saved: manual ? round2(Number(saved)) : 0,
      manual: manual,
      at: typeof nowMs === 'number' ? nowMs : Date.now()
    });
    return { logs: next, action: 'add' };
  }

  /**
   * summary(logs, opts) → { count, totalSaved, monthSaved, monthCount, byCat }
   * opts: { cycleStart:'YYYY-MM-DD', cycleEnd:'YYYY-MM-DD' }
   *   totalSaved 不随周期清零；monthSaved 只统计落在当前预算周期内的记录。
   */
  function summary(logs, opts) {
    opts = opts || {};
    var arr = Array.isArray(logs) ? logs : [];
    var total = 0, month = 0, monthCount = 0, byCat = {};
    var cs = opts.cycleStart || '';
    var ce = opts.cycleEnd || '';

    for (var i = 0; i < arr.length; i++) {
      var r = arr[i] || {};
      var v = isFinite(r.saved) ? Number(r.saved) : 0;
      total += v;

      var inCycle = true;
      if (cs && r.date && r.date < cs) { inCycle = false; }
      if (ce && r.date && r.date > ce) { inCycle = false; }
      if (inCycle) { month += v; monthCount++; }

      var e = dataById(r.id);
      var cat = e ? e.cat : 'unknown';
      byCat[cat] = byCat[cat] || { count: 0, saved: 0 };
      byCat[cat].count += 1;
      byCat[cat].saved = round2(byCat[cat].saved + v);
    }

    return {
      count: arr.length,
      totalSaved: round2(total),
      monthSaved: round2(month),
      monthCount: monthCount,
      byCat: byCat
    };
  }

  function dataById(id) {
    for (var i = 0; i < ENTRIES.length; i++) { if (ENTRIES[i].id === id) { return ENTRIES[i]; } }
    return null;
  }

  /* ================================================================== */
  /* 七、HTML 卡片                                                        */
  /* ================================================================== */

  /** 行内小图标（与 app.js 的 ic 同义；模块独立闭包不能跨文件取名） */
  function svIcon(name, cls, label) {
    var D = (typeof module !== 'undefined' && module.exports) ? require('./data.js') : global.AJ.data;
    return D.inlineIcon('i-' + name, cls, label);
  }

  function catMeta(cat) {
    for (var i = 0; i < CATS.length; i++) { if (CATS[i].key === cat) { return CATS[i]; } }
    return { key: cat, name: '其他', ico: 'cat-other' };
  }

  /**
   * 条目 → 品牌瓦片 id（键取自 deals.js 的 BRANDS / LOGOS）。
   * 只有「真的对应某家商户」的条目才有；食堂清仓、外卖会员这种
   * 没有具体商户的动作不硬套 logo，走分类线性图标。
   */
  var MERCHANT_BRAND = {
    'mcd.01': 'mcd', 'mcd.member': 'mcd-member',
    'kfc.02': 'kfc',
    'tastien.04': 'tastien',
    'ph.05': 'pizza',
    'wallace.07': 'wallace', 'wallace.member': 'wallace',
    'dicos.18': 'dicos',
    'haidilao.student': 'haidilao',
    'dominos.21': 'dominos-mon', 'dominos.22': 'dominos-wed',
    'luckin.31': 'luckin', 'luckinsnack.50': 'luckin',
    'cotti.32': 'cotti',
    'mixue.33': 'mixue', 'mixue.12off': 'mixue',
    'heytea.34': 'heytea-topping', 'heytea.topping': 'heytea-topping',
    'convenience.38': 'convenience',
    'chabaidao.upsize': 'chabaidao-up', 'chabaidao.88': 'chabaidao-88',
    'guming.20': 'guming',
    'yihetang.18': 'yihetang',
    'zhaoyiming.41': 'zym',
    'haoxianglai.8': 'haoxianglai',
    'runtai.51': 'runtop',
    'zunte.52': 'zunte'
  };

  /** 取品牌瓦片 id：'fastfood.mcd.01' → 'mcd'，没有则返回 '' */
  function brandIdOf(entry) {
    var id = String((entry && entry.id) || '');
    var m = id.match(/^[a-z]+\.([\w.\-]+)$/);
    return (m && MERCHANT_BRAND[m[1]]) || '';
  }

  function dealsApi() {
    return (global.AJ && global.AJ.deals) ? global.AJ.deals : null;
  }

  /** 分类线性图标（没有品牌可挂时用，和全站图标语言一致） */
  function catIconHtml(cat, cls, label) {
    var m = catMeta(cat);
    return svIcon(m.ico || 'cat-other', cls || 'sv-ico', label || m.name);
  }

  /**
   * 条目图标：真实品牌 logo > 品牌字母章 > 分类线性图标。
   * size: 'md'(24px，卡片标题) | 'sm'(20px，紧凑行) | 省略(30px)
   */
  function entryIconHtml(entry, size) {
    if (!entry) { return ''; }
    var bid = brandIdOf(entry);
    var D = dealsApi();
    if (bid && D && D.brandTile) {
      var tile = D.brandTile(bid, size || 'md');
      if (tile) { return tile; }
    }
    return catIconHtml(entry.cat, size === 'sm' ? 'sv-ico sm' : 'sv-ico');
  }

  function certTag(certainty) {
    var label = CERT_LABEL[certainty];
    if (!label) { return ''; }
    return '<span class="sv-tag sv-tag-' + esc(certainty) + '">' + esc(label) + '</span>';
  }

  function highlight(text, q) {
    var safe = esc(text);
    var kw = String(q || '').trim();
    if (!kw) { return safe; }
    var k = esc(kw);
    if (!k) { return safe; }
    try {
      return safe.replace(new RegExp(k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), function (m) {
        return '<mark>' + m + '</mark>';
      });
    } catch (e) {
      return safe;
    }
  }

  /**
   * entryCardHtml(entry, opts) → string
   * opts: { checked:boolean, q:'搜索词', compact:boolean }
   */
  function entryCardHtml(entry, opts) {
    opts = opts || {};
    if (!entry) { return ''; }
    var m = catMeta(entry.cat);
    var checked = !!opts.checked;
    var q = opts.q || '';
    var saveLabel = saveText(entry);

    var html = '<div class="sv-card' + (checked ? ' is-checked' : '') + '" data-sv-id="' + esc(entry.id) + '">';

    html += '<div class="sv-card-top">' +
      '<div class="sv-head">' + entryIconHtml(entry, 'md') +
      '<b class="sv-title">' + highlight(entry.title, q) + '</b></div>' +
      '<span class="sv-save">' + esc(saveLabel) + '</span>' +
      '</div>';

    html += '<p class="sv-action">' + highlight(entry.action, q) + '</p>';

    html += '<div class="sv-meta">' +
      '<span class="sv-pill">门槛：' + esc(entry.gate) + '</span>' +
      '<span class="sv-pill">适合：' + esc(entry.who) + '</span>' +
      certTag(entry.certainty) +
      '</div>';

    html += '<div class="sv-risk">' + svIcon('alert') + esc(entry.risk) + '</div>';

    html += '<div class="sv-acts">' +
      '<button type="button" class="btn-mini' + (checked ? '' : ' primary') + '" data-sv-act="toggle" data-sv-id="' + esc(entry.id) + '">' +
      (checked ? '✓ 今天用了（点击撤销）' : '✓ 今天用了') +
      '</button>' +
      '<button type="button" class="btn-mini" data-sv-act="detail" data-sv-id="' + esc(entry.id) + '">详情</button>' +
      '</div>';

    html += '</div>';
    return html;
  }

  /**
   * todayCardHtml(ctx) → string
   * ctx: { now, logs, topCat, catSpend, budgetStatus, limit, checked }
   */
  function todayCardHtml(ctx) {
    ctx = ctx || {};
    var now = ctx.now || new Date();
    var logs = ctx.logs || [];
    var list = rankToday(ENTRIES, ctx);
    var day = dateKey(now);
    var html = '';

    if (!list.length) {
      return '<div class="sv-empty">' + svIcon('target', 'bico-brand', '已完成') + '今天的动作都打完卡了<br><span class="hint">去「图谱」里翻翻别的分类，或者明天再来。</span></div>';
    }

    var hitN = 0, relN = 0, k;
    for (k = 0; k < list.length; k++) {
      if (list[k].trigger && matchTrigger(list[k], now)) { hitN++; }
      if (ctx.topCat && list[k].billCats && list[k].billCats.indexOf(ctx.topCat) !== -1) { relN++; }
    }

    /* 只说事实：命中几条、几条和你的大头支出相关——不承诺「第一条就是你最该看的」 */
    if (hitN > 0) {
      html += '<p class="sv-lead">今天命中 ' + hitN + ' 条踩点优惠' +
        (relN ? '，其中 ' + relN + ' 条和你的「' + esc(ctx.topCat) + '」支出相关' : '') + '。</p>';
    } else {
      html += '<p class="sv-lead sv-lead-soft">今天没有踩点的规则优惠，下面几条随时都能用。</p>';
    }

    for (var i = 0; i < list.length; i++) {
      html += entryCardHtml(list[i], { checked: isChecked(logs, list[i].id, day) });
    }
    return html;
  }

  /* ================================================================== */
  /* 六、Markdown 导出（「所有省钱大全」）                                  */
  /* ================================================================== */

  /** Markdown 里不要出现 HTML 实体；反引号要挡掉，否则会破坏行内代码块 */
  function mdText(s) {
    return String(s === null || s === undefined ? '' : s)
      .replace(/`/g, '\u0060\u200b').replace(/\r/g, '').trim();
  }

  /**
   * toMarkdown(opts) → string
   * opts: { logs, now, title, withToday }
   *   把 100 条导成一份可粘贴到群聊 / 笔记 / 公众号的文档。
   *   刻意不用 Markdown 表格：做法文案里有「|」会直接炸表格结构。
   */
  function toMarkdown(opts) {
    opts = opts || {};
    var logs = Array.isArray(opts.logs) ? opts.logs : [];
    var now = opts.now instanceof Date ? opts.now : new Date();
    var sum = summary(logs, {});
    var lines = [];
    var i, k;

    /* 每条记录按 id 汇总次数，详情里就能写「我的打卡：3 次」 */
    var hits = {};
    for (i = 0; i < logs.length; i++) {
      var lid = logs[i] && logs[i].id;
      if (!lid) { continue; }
      hits[lid] = hits[lid] || { n: 0, saved: 0, manual: 0 };
      hits[lid].n++;
      hits[lid].saved += isFinite(logs[i].saved) ? Number(logs[i].saved) : 0;
      if (logs[i].manual) { hits[lid].manual++; }
    }

    lines.push('# ' + (opts.title || '所有省钱大全') + ' · ' + ENTRIES.length + ' 条');
    lines.push('');
    lines.push('> 大学生全网省钱图谱：10 类各 10 条，全部是可执行动作，不是口号。');
    lines.push('> 生成于 ' + dateKey(now) + ' ' + pad2(now.getHours()) + ':' + pad2(now.getMinutes()) +
      ' · 金额均为估算区间，**不承诺最低价**，下单前以商家当期页面为准。');
    lines.push('');

    /* ---- 概览 ---- */
    lines.push('| | |');
    lines.push('| --- | --- |');
    lines.push('| 动作总数 | ' + ENTRIES.length + ' 条 · ' + CATS.length + ' 个分类 |');
    lines.push('| 我的打卡 | ' + sum.count + ' 次，累计约省 ¥' + fmt(sum.totalSaved) + ' |');
    if (opts.withToday !== false) {
      var today = rankToday(ENTRIES, { now: now, logs: logs, limit: 5 });
      lines.push('| 今天可用 | ' + today.length + ' 条（按你的账本排序） |');
    }
    lines.push('');

    /* ---- 目录 ---- */
    lines.push('## 目录');
    lines.push('');
    for (i = 0; i < CATS.length; i++) {
      lines.push((i + 1) + '. ' + CATS[i].emoji + ' ' + CATS[i].name + '（' + byCat(CATS[i].key).length + ' 条）');
    }
    lines.push('');
    lines.push('---');
    lines.push('');

    /* ---- 正文：按分类分组 ---- */
    for (i = 0; i < CATS.length; i++) {
      var cat = CATS[i];
      var list = byCat(cat.key);
      lines.push('## ' + (i + 1) + '. ' + cat.emoji + ' ' + cat.name + '（' + list.length + ' 条）');
      lines.push('');
      for (k = 0; k < list.length; k++) {
        var e = list[k];
        var tag = CERT_LABEL[e.certainty] || '';
        lines.push('### ' + (k + 1) + '. ' + mdText(e.title) + (tag ? '（' + tag + '）' : ''));
        lines.push('');
        /* 「≈ 省 ¥6.00」+「¥4.00 - ¥8.00（每次估算）」拼在一起会有两层括号、两个「省」，
           导出给人读的文档要合并成一句：range → 括注区间；ratio → 括注折扣；fixed/none 不再重复。 */
        var st = e.save || {};
        var amountLine = mdText(saveText(e));
        if (st.type === 'range') {
          amountLine += '（区间 ¥' + fmt(st.min) + ' - ¥' + fmt(st.max) + '，按次估算）';
        } else if (st.type === 'ratio') {
          amountLine += '（' + ratioText(st) + '）';
        }
        lines.push('- **能省多少**：' + amountLine);
        lines.push('- **什么时候能用**：' + mdText(triggerText(e)));
        lines.push('- **用在哪**：' + mdText(sceneText(e)));
        lines.push('- **怎么做**：' + mdText(e.action));
        lines.push('- **门槛**：' + mdText(e.gate));
        lines.push('- **适合谁**：' + mdText(e.who));
        lines.push('- **坑在哪**：' + mdText(e.risk));
        lines.push('- **账本分类**：' + mdText((e.billCats || []).join(' / ') || '—'));
        lines.push('- **来源**：' + mdText(e.source || '—'));
        if (hits[e.id]) {
          lines.push('- **我的打卡**：' + hits[e.id].n + ' 次' +
            (hits[e.id].saved > 0 ? '，约省 ¥' + fmt(hits[e.id].saved) : '，未计金额') +
            (hits[e.id].manual ? '（其中 ' + hits[e.id].manual + ' 次手动改过金额）' : ''));
        }
        lines.push('');
      }
      lines.push('---');
      lines.push('');
    }

    lines.push('> 由「AI 记账 · 省钱图谱」导出。金额口径：固定省额 / 折扣比 / 区间取中位 / 无法量化不计金额；');
    lines.push('> 大促与年卡型（`once`）在 App 内只计打卡次数、不计金额，避免累计虚高。');
    lines.push('');
    return lines.join('\n');
  }

  /* ================================================================== */
  /* 导出                                                                */
  /* ================================================================== */

  var API = {
    VERSION: '1.0.0',
    READY: READY,
    ENTRIES: ENTRIES,
    CATS: CATS,
    CERT_LABEL: CERT_LABEL,
    DATA: DATA,

    /* 日期 */
    toDate: toDate, dateKey: dateKey, mmddKey: mmddKey,
    isoWeekday: isoWeekday, weekdayCn: weekdayCn, hhmm: hhmm,

    /* 计算 */
    estimateSave: estimateSave, saveText: saveText, saveRangeText: saveRangeText, ratioText: ratioText,
    matchTrigger: matchTrigger, rankToday: rankToday, scoreOne: scoreOne,
    triggerText: triggerText, sceneText: sceneText,
    search: search, entriesForBill: entriesForBill, byCat: byCat, byId: dataById,

    /* 打卡 */
    isChecked: isChecked, toggleCheck: toggleCheck, summary: summary,

    /* 渲染 */
    catMeta: catMeta, entryCardHtml: entryCardHtml, todayCardHtml: todayCardHtml,
    catIconHtml: catIconHtml, entryIconHtml: entryIconHtml, brandIdOf: brandIdOf,
    esc: esc, fmt: fmt,

    /* 导出 */
    toMarkdown: toMarkdown
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.savings = API;
  }
})(typeof window !== 'undefined' ? window : this);

  </script>
  <!-- 存钱罐模块（独立存储、独立话术库，主账本只读它的余额） -->
<script>
/**
 * piggy.js — 存钱罐模块（纯逻辑 + 鼓励话术，UMD）
 *
 * 定位：把「账面可用余额」里的一部分钱挪进罐子锁起来，
 *       与账单流水（state.bills）**完全解耦**，不写账单、不改分类统计。
 *
 * 为什么要独立一个模块 + 独立存储键：
 *   ① 存钱不是消费，塞进 state.bills 会污染分类占比 / 恩格尔系数 / 近 7 日趋势；
 *   ② 罐子数据损坏时只应重置自己，不能让用户丢掉真实账单（与省钱图谱同理）；
 *   ③ 主账本对存钱罐只有「读余额」这一个依赖点，删掉本文件主程序照样能跑。
 *
 * 金额约定：**内部一律用「分」的整数**存储与计算（避免 0.1+0.2 这类浮点误差），
 * 对外展示时才转成元。这与主账本（元 + round2）不同，是刻意选择：
 * 罐子要做「存入 / 取出」的加减闭环，整数分能保证存满再取空后余额精确回到 0。
 *
 * 对外 API（window.AJ.piggy）：
 *   isReady()                     存储是否可用（隐私模式下为 false）
 *   load()                        从 localStorage 读入，失败时降级为空库
 *   getBalanceCents() / getBalance()   当前罐内余额（分 / 元）
 *   deposit(cents, note)          存入 → {ok,log,balanceCents}|{ok:false,reason}
 *   withdraw(cents, note)         取出 → 同上
 *   listLogs(limit)               流水（新的在前）
 *   stats()                       {balanceCents,count,depositCount,days,streak,todayCents,biggestCents,firstDate,lastDate}
 *   cheer(ctx)                    鼓励话术 → {emoji,title,text}（emoji 字段现在存 #i-xxx 的 symbol 名）
 *   parseAmount(text)             '50' / '50.5' / '￥50元' → 5000（分），非法返回 null
 *   fmtCents(cents)               5000 → '¥50.00'
 *   reset()                       清空罐子（供「重置演示数据」调用）
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);

  var KEY = 'ai_jizhang_piggy_v1';
  var VERSION = 1;
  /** 流水上限：超过后丢最旧的，防止无界增长 */
  var MAX_LOGS = 500;
  /** 单笔上限：100 万元（分） */
  var MAX_CENTS = 100000000;
  /** 单笔下限：0.01 元 */
  var MIN_CENTS = 1;

  /**
   * 库结构：balance 是**权威余额**（分），logs 只用于展示。
   * 为什么余额要单独存：logs 有 500 条上限，超了会丢最旧的记录，
   * 只靠 logs 累加会让「存了很多笔」的老用户余额凭空变少。
   */
  var db = { v: VERSION, balance: 0, logs: [], updatedAt: 0 };
  /** 存储不可用（隐私模式 / 配额满）时为 false —— 只读展示，写入返回 reason:'store' */
  var ready = true;

  /* ------------------------------------------------------------------ */
  /* 基础工具                                                            */
  /* ------------------------------------------------------------------ */

  function pad2(n) { return (n < 10 ? '0' : '') + n; }

  function dateKey(value) {
    var d = (value === undefined || value === null) ? new Date() : new Date(value);
    if (isNaN(d.getTime())) { d = new Date(); }
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  function addDays(key, days) {
    var p = String(key).split('-');
    var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
    if (isNaN(d.getTime())) { return key; }
    d.setDate(d.getDate() + days);
    return dateKey(d);
  }

  /** 元 → 分（四舍五入到分）。非有限数或负数返回 null。 */
  function toCents(yuan) {
    var v = Number(yuan);
    if (!isFinite(v) || v < 0) { return null; }
    return Math.round(v * 100);
  }

  /** 分 → '¥1,234.00'（与 engine.fmtMoney 同形，模块内自带以便单测） */
  function fmtCents(cents) {
    var v = Math.round(Number(cents) || 0);
    var neg = v < 0;
    var abs = Math.abs(v);
    var s = Math.floor(abs / 100) + '.' + pad2(abs % 100);
    var parts = s.split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return (neg ? '-¥' : '¥') + parts[0] + '.' + parts[1];
  }

  function uid() {
    return 'p_' + Date.now().toString(36) + '_' + Math.floor(Math.random() * 100000).toString(36);
  }

  /* ------------------------------------------------------------------ */
  /* 持久化                                                              */
  /* ------------------------------------------------------------------ */

  function normalizeLog(r) {
    if (!r || typeof r !== 'object') { return null; }
    var cents = Math.round(Number(r.cents));
    if (!isFinite(cents) || cents <= 0) { return null; }
    var type = (r.type === 'out') ? 'out' : 'in';
    var date = (typeof r.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(r.date)) ? r.date : '';
    if (!date) { return null; }
    return {
      id: (typeof r.id === 'string' && r.id) ? r.id : uid(),
      date: date,
      type: type,
      cents: Math.min(cents, MAX_CENTS),
      note: typeof r.note === 'string' ? r.note.slice(0, 40) : '',
      at: isFinite(Number(r.at)) ? Number(r.at) : Date.now()
    };
  }

  /** 逐条归一化：坏条丢弃、不牵连整库（与省钱图谱同策略） */
  function normalizeDb(obj) {
    var o = (obj && typeof obj === 'object') ? obj : {};
    var src = Array.isArray(o.logs) ? o.logs : [];
    var out = [];
    var seen = {};
    var fromLogs = 0;
    for (var i = 0; i < src.length; i++) {
      var r = normalizeLog(src[i]);
      if (!r) { continue; }
      var k = r.id;
      if (seen[k]) { continue; }
      seen[k] = 1;
      out.push(r);
      fromLogs += (r.type === 'out' ? -r.cents : r.cents);
    }
    // balance 缺失 / 非法时用流水重算（旧存档兼容）；否则以 balance 为准
    var bal = Math.round(Number(o.balance));
    if (!isFinite(bal) || bal < 0 || bal > MAX_CENTS * 10) { bal = Math.max(0, fromLogs); }
    return {
      v: VERSION,
      balance: bal,
      logs: out,
      updatedAt: isFinite(Number(o.updatedAt)) ? Number(o.updatedAt) : 0
    };
  }

  /**
   * 取存储对象。
   * 浏览器用 localStorage；Node（单测）用进程内内存库，
   * 这样 deposit / withdraw 的闭环在单测里也能真实落盘校验。
   */
  var memStore = null;
  function storage() {
    if (isNode) {
      if (!memStore) {
        memStore = {
          _d: {},
          getItem: function (k) {
            return Object.prototype.hasOwnProperty.call(this._d, k) ? this._d[k] : null;
          },
          setItem: function (k, v) { this._d[k] = String(v); }
        };
      }
      return memStore;
    }
    try {
      return global.localStorage || null;
    } catch (e) {
      return null;
    }
  }

  function load() {
    var ls = storage();
    if (!ls) { ready = false; db = { v: VERSION, balance: 0, logs: [], updatedAt: 0 }; return db; }
    var raw = null;
    try {
      raw = ls.getItem(KEY);
    } catch (e) {
      ready = false;
      db = { v: VERSION, balance: 0, logs: [], updatedAt: 0 };
      return db;
    }
    if (!raw) { db = { v: VERSION, balance: 0, logs: [], updatedAt: 0 }; return db; }
    try {
      db = normalizeDb(JSON.parse(raw));
    } catch (e2) {
      // 存档坏了：只把罐子清空，绝不动主账本
      db = { v: VERSION, balance: 0, logs: [], updatedAt: 0 };
    }
    return db;
  }

  function save() {
    var ls = storage();
    if (!ls) { ready = false; return false; }
    try {
      db.updatedAt = Date.now();
      ls.setItem(KEY, JSON.stringify(db));
      return true;
    } catch (e) {
      ready = false;
      return false;
    }
  }

  /* ------------------------------------------------------------------ */
  /* 读写                                                                */
  /* ------------------------------------------------------------------ */

  /** 罐内余额（分）：以权威字段为准，流水只做展示 */
  function getBalanceCents() {
    return Math.round(Number(db.balance) || 0);
  }

  function getBalance() {
    return getBalanceCents() / 100;
  }

  /**
   * 存入。
   * @param {number} cents 金额（分，正整数）
   * @param {string} [note] 备注
   * @return {{ok:boolean, log:?Object, balanceCents:number, reason:?string}}
   */
  /**
   * 校验金额是不是合法的「分」。
   * 注意：不做 Math.round —— 0.5 分这种非整数输入必须判非法，
   * 否则「存 0.5 分」会被悄悄记成 1 分，账就对不上了。
   */
  function validCents(cents) {
    var c = Number(cents);
    if (!isFinite(c) || Math.floor(c) !== c || c > 9007199254740991) { return -1; }
    return c;
  }

  function deposit(cents, note) {
    var c = validCents(cents);
    if (c < MIN_CENTS) { return fail('amount'); }
    if (c > MAX_CENTS) { return fail('toolarge'); }
    var log = {
      id: uid(),
      date: dateKey(new Date()),
      type: 'in',
      cents: c,
      note: typeof note === 'string' ? note.slice(0, 40) : '',
      at: Date.now()
    };
    db.logs.push(log);
    if (db.logs.length > MAX_LOGS) { db.logs = db.logs.slice(db.logs.length - MAX_LOGS); }
    db.balance = getBalanceCents() + c;
    if (!save()) {
      // 写不进去就把这条撤回来，避免「界面显示存了、刷新后没了」
      db.logs.pop();
      db.balance = getBalanceCents() - c;
      return fail('store');
    }
    return { ok: true, log: log, balanceCents: getBalanceCents(), reason: null };
  }

  /**
   * 取出。
   * @param {number} cents 金额（分）；不传或超过余额时按「全部取出」处理
   */
  function withdraw(cents, note) {
    var bal = getBalanceCents();
    if (bal <= 0) { return fail('empty'); }
    var c = validCents(cents);
    if (c <= 0 || c > bal) { c = bal; }
    var log = {
      id: uid(),
      date: dateKey(new Date()),
      type: 'out',
      cents: c,
      note: typeof note === 'string' ? note.slice(0, 40) : '',
      at: Date.now()
    };
    db.logs.push(log);
    if (db.logs.length > MAX_LOGS) { db.logs = db.logs.slice(db.logs.length - MAX_LOGS); }
    db.balance = bal - c;
    if (!save()) {
      db.logs.pop();
      db.balance = bal;
      return fail('store');
    }
    return { ok: true, log: log, balanceCents: getBalanceCents(), reason: null };
  }

  function fail(reason) {
    return { ok: false, log: null, balanceCents: getBalanceCents(), reason: reason };
  }

  /** 最近的流水（新的在前） */
  function listLogs(limit) {
    var n = (limit === undefined || limit === null) ? db.logs.length : Math.max(0, Math.round(limit));
    var arr = db.logs.slice().sort(function (a, b) {
      return (b.at || 0) - (a.at || 0);
    });
    return n >= arr.length ? arr : arr.slice(0, n);
  }

  /**
   * 汇总统计。
   * streak = 连续存钱天数（今天还没存时从昨天往前算，不会一早就断签）
   */
  function stats() {
    var balance = getBalanceCents();
    var count = 0;
    var days = {};
    var inDays = {};
    var first = '';
    var last = '';
    var todayKey = dateKey(new Date());
    var todayCents = 0;
    var biggest = 0;
    var i;
    for (i = 0; i < db.logs.length; i++) {
      var l = db.logs[i];
      days[l.date] = 1;
      if (l.type === 'in') {
        count++;
        inDays[l.date] = 1;
        if (l.date === todayKey) { todayCents += l.cents; }
        if (l.cents > biggest) { biggest = l.cents; }
        if (!first || l.date < first) { first = l.date; }
        if (!last || l.date > last) { last = l.date; }
      }
    }
    var streak = 0;
    var cur = todayKey;
    if (!inDays[cur]) { cur = addDays(cur, -1); }
    while (inDays[cur]) {
      streak++;
      cur = addDays(cur, -1);
    }
    return {
      balanceCents: balance,
      count: count,
      depositCount: count,
      days: Object.keys(days).length,
      streak: streak,
      todayCents: todayCents,
      biggestCents: biggest,
      firstDate: first,
      lastDate: last
    };
  }

  function reset() {
    db = { v: VERSION, balance: 0, logs: [], updatedAt: 0 };
    return save();
  }

  /* ------------------------------------------------------------------ */
  /* 输入解析                                                            */
  /* ------------------------------------------------------------------ */

  /**
   * 解析用户输入的金额文本 → 分。
   * 允许：'50' / '50.5' / '50.00' / '￥50' / '50元' / '１２０'（全角数字）
   * 拒绝：空 / 非数字 / 0 / 负数 / 科学计数法 → null
   */
  function parseAmount(text) {
    if (text === null || text === undefined) { return null; }
    var s = String(text).trim();
    if (!s) { return null; }
    // 全角数字 + 全角句点转半角
    s = s.replace(/[\uFF10-\uFF19]/g, function (c) {
      return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
    }).replace(/\uFF0E/g, '.');
    // 去掉货币符与单位、千分位
    s = s.replace(/[¥￥$,\s元块]/g, '');
    if (!/^\d+(\.\d{1,2})?$/.test(s)) {
      // 允许 3 位以上小数，四舍五入到分
      if (!/^\d+(\.\d+)?$/.test(s)) { return null; }
    }
    var cents = toCents(s);
    if (cents === null || cents < MIN_CENTS) { return null; }
    return Math.min(cents, MAX_CENTS);
  }

  /* ------------------------------------------------------------------ */
  /* 鼓励话术                                                            */
  /* ------------------------------------------------------------------ */

  /** 里程碑：跨过就换一句更有分量的话 */
  var MILESTONES = [
    { cents: 10000, text: '破百了！第一个一百块最难，后面会越来越快。' },
    { cents: 50000, text: '五百块在手，已经够一台二手平板或者一次说走就走的短途。' },
    { cents: 100000, text: '一千块！这在学生阶段是一笔正经的「底气钱」了。' },
    { cents: 300000, text: '三千块，你已经攒下了一个月的容错空间。' }
  ];

  /** 按单笔金额分档的主话术 */
  function tierLines(amountCents, balanceCents) {
    var yuan = amountCents / 100;
    if (yuan < 5) {
      return [
        '几块钱也是钱，攒钱的习惯比金额更值钱。',
        '小钱不嫌少，罐子就是靠这种「顺手一存」长大的。',
        '别小看这几块，月底你会感谢现在顺手存下的自己。'
      ];
    }
    if (yuan < 20) {
      return [
        '一杯奶茶的钱换成了存款，这波很清醒。',
        '这笔存下来，等于把一次冲动消费提前拦住了。',
        '一顿饭钱进罐子，嘴上省一口，心里踏实一分。'
      ];
    }
    if (yuan < 100) {
      return [
        '这个数额刚刚好，既存下了钱，又不影响这几天吃饭。',
        '稳，这笔存得很有分寸。',
        '把钱先挪进罐子，剩下的才是真能花的额度。'
      ];
    }
    if (yuan < 500) {
      return [
        '手笔不小！这笔存下去，本月的存款曲线会很明显。',
        '这一下够实在的，月底你会看到差距。',
        '大笔先锁起来，是防止它被「不知道怎么就没了」的最好办法。'
      ];
    }
    return [
      '这一笔相当有魄力，你对自己挺狠的（褒义）。',
      '大额先入罐，这个决定比买任何东西都值。',
      '敢一次性存这么多，说明你心里有数了。'
    ];
  }

  /** 连续存钱的加成话术 */
  function streakLines(streak) {
    if (streak >= 7) { return '已经连续 ' + streak + ' 天往里存了，这个节奏别断。'; }
    if (streak >= 3) { return '连续 ' + streak + ' 天，习惯正在成型，继续保持。'; }
    if (streak >= 2) { return '这是连续第 ' + streak + ' 天，第二天是最容易断的，你顶住了。'; }
    return '';
  }

  /** 余额偏紧还坚持存的特别鼓励 */
  function tightLines(remainingCents, dailyCents) {
    if (remainingCents === null || remainingCents === undefined) { return ''; }
    if (remainingCents <= 0) { return ''; }
    if (dailyCents && remainingCents < dailyCents * 3) {
      return '现在账面不算宽裕，你还在存钱，这份克制值得记一笔。';
    }
    if (remainingCents < 10000) {
      return '余额已经不多了，记得给吃饭留够钱，存钱可以随时停。';
    }
    return '';
  }

  /**
   * 生成鼓励话术（纯函数，便于单测）。
   * @param {Object} ctx
   *   amountCents     本次存入金额（分）
   *   balanceCents    存入后罐内余额（分）
   *   countBefore     本次之前的存入笔数
   *   streak          连续存钱天数
   *   remainingCents  存入后账面可用余额（分），可省略
   *   dailyCents      日均可用（分），可省略
   * @return {{emoji:string, title:string, text:string}}
   */
  function cheer(ctx) {
    var c = ctx || {};
    var amount = Math.round(Number(c.amountCents) || 0);
    var balance = Math.round(Number(c.balanceCents) || 0);
    var countBefore = Math.round(Number(c.countBefore) || 0);
    var streak = Math.round(Number(c.streak) || 0);
    var remaining = (c.remainingCents === null || c.remainingCents === undefined)
      ? null : Math.round(Number(c.remainingCents));
    var daily = (c.dailyCents === null || c.dailyCents === undefined) ? null : Math.round(Number(c.dailyCents));

    var icon = 'target';
    var title;
    var lines;

    if (countBefore === 0) {
      icon = 'spark';
      title = '第一笔存钱，开罐大吉！';
      lines = ['你把钱放进罐子的那一刻，攒钱就算真的开始了。',
        '不着急，金额不重要，重要的是你开始「先存后花」了。'];
    } else {
      lines = tierLines(amount, balance);
      title = '又存下 ' + fmtCents(amount);
    }

    // 里程碑：本次刚跨过某条线
    var before = balance - amount;
    var milestone = '';
    for (var i = 0; i < MILESTONES.length; i++) {
      if (before < MILESTONES[i].cents && balance >= MILESTONES[i].cents) {
        milestone = MILESTONES[i].text;
        icon = 'piggy';
        break;
      }
    }

    var pick = lines[countBefore % lines.length];
    var extra = milestone || streakLines(streak) || tightLines(remaining, daily) || '';
    if (!extra) {
      // 兜底补一句进度提示，保证每次都有「下一句」而不是干巴巴一句
      extra = '罐子里现在一共 ' + fmtCents(balance) + '，离下一个整数还差 ' +
        fmtCents(nextStepCents(balance)) + '。';
    }

    return {
      emoji: icon,
      title: title,
      text: pick + (extra ? ' ' + extra : '')
    };
  }

  /** 距离下一个「整百 / 整千」还差多少分 */
  function nextStepCents(balanceCents) {
    var b = Math.max(0, Math.round(balanceCents));
    var step = b < 10000 ? 10000 : (b < 100000 ? 10000 : 100000);
    var next = Math.floor(b / step) * step + step;
    return next - b;
  }

  /* ------------------------------------------------------------------ */

  var API = {
    KEY: KEY,
    VERSION: VERSION,
    MAX_CENTS: MAX_CENTS,

    isReady: function () { return ready && !!storage(); },
    load: load,
    reset: reset,

    getBalanceCents: getBalanceCents,
    getBalance: getBalance,
    deposit: deposit,
    withdraw: withdraw,
    listLogs: listLogs,
    stats: stats,

    cheer: cheer,
    parseAmount: parseAmount,
    fmtCents: fmtCents,
    nextStepCents: nextStepCents,
    dateKey: dateKey,
    /* 仅供单测：拿到内部存储对象，用于注入坏存档验证容错（生产代码请勿调用） */
    __store: storage
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.piggy = API;
  }
})(typeof window !== 'undefined' ? window : this);

  </script>
  <!-- 心愿单（冷静期清单）：独立存储键 ai_jizhang_wishlist_v1，不动主账本 -->
<script>
/**
 * wishlist.js — 心愿单（冷静期清单）数据层，UMD
 *
 * 定位：把「剁手冷静法」里放下的东西留下来，48 小时后回到用户面前问一次
 *       「还想买吗」。三态：cooling（冷静中）/ bought（已买）/ dropped（已放弃）。
 *
 * 为什么要独立模块 + 独立存储键：
 *   ① 心愿单不是账单，塞进 state.bills 会污染分类占比 / 恩格尔 / 趋势；
 *   ② 清单损坏时只该重置自己，不能让用户丢真实账单（与 piggy / 省钱图谱同策略）；
 *   ③ 「省下的钱」口径沿用既有行为：入清单即计入 state.savedMoney（由 app.js 做），
 *      所以本模块只记 savedCounted 标记，成交时由 app.js 精确回退，避免双计。
 *
 * 金额约定：元 + 两位小数（与主账本一致），不做「分」的整数运算 ——
 * 心愿单只有「加 / 改状态」没有加减闭环，不需要 piggy 那套防浮点误差机制。
 *
 * 对外 API（window.AJ.wishlist）：
 *   isReady() / load() / reset()
 *   add({title,amount,note,coolDays,source}) -> {ok,item,reason}
 *   list(status) / listCooling() / get(id)
 *   progress(item,todayKey) -> {remainingDays,elapsedDays,pct,overdue}
 *   dueItems(todayKey) / decide(id,status,opts) / extend(id,days) / stats()
 *   dateKey(v) / addDays(key,n)   导出供单测与 app.js 复用
 *   __store()                     仅单测：拿内部存储对象，注入坏存档
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);

  var KEY = 'ai_jizhang_wishlist_v1';
  var VERSION = 1;
  /** 条数上限：超过就丢最旧的「已买 / 已放弃」，还在冷静中的一条都不丢 */
  var MAX_ITEMS = 200;
  /** 默认冷静期：48 小时 = 2 天 */
  var COOL_DAYS_DEFAULT = 2;
  /** 最多延长 2 次（第 3 次拒绝），每次 3 天 */
  var EXTEND_MAX = 2;
  var EXTEND_DAYS = 3;
  /** 允许的冷静期档位 */
  var COOL_DAYS_ALLOWED = [1, 2, 3, 7];
  /** 单件上限：999.9999 万元 */
  var MAX_AMOUNT = 9999999;
  var STATUSES = ['cooling', 'bought', 'dropped'];

  var db = { v: VERSION, items: [], updatedAt: 0 };
  /** 存储不可用（隐私模式 / 配额满）时为 false —— 只读展示，写入返回 reason:'store' */
  var ready = true;

  /* ------------------------------------------------------------------ */
  /* 基础工具                                                            */
  /* ------------------------------------------------------------------ */

  function pad2(n) { return (n < 10 ? '0' : '') + n; }

  function num(v) {
    var n = Number(v);
    return isFinite(n) ? n : 0;
  }

  function round2(n) { return Math.round(num(n) * 100) / 100; }

  function dateKey(value) {
    var d = (value === undefined || value === null) ? new Date() : new Date(value);
    if (isNaN(d.getTime())) { d = new Date(); }
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  function addDays(key, days) {
    var p = String(key).split('-');
    var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
    if (isNaN(d.getTime())) { return key; }
    d.setDate(d.getDate() + Number(days || 0));
    return dateKey(d);
  }

  /** 两个日期键相差几天（to - from，正数表示 to 在后） */
  function diffDays(fromKey, toKey) {
    var a = String(fromKey).split('-');
    var b = String(toKey).split('-');
    var da = new Date(Number(a[0]), Number(a[1]) - 1, Number(a[2]));
    var dbb = new Date(Number(b[0]), Number(b[1]) - 1, Number(b[2]));
    if (isNaN(da.getTime()) || isNaN(dbb.getTime())) { return 0; }
    return Math.round((dbb.getTime() - da.getTime()) / 86400000);
  }

  function isDateKey(v) { return typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v); }

  function uid() {
    return 'w_' + Date.now().toString(36) + '_' + Math.floor(Math.random() * 100000).toString(36);
  }

  function clampAmount(v) {
    var n = round2(v);
    if (n < 0) { return 0; }
    if (n > MAX_AMOUNT) { return MAX_AMOUNT; }
    return n;
  }

  function normalizeCoolDays(v) {
    var n = Math.round(num(v));
    return (COOL_DAYS_ALLOWED.indexOf(n) !== -1) ? n : COOL_DAYS_DEFAULT;
  }

  function normalizeStatus(v) {
    return (STATUSES.indexOf(v) !== -1) ? v : 'cooling';
  }

  /* ------------------------------------------------------------------ */
  /* 持久化                                                              */
  /* ------------------------------------------------------------------ */

  /** 逐条归一化：坏条丢弃、不牵连整库（与 piggy / 省钱图谱同策略） */
  function normalizeItem(raw) {
    if (!raw || typeof raw !== 'object') { return null; }
    var title = (typeof raw.title === 'string') ? raw.title.trim() : '';
    if (!title) { return null; }                       // 没名字的条目没有意义，直接丢
    title = title.slice(0, 40);
    var coolDays = normalizeCoolDays(raw.coolDays);
    var source = (raw.source === 'cooling') ? 'cooling' : 'manual';
    var startDate = isDateKey(raw.startDate) ? raw.startDate : dateKey(new Date());
    var dueDate = isDateKey(raw.dueDate) ? raw.dueDate : addDays(startDate, coolDays);
    var ext = Math.round(num(raw.extendCount));
    if (ext < 0) { ext = 0; }
    if (ext > EXTEND_MAX) { ext = EXTEND_MAX; }
    return {
      id: (typeof raw.id === 'string' && raw.id) ? raw.id : uid(),
      title: title,
      amount: clampAmount(raw.amount),
      note: (typeof raw.note === 'string') ? raw.note.slice(0, 60) : '',
      status: normalizeStatus(raw.status),
      startDate: startDate,
      dueDate: dueDate,
      coolDays: coolDays,
      extendCount: ext,
      source: source,
      // 归一化时只能「猜」：cooling 来源默认已计入省下的钱，其余默认不计
      savedCounted: (typeof raw.savedCounted === 'boolean') ? raw.savedCounted : (source === 'cooling'),
      billId: (typeof raw.billId === 'string') ? raw.billId : '',
      createdAt: isFinite(Number(raw.createdAt)) ? Number(raw.createdAt) : Date.now(),
      decidedAt: isFinite(Number(raw.decidedAt)) ? Number(raw.decidedAt) : 0
    };
  }

  function normalizeDb(obj) {
    var o = (obj && typeof obj === 'object') ? obj : {};
    var src = Array.isArray(o.items) ? o.items : [];
    var out = [];
    var seen = {};
    var i;
    for (i = 0; i < src.length; i++) {
      var it = normalizeItem(src[i]);
      if (!it) { continue; }
      if (seen[it.id]) { continue; }                    // id 重复只留第一条
      seen[it.id] = 1;
      out.push(it);
    }
    return {
      v: VERSION,
      items: out,
      updatedAt: isFinite(Number(o.updatedAt)) ? Number(o.updatedAt) : 0
    };
  }

  function emptyDb() { return { v: VERSION, items: [], updatedAt: 0 }; }

  /**
   * 取存储对象：浏览器用 localStorage，Node（单测）用进程内内存库，
   * 这样 add / decide 的落盘与回滚在单测里也能真实验证。
   */
  var memStore = null;
  function storage() {
    if (isNode) {
      if (!memStore) {
        memStore = {
          _d: {},
          getItem: function (k) {
            return Object.prototype.hasOwnProperty.call(this._d, k) ? this._d[k] : null;
          },
          setItem: function (k, v) { this._d[k] = String(v); },
          removeItem: function (k) { delete this._d[k]; }
        };
      }
      return memStore;
    }
    try {
      return global.localStorage || null;
    } catch (e) {
      return null;
    }
  }

  /** 读入：老账本没有这个键 → 空库且不写盘（首次 add 才落盘） */
  function load() {
    var ls = storage();
    if (!ls) { ready = false; db = emptyDb(); return db; }
    var raw = null;
    try {
      raw = ls.getItem(KEY);
    } catch (e) {
      ready = false;
      db = emptyDb();
      return db;
    }
    if (!raw) { db = emptyDb(); return db; }
    try {
      db = normalizeDb(JSON.parse(raw));
    } catch (e2) {
      // 存档坏了：只把心愿单清空，绝不动主账本；ready 保持 true（清空后仍能写）
      db = emptyDb();
    }
    return db;
  }

  function save() {
    var ls = storage();
    if (!ls) { ready = false; return false; }
    try {
      db.updatedAt = Date.now();
      ls.setItem(KEY, JSON.stringify(db));
      ready = true;
      return true;
    } catch (e) {
      ready = false;
      return false;
    }
  }

  function reset() {
    db = emptyDb();
    return save();
  }

  /* ------------------------------------------------------------------ */
  /* 读写                                                                */
  /* ------------------------------------------------------------------ */

  function failResult(reason) {
    return { ok: false, item: null, reason: reason };
  }

  /** 清位：超上限时优先丢最旧的「已买 / 已放弃」，仍在冷静期的一条都不动 */
  function makeRoom() {
    if (db.items.length < MAX_ITEMS) { return true; }
    var idx = -1;
    for (var i = 0; i < db.items.length; i++) {
      var it = db.items[i];
      if (it.status === 'cooling') { continue; }
      if (idx === -1) { idx = i; continue; }
      if ((it.createdAt || 0) < (db.items[idx].createdAt || 0)) { idx = i; }
    }
    if (idx === -1) { return false; }
    db.items.splice(idx, 1);
    return db.items.length < MAX_ITEMS;
  }

  /**
   * 新增一条心愿。
   * @param {{title:string, amount:number, note:string, coolDays:number, source:string}} o
   * @return {{ok:boolean, item:?Object, reason:?string}} reason: title|full|store
   */
  function add(o) {
    var src = o || {};
    var title = (typeof src.title === 'string') ? src.title.trim() : '';
    if (!title) { return failResult('title'); }
    if (!makeRoom()) { return failResult('full'); }

    var coolDays = normalizeCoolDays(src.coolDays);
    var startDate = dateKey(new Date());
    var item = {
      id: uid(),
      title: title.slice(0, 40),
      amount: clampAmount(src.amount),
      note: (typeof src.note === 'string') ? src.note.slice(0, 60) : '',
      status: 'cooling',
      startDate: startDate,
      dueDate: addDays(startDate, coolDays),
      coolDays: coolDays,
      extendCount: 0,
      source: (src.source === 'cooling') ? 'cooling' : 'manual',
      savedCounted: (src.source === 'cooling'),
      billId: '',
      createdAt: Date.now(),
      decidedAt: 0
    };
    db.items.push(item);
    if (!save()) {
      // 写不进去就撤回来，避免「界面显示加了、刷新后没了」
      db.items.pop();
      return failResult('store');
    }
    return { ok: true, item: item, reason: null };
  }

  /** 列表：省略 status 返回全部；统一 createdAt 倒序（新的在前） */
  function list(status) {
    var arr = db.items.slice();
    if (status) {
      arr = arr.filter(function (it) { return it.status === status; });
    }
    arr.sort(function (a, b) { return (b.createdAt || 0) - (a.createdAt || 0); });
    return arr;
  }

  function listCooling() { return list('cooling'); }

  function get(id) {
    for (var i = 0; i < db.items.length; i++) {
      if (db.items[i].id === id) { return db.items[i]; }
    }
    return null;
  }

  /**
   * 冷静期进度。
   * @return {{remainingDays:number, elapsedDays:number, pct:number, overdue:boolean}}
   *   remainingDays 正数=还剩几天，0=今天到期，负数=已逾期
   */
  function progress(item, todayKey) {
    var it = (item && typeof item === 'object') ? item : {};
    var today = isDateKey(todayKey) ? todayKey : dateKey(new Date());
    var due = isDateKey(it.dueDate) ? it.dueDate : today;
    var start = isDateKey(it.startDate) ? it.startDate : today;
    var coolDays = Math.max(1, Math.round(num(it.coolDays) || COOL_DAYS_DEFAULT));
    var remainingDays = diffDays(today, due);
    var elapsedDays = diffDays(start, today);
    var pct = Math.round(elapsedDays / coolDays * 100);
    if (pct < 0) { pct = 0; }
    if (pct > 100) { pct = 100; }
    return {
      remainingDays: remainingDays,
      elapsedDays: elapsedDays,
      pct: pct,
      overdue: remainingDays < 0
    };
  }

  /** 已到期（dueDate <= 今天）且仍在冷静中的条目 */
  function dueItems(todayKey) {
    var today = isDateKey(todayKey) ? todayKey : dateKey(new Date());
    return listCooling().filter(function (it) { return it.dueDate <= today; });
  }

  /**
   * 做决策：bought（买了）/ dropped（算了不买了）。
   * 只有仍在 cooling 的条目能决策，重复决策返回 reason:'state'。
   * @param {string} id
   * @param {string} status bought|dropped
   * @param {{billId:string}} [opts] 成交时关联的账单 id
   */
  function decide(id, status, opts) {
    if (status !== 'bought' && status !== 'dropped') { return failResult('state'); }
    var it = get(id);
    if (!it || it.status !== 'cooling') { return failResult('state'); }
    var prevStatus = it.status;
    var prevAt = it.decidedAt;
    var prevBill = it.billId;
    it.status = status;
    it.decidedAt = Date.now();
    it.billId = (opts && typeof opts.billId === 'string') ? opts.billId : '';
    if (!save()) {
      it.status = prevStatus;
      it.decidedAt = prevAt;
      it.billId = prevBill;
      return failResult('store');
    }
    return { ok: true, item: it, reason: null };
  }

  /**
   * 再冷静几天。
   * @param {string} id
   * @param {number} [days] 默认 EXTEND_DAYS
   * @return {{ok:boolean, item:?Object, reason:?string}} reason: max|state|store
   */
  function extend(id, days) {
    var it = get(id);
    if (!it || it.status !== 'cooling') { return failResult('state'); }
    if (it.extendCount >= EXTEND_MAX) { return failResult('max'); }
    var n = Math.round(num(days));
    if (!(n > 0)) { n = EXTEND_DAYS; }
    var prevDue = it.dueDate;
    var prevCount = it.extendCount;
    it.dueDate = addDays(it.dueDate, n);
    it.extendCount = prevCount + 1;
    if (!save()) {
      it.dueDate = prevDue;
      it.extendCount = prevCount;
      return failResult('store');
    }
    return { ok: true, item: it, reason: null };
  }

  /**
   * 删除一条心愿（「清理痕迹」，不是决策 —— 状态机不变，只把条目拿掉）。
   * 冷静中的条目被删除后，调用方若已把金额计入「省下的钱」必须自己回退，
   * 所以返回被删掉的条目，让上层按 savedCounted 决定怎么冲账。
   * @param {string} id
   * @return {{ok:boolean, item:?Object, reason:?string}} reason: notfound|store
   */
  function remove(id) {
    if (typeof id !== 'string' || !id) { return { ok: false, item: null, reason: 'notfound' }; }
    var idx = -1;
    for (var i = 0; i < db.items.length; i++) {
      if (db.items[i].id === id) { idx = i; break; }
    }
    if (idx === -1) { return { ok: false, item: null, reason: 'notfound' }; }
    var removed = db.items.splice(idx, 1)[0];
    if (!save()) {
      db.items.splice(idx, 0, removed);
      return { ok: false, item: null, reason: 'store' };
    }
    return { ok: true, item: removed, reason: null };
  }

  /**
   * 汇总：省下的钱只算「已放弃 且 当初已计入 savedMoney」的那些，
   * 买了的（savedCounted 已在成交时回退）与手工加的一条都不算，避免双计。
   */  function stats() {
    var st = {
      cooling: 0, bought: 0, dropped: 0,
      coolingAmount: 0, droppedAmount: 0, boughtAmount: 0, savedAmount: 0
    };
    for (var i = 0; i < db.items.length; i++) {
      var it = db.items[i];
      var amount = round2(it.amount);
      if (it.status === 'cooling') {
        st.cooling++;
        st.coolingAmount = round2(st.coolingAmount + amount);
      } else if (it.status === 'bought') {
        st.bought++;
        st.boughtAmount = round2(st.boughtAmount + amount);
      } else if (it.status === 'dropped') {
        st.dropped++;
        st.droppedAmount = round2(st.droppedAmount + amount);
        if (it.savedCounted) { st.savedAmount = round2(st.savedAmount + amount); }
      }
    }
    return st;
  }

  var API = {
    KEY: KEY,
    VERSION: VERSION,
    MAX_ITEMS: MAX_ITEMS,
    COOL_DAYS_DEFAULT: COOL_DAYS_DEFAULT,
    EXTEND_MAX: EXTEND_MAX,
    EXTEND_DAYS: EXTEND_DAYS,

    isReady: function () { return ready && !!storage(); },
    load: load,
    reset: reset,

    add: add,
    list: list,
    listCooling: listCooling,
    get: get,
    progress: progress,
    dueItems: dueItems,
    decide: decide,
    extend: extend,
    remove: remove,
    stats: stats,

    dateKey: dateKey,
    addDays: addDays,
    /* 仅供单测：拿到内部存储对象，用于注入坏存档验证容错（生产代码请勿调用） */
    __store: storage
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.wishlist = API;
  }
})(typeof window !== 'undefined' ? window : this);

  </script>
  <!-- 消费诊断 + 周期末预测（纯函数，零存储；句子由 tone.js 拼） -->
<script>
/**
 * diagnose.js — 消费诊断规则集 + 周期末预测（纯函数，零存储、零文案）
 *
 * 定位：只回答「这个周期哪里花得不对」和「照这个节奏到期末会怎样」，
 *       产出结构化的**事实**（code / level / amount / ...），句子交给 app.js
 *       用 tone.js 拼 —— 这样换语气零成本、规则可单测、不碰既有文案断言。
 *
 * 边界：不读 localStorage、不写 state、不 import 任何东西；
 *       账单数组由调用方传入，缺字段一律当 0 / 空处理，绝不抛异常。
 *
 * 对外 API（window.AJ.diagnose）：
 *   forecast(o)     周期末预测 → {projected, remainingAtEnd, overBudgetBy, level, dailyAvg}
 *   build(o)        诊断规则 → 最多 3 条 [{code, level, amount, ...}]，已按严重度排序
 *   maxSeverity(l)  列表里的最高等级 → 'high'|'mid'|'low'|''
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);

  /* 分类的「必需 / 非必需」来自 data.js（本轮只给 CATEGORIES 追加了 essential），
     这里只读不写；拿不到 data.js 时 wantRatio 规则自动沉默，绝不自造一份分类表。 */
  var DATA = null;
  if (isNode) {
    try { DATA = require('./data.js'); } catch (e) { DATA = null; }
  } else if (global.AJ && global.AJ.data) {
    DATA = global.AJ.data;
  }

  /** 单次诊断最多给几条：3 条以外用户根本不看，还会把卡片撑长 */
  var MAX_ITEMS = 3;
  /** cycleUp 的触发门槛：环比涨 30% 才算「花快了」 */
  var UP_THRESHOLD = 0.3;
  /** 环比涨 80% 升级为 high */
  var UP_HIGH = 0.8;
  /** 非必需占比触发的金额下限（元）：几十块的非必需不值得一提 */
  var WANT_MIN_AMOUNT = 100;
  /** 非必需占比默认阈值（settings.alertRatio 未配置时用） */
  var DEFAULT_ALERT_RATIO = 0.8;
  /** 小额高频：笔数下限 */
  var SMALL_MIN_COUNT = 5;
  /** 小额阈值上下限（元） */
  var SMALL_MIN_THR = 10;
  var SMALL_MAX_THR = 100;

  function num(v) {
    var n = Number(v);
    return isFinite(n) ? n : 0;
  }

  /** 两位小数四舍五入（与 engine.round2 同口径，模块内自带以保持零依赖） */
  function round2(n) {
    var v = num(n);
    return Math.round(v * 100) / 100;
  }

  /* ------------------------------------------------------------------ */
  /* 周期末预测                                                          */
  /* ------------------------------------------------------------------ */

  /**
   * 「照这个节奏，期末会怎样」。
   * @param {{spent:number, passedDays:number, remainingDays:number, total:number}} o
   * @return {{projected:number, remainingAtEnd:number, overBudgetBy:number,
   *           level:string, dailyAvg:number}}
   *   level: over（已确定超支） / tight（结余不到两天的日均） / safe
   */
  function forecast(o) {
    var src = o || {};
    var spent = Math.max(0, round2(src.spent));
    var total = Math.max(0, round2(src.total));
    // 周期第一天时 passedDays 可能算成 0，除法会炸，兜底为 1
    var passedDays = Math.max(1, Math.round(num(src.passedDays)));
    var remainingDays = Math.max(0, Math.round(num(src.remainingDays)));

    var dailyAvg = round2(spent / passedDays);
    var projected = round2(spent + dailyAvg * remainingDays);
    var remainingAtEnd = round2(total - projected);
    var overBudgetBy = total > 0 ? round2(Math.max(0, projected - total)) : 0;

    var level;
    if (overBudgetBy > 0) {
      level = 'over';
    } else if (remainingAtEnd < dailyAvg * 2) {
      level = 'tight';
    } else {
      level = 'safe';
    }

    return {
      projected: projected,
      remainingAtEnd: remainingAtEnd,
      overBudgetBy: overBudgetBy,
      level: level,
      dailyAvg: dailyAvg
    };
  }

  /* ------------------------------------------------------------------ */
  /* 诊断规则                                                            */
  /* ------------------------------------------------------------------ */

  /** 非必需分类集合（从 data.js 现算，避免和 CATEGORIES 两处维护） */
  function nonEssentialMap() {
    var map = {};
    var cats = (DATA && Array.isArray(DATA.CATEGORIES)) ? DATA.CATEGORIES : [];
    for (var i = 0; i < cats.length; i++) {
      if (cats[i] && cats[i].essential === false && cats[i].key) {
        map[cats[i].key] = 1;
      }
    }
    return map;
  }

  /** 统一成一条诊断事实：缺的字段补默认值，下游不用做 null 判断 */
  function entry(code, level, amount, extra) {
    var e = {
      code: code,
      level: level,
      amount: round2(amount),
      count: 0,
      ratio: 0,
      category: '',
      days: 0,
      threshold: 0
    };
    var k;
    if (extra) {
      for (k in extra) {
        if (Object.prototype.hasOwnProperty.call(extra, k)) { e[k] = extra[k]; }
      }
    }
    return e;
  }

  /** 规则①：单日支出超上限（只统计 cycle.start..todayKey，未到日子不算） */
  function ruleDailyOver(dailyMap, start, endOfToday, cap) {
    if (!(cap > 0)) { return null; }
    var days = 0;
    var peak = 0;
    var k;
    for (k in dailyMap) {
      if (!Object.prototype.hasOwnProperty.call(dailyMap, k)) { continue; }
      if (k < start || k > endOfToday) { continue; }
      var sum = round2(dailyMap[k]);
      if (sum > cap) {
        days++;
        if (sum > peak) { peak = sum; }
      }
    }
    if (days < 1) { return null; }
    // 超了 3 天及以上说明是习惯问题，不是偶然
    return entry('dailyOver', days >= 3 ? 'high' : 'mid', peak, { days: days });
  }

  /** 规则②（原设计中的分类预算规则已随「分类预算上限」整块砍掉，不实现） */

  /** 规则③：非必需占比过高 */
  function ruleWantRatio(wantAmt, expense, alertRatio) {
    if (expense <= 0) { return null; }
    if (wantAmt <= WANT_MIN_AMOUNT) { return null; }
    var ratio = wantAmt / expense;
    if (ratio < alertRatio) { return null; }
    return entry('wantRatio', 'mid', wantAmt, { ratio: Math.round(ratio * 100) });
  }

  /** 规则④：环比上个周期涨得太快 */
  function ruleCycleUp(expense, prevExpense) {
    if (!(prevExpense > 0)) { return null; }
    var growth = (expense - prevExpense) / prevExpense;
    if (!(growth > UP_THRESHOLD)) { return null; }
    return entry('cycleUp', growth > UP_HIGH ? 'high' : 'mid', expense, {
      ratio: Math.round(growth * 100)
    });
  }

  /** 规则⑤：小额高频（奶茶 / 零食这种，单笔不起眼、加起来最贵） */
  function ruleSmallFreq(list, dailyAvg) {
    var thr = round2(Math.max(SMALL_MIN_THR, Math.min(dailyAvg * 0.5, SMALL_MAX_THR)));
    var count = 0;
    var sum = 0;
    var i;
    for (i = 0; i < list.length; i++) {
      var a = round2(list[i].amount);
      if (a <= 0 || a > thr) { continue; }
      count++;
      sum += a;
    }
    if (count < SMALL_MIN_COUNT) { return null; }
    return entry('smallFreq', 'mid', sum, { count: count, threshold: thr });
  }

  var LEVEL_WEIGHT = { high: 3, mid: 2, low: 1 };

  /**
   * 消费诊断主入口。
   * @param {{bills:Array, cycle:{start:string,end:string,passedDays:number,remainingDays:number},
   *          prevExpense:number, settings:{dailyCap:number, alertRatio:number},
   *          todayKey:string}} o
   * @return {Array<{code:string, level:string, amount:number, count:number, ratio:number,
   *                 category:string, days:number, threshold:number}>}
   */
  function build(o) {
    var src = o || {};
    var bills = Array.isArray(src.bills) ? src.bills : [];
    var cycle = src.cycle || {};
    var settings = src.settings || {};
    var start = (typeof cycle.start === 'string') ? cycle.start : '';
    var end = (typeof cycle.end === 'string') ? cycle.end : '';
    var todayKey = (typeof src.todayKey === 'string' && src.todayKey) ? src.todayKey : end;
    // 今天已超出周期末时，按周期末截断（历史周期回看时不会把未来的账算进来）
    if (end && todayKey > end) { todayKey = end; }

    var expense = 0;
    var wantAmt = 0;
    var dailyMap = {};
    var inCycle = [];
    var nonEssential = nonEssentialMap();
    var i;

    for (i = 0; i < bills.length; i++) {
      var b = bills[i];
      if (!b || typeof b !== 'object') { continue; }
      if (b.type === 'income') { continue; }
      var date = (typeof b.date === 'string') ? b.date : '';
      if (!date) { continue; }
      if (start && date < start) { continue; }
      if (end && date > end) { continue; }
      var amount = round2(b.amount);
      if (amount <= 0) { continue; }
      inCycle.push(b);
      expense = round2(expense + amount);
      dailyMap[date] = round2(num(dailyMap[date]) + amount);
      if (nonEssential[b.category]) { wantAmt = round2(wantAmt + amount); }
    }

    if (expense <= 0) { return []; }

    var passedDays = Math.max(1, Math.round(num(cycle.passedDays)));
    var dailyAvg = round2(expense / passedDays);
    var alertRatio = num(settings.alertRatio);
    if (alertRatio <= 0 || alertRatio > 1) { alertRatio = DEFAULT_ALERT_RATIO; }

    var list = [];
    var r;
    r = ruleDailyOver(dailyMap, start, todayKey, num(settings.dailyCap));
    if (r) { list.push(r); }
    r = ruleWantRatio(wantAmt, expense, alertRatio);
    if (r) { list.push(r); }
    r = ruleCycleUp(expense, num(src.prevExpense));
    if (r) { list.push(r); }
    r = ruleSmallFreq(inCycle, dailyAvg);
    if (r) { list.push(r); }

    // 严重度优先，同级按金额降序（钱多的那条更值得先看）
    list.sort(function (a, b) {
      var wa = LEVEL_WEIGHT[a.level] || 0;
      var wb = LEVEL_WEIGHT[b.level] || 0;
      if (wa !== wb) { return wb - wa; }
      return b.amount - a.amount;
    });
    return list.slice(0, MAX_ITEMS);
  }

  /**
   * 列表里的最高严重度。
   * @param {Array} list build() 的结果
   * @return {string} 'high' | 'mid' | 'low' | ''
   */
  function maxSeverity(list) {
    var arr = Array.isArray(list) ? list : [];
    var best = '';
    var bestW = 0;
    for (var i = 0; i < arr.length; i++) {
      var w = LEVEL_WEIGHT[arr[i] && arr[i].level] || 0;
      if (w > bestW) {
        bestW = w;
        best = arr[i].level;
      }
    }
    return best;
  }

  var API = {
    MAX_ITEMS: MAX_ITEMS,
    forecast: forecast,
    build: build,
    maxSeverity: maxSeverity
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.diagnose = API;
  }
})(typeof window !== 'undefined' ? window : this);

  </script>
<script>
/**
 * analysis.js — 账单导入分析（支付宝 / 微信 / 银行 CSV）
 *
 * 全局命名空间：window.AJ.analysis
 * Node 单测：require('./analysis.js')
 *
 * 纯函数，无 DOM / 无网络依赖。负责：
 *   ① 字节解码（UTF-8 严格 → GBK 兜底）
 *   ② CSV 状态机解析（正确处理引号内逗号与转义双引号）
 *   ③ 表头模糊定位（跳过导出文件顶部的多行说明）
 *   ④ 列映射、金额清洗、收支方向判定、分类映射、去重
 *   ⑤ 9 节报告 report(rows, opts) / 建议 insights(report, budgetState) / Markdown 导出
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);
  var DATA;
  var NLP;
  var ENG;

  if (isNode) {
    DATA = require('./data.js');
    NLP = require('./nlp.js');
    ENG = require('./engine.js');
  } else {
    global.AJ = global.AJ || {};
    DATA = global.AJ.data;
    NLP = global.AJ.nlp;
    ENG = global.AJ.engine;
  }

  var MS_PER_DAY = 24 * 60 * 60 * 1000;
  var INCOME_CATEGORY = DATA.INCOME_CATEGORY || '收入';

  /* ================================================================== */
  /* 基础工具                                                            */
  /* ================================================================== */

  function pad2(n) {
    return n < 10 ? '0' + n : '' + n;
  }

  function round2(n) {
    var v = Number(n);
    if (!isFinite(v)) { return 0; }
    return Math.round((v + Number.EPSILON) * 100) / 100;
  }

  /** 统一金额展示：¥1,234.50 */
  function money(n) {
    var v = round2(n);
    var neg = v < 0;
    var s = Math.abs(v).toFixed(2).split('.');
    s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return (neg ? '-¥' : '¥') + s[0] + '.' + s[1];
  }

  /** 百分比展示：43.2% */
  function percent(n, digits) {
    var v = Number(n);
    if (!isFinite(v)) { return '—'; }
    return v.toFixed(typeof digits === 'number' ? digits : 1) + '%';
  }

  function num(v) {
    var n = Number(v);
    return isFinite(n) ? n : 0;
  }

  function sum(arr, pick) {
    var total = 0;
    var i;
    for (i = 0; i < arr.length; i++) {
      total += num(pick ? pick(arr[i]) : arr[i]);
    }
    return round2(total);
  }

  function toDate(value) {
    if (value instanceof Date) {
      return new Date(value.getFullYear(), value.getMonth(), value.getDate());
    }
    if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}/.test(value)) {
      var p = value.slice(0, 10).split('-');
      return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
    }
    return new Date(value === undefined || value === null ? Date.now() : value);
  }

  function formatDate(date) {
    var d = toDate(date);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  function currentMonth() {
    return formatDate(new Date()).slice(0, 7);
  }

  function monthKeyOf(dateStr) {
    return String(dateStr || '').slice(0, 7);
  }

  /** month 'YYYY-MM' 平移 delta 个月 */
  function shiftMonth(month, delta) {
    var p = String(month || currentMonth()).split('-');
    var y = Number(p[0]);
    var m = Number(p[1]) - 1;
    var d = new Date(y, m + (delta || 0), 1);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1);
  }

  /** 该月天数 */
  function daysInMonth(month) {
    var p = String(month || currentMonth()).split('-');
    return new Date(Number(p[0]), Number(p[1]), 0).getDate();
  }

  /** 0=周日 … 6=周六 */
  function weekdayOf(dateStr) {
    return toDate(dateStr).getDay();
  }

  function isWeekend(dateStr) {
    var w = weekdayOf(dateStr);
    return w === 0 || w === 6;
  }

  /* ================================================================== */
  /* ① 解码                                                              */
  /* ================================================================== */

  function toBytes(input) {
    if (!input) { return null; }
    if (typeof input === 'string') { return null; }
    if (typeof Uint8Array !== 'undefined' && input instanceof Uint8Array) { return input; }
    if (typeof ArrayBuffer !== 'undefined' && input instanceof ArrayBuffer) {
      return new Uint8Array(input);
    }
    if (input && input.buffer && typeof input.byteLength === 'number') {
      return new Uint8Array(input.buffer, input.byteOffset || 0, input.byteLength);
    }
    return null;
  }

  var GARBLED_REASON = '无法识别文件编码';

  /**
   * 判断解码结果是否「全是乱码」。
   * TextDecoder('gbk') 对任意字节都不会抛错，因此必须用替换字符与不可见控制字符
   * 的占比来判断：超过 30% 视为不是文本文件（PDF / xlsx / 二进制）。
   * @param {string} text
   * @return {boolean}
   */
  function isGarbled(text) {
    var s = String(text === undefined || text === null ? '' : text);
    var len = s.length;
    if (len === 0) { return false; }
    var bad = 0;
    var i;
    for (i = 0; i < len; i++) {
      var code = s.charCodeAt(i);
      if (code === 0xFFFD) { bad++; continue; }
      if (code === 0x09 || code === 0x0A || code === 0x0D) { continue; }
      if (code < 0x20) { bad++; continue; }
      if (code >= 0x7F && code <= 0xA0) { bad++; }
    }
    return (bad / len) > 0.3;
  }

  /** 取文本前 n 个非空行（用于解析失败时的诊断预览） */
  function firstLines(text, n) {
    var arr = String(text === undefined || text === null ? '' : text)
      .split('\n')
      .map(function (l) { return String(l || '').replace(/\r$/, ''); })
      .filter(function (l) { return l.trim().length > 0; });
    return arr.slice(0, n || 4).join('\n');
  }

  /** 粗略判断一段字节是否像是 PDF / Excel 等二进制（不是文本 CSV） */
  function looksBinary(bytes) {
    if (!bytes) { return false; }
    var b = toBytes(bytes);
    if (!b) { return false; }
    var len = Math.min(b.length, 512);
    var i;
    // PDF 以 %PDF 开头
    if (b.length >= 4 && b[0] === 0x25 && b[1] === 0x50 && b[2] === 0x44 && b[3] === 0x46) {
      return true;
    }
    // 大量 NUL 字节（xlsx/zip 等）视为二进制
    var nul = 0;
    for (i = 0; i < len; i++) { if (b[i] === 0x00) { nul += 1; } }
    return len > 0 && (nul / len) > 0.05;
  }

  /**
   * 字节 → 文本。先按 UTF-8 严格解码（fatal），失败再用 GBK/GB18030 兜底。
   * 每次解码后都做乱码校验，避免把二进制文件当 GBK 硬解成一大段乱码。
   * @param {ArrayBuffer|Uint8Array} input
   * @return {{ok:boolean, text:string, encoding:string, reason:string}}
   */
  function decodeBytes(input) {
    var bytes = toBytes(input);
    if (!bytes) {
      return { ok: false, text: '', encoding: '', reason: GARBLED_REASON };
    }
    var hasTextDecoder = (typeof TextDecoder !== 'undefined');
    if (!hasTextDecoder) {
      return { ok: false, text: '', encoding: '', reason: '当前浏览器不支持 TextDecoder，无法解析文件' };
    }

    var text = null;
    var encoding = '';
    try {
      var utf8 = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
      if (!isGarbled(utf8)) {
        text = utf8;
        encoding = 'utf-8';
      }
    } catch (e1) {
      text = null;
    }
    if (text === null) {
      var charsets = ['gbk', 'gb18030', 'big5'];
      var i;
      for (i = 0; i < charsets.length; i++) {
        var candidate = null;
        try {
          // gbk 解码不会抛错，只要浏览器实现支持该编码即可
          candidate = new TextDecoder(charsets[i]).decode(bytes);
        } catch (e2) {
          candidate = null;
        }
        if (candidate === null || isGarbled(candidate)) { continue; }
        text = candidate;
        encoding = charsets[i];
        break;
      }
    }
    if (text === null || typeof text !== 'string') {
      return { ok: false, text: '', encoding: '', reason: GARBLED_REASON };
    }
    if (text.charCodeAt(0) === 0xFEFF) { text = text.slice(1); }
    // 某些 GBK 实现会把不认识的字节解成 U+FFFD，这里顺手规整一下换行
    return { ok: true, text: text.replace(/\r\n?/g, '\n'), encoding: encoding, reason: '' };
  }

  /* ================================================================== */
  /* ② CSV 解析（逐字符状态机）                                          */
  /* ================================================================== */

  /**
   * 检测分隔符：前 30 行里逗号 / 制表符 / 分号谁多就用谁。
   * @param {string} text
   * @return {string}
   */
  function detectDelimiter(text) {
    var lines = String(text || '').split('\n').slice(0, 30);
    var counts = { ',': 0, '\t': 0, ';': 0 };
    var i;
    var j;
    for (i = 0; i < lines.length; i++) {
      var line = lines[i];
      var inQuotes = false;
      for (j = 0; j < line.length; j++) {
        var ch = line.charAt(j);
        if (ch === '"') { inQuotes = !inQuotes; continue; }
        if (inQuotes) { continue; }
        if (Object.prototype.hasOwnProperty.call(counts, ch)) { counts[ch]++; }
      }
    }
    var best = ',';
    var bestCount = counts[','];
    if (counts['\t'] > bestCount) { best = '\t'; bestCount = counts['\t']; }
    if (counts[';'] > bestCount) { best = ';'; }
    return best;
  }

  /**
   * CSV / TSV 解析（支持双引号包裹、字段内逗号、"" 转义）。
   * @param {string} text
   * @param {string} [delimiter] 默认自动检测
   * @return {string[][]}
   */
  function parseDelimited(text, delimiter) {
    var src = String(text === undefined || text === null ? '' : text);
    if (src.charCodeAt(0) === 0xFEFF) { src = src.slice(1); }
    var delim = delimiter || detectDelimiter(src);
    var rows = [];
    var row = [];
    var field = '';
    var inQuotes = false;
    var i = 0;

    while (i < src.length) {
      var ch = src.charAt(i);
      if (inQuotes) {
        if (ch === '"') {
          if (src.charAt(i + 1) === '"') {
            field += '"';
            i += 2;
            continue;
          }
          inQuotes = false;
          i += 1;
          continue;
        }
        field += ch;
        i += 1;
        continue;
      }
      if (ch === '"') {
        inQuotes = true;
        i += 1;
        continue;
      }
      if (ch === delim) {
        row.push(field);
        field = '';
        i += 1;
        continue;
      }
      if (ch === '\r') {
        i += 1;
        continue;
      }
      if (ch === '\n') {
        row.push(field);
        rows.push(row);
        row = [];
        field = '';
        i += 1;
        continue;
      }
      field += ch;
      i += 1;
    }
    if (field !== '' || row.length > 0) {
      row.push(field);
      rows.push(row);
    }
    return rows;
  }

  /** 兼容旧调用名 */
  function parseCsv(text, delimiter) {
    return parseDelimited(text, delimiter);
  }

  /* ================================================================== */
  /* ③ 表头识别                                                          */
  /* ================================================================== */

  /** 全半角归一 + 去空格 + 去括号 + 小写 */
  function normHeader(value) {
    var s = String(value === undefined || value === null ? '' : value);
    s = s.replace(/[\uFF01-\uFF5E]/g, function (c) {
      return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
    });
    s = s.replace(/[\s\u3000]/g, '');
    s = s.replace(/[()\[\]{}（）【】「」<>《》]/g, '');
    return s.toLowerCase();
  }

  /**
   * 列名字典。weight 越大越优先（同一列可能有多个别名命中，例如「金额(元)」同时命中「金额」）。
   * 顺序：时间 / 金额 / 收支 / 对方 / 说明 / 分类。
   */
  var FIELD_ALIASES = [
    { field: 'time', alias: '交易时间', weight: 100 },
    { field: 'time', alias: '交易创建时间', weight: 100 },
    { field: 'time', alias: '交易发生时间', weight: 100 },
    { field: 'time', alias: '记账日期', weight: 100 },
    { field: 'time', alias: '交易日期', weight: 100 },
    { field: 'time', alias: '付款时间', weight: 96 },
    { field: 'time', alias: '时间', weight: 70 },
    { field: 'time', alias: '日期', weight: 60 },

    { field: 'amount', alias: '交易金额', weight: 100 },
    { field: 'amount', alias: '金额元', weight: 98 },
    { field: 'amount', alias: '本次金额', weight: 94 },
    { field: 'amount', alias: '订单金额', weight: 88 },
    { field: 'amount', alias: '发生额', weight: 80 },
    { field: 'amount', alias: '金额', weight: 70 },

    /* 银行 / 部分支付宝导出会把收与支拆成两列：借方=支出，贷方=收入 */
    { field: 'amountDebit', alias: '借方发生额', weight: 100 },
    { field: 'amountDebit', alias: '支出金额', weight: 96 },
    { field: 'amountDebit', alias: '借方金额', weight: 96 },
    { field: 'amountCredit', alias: '贷方发生额', weight: 100 },
    { field: 'amountCredit', alias: '收入金额', weight: 96 },
    { field: 'amountCredit', alias: '贷方金额', weight: 96 },

    { field: 'direction', alias: '收/支', weight: 100 },
    { field: 'direction', alias: '收支', weight: 100 },
    { field: 'direction', alias: '借贷标志', weight: 92 },
    { field: 'direction', alias: '资金方向', weight: 90 },
    { field: 'direction', alias: '方向', weight: 80 },
    { field: 'direction', alias: '交易类型', weight: 30 },

    { field: 'counterparty', alias: '交易对方', weight: 100 },
    { field: 'counterparty', alias: '对方户名', weight: 100 },
    { field: 'counterparty', alias: '商户名称', weight: 96 },
    { field: 'counterparty', alias: '收款方', weight: 92 },
    { field: 'counterparty', alias: '付款方', weight: 86 },
    { field: 'counterparty', alias: '交易对象', weight: 84 },
    { field: 'counterparty', alias: '对方', weight: 70 },
    { field: 'counterparty', alias: '商户', weight: 60 },

    /* 说明列：微信导出的「商品」几乎总有值，而「备注」普遍为空，
       所以「商品 / 摘要」系列权重必须高于「备注」，同时保留「备注」做兜底。 */
    { field: 'desc', alias: '商品说明', weight: 100 },
    { field: 'desc', alias: '商品名称', weight: 98 },
    { field: 'desc', alias: '交易说明', weight: 96 },
    { field: 'desc', alias: '商品', weight: 96 },
    { field: 'desc', alias: '摘要', weight: 96 },
    { field: 'desc', alias: '交易摘要', weight: 94 },
    { field: 'desc', alias: '备注', weight: 80 },
    { field: 'desc', alias: '用途', weight: 70 },

    { field: 'category', alias: '交易分类', weight: 100 },
    { field: 'category', alias: '账单分类', weight: 96 },
    { field: 'category', alias: '分类', weight: 70 }
  ];

  /**
   * 给一列表头单元格（已 split）做列映射。
   * 收支列可能有多列命中（如同时有「交易类型」与「收/支」），全部保留并按权重排序；
   * 说明列同理保留成 descList —— 真实微信账单里「备注」常整列为空，
   * 需要按分数依次回退到「商品」，否则会丢掉「转账给李四」这类关键文字。
   * @param {string[]} cells
   * @return {{time:?Object, amount:?Object, amountDebit:?Object, amountCredit:?Object,
   *           direction:Object[], descList:Object[], counterparty:?Object,
   *           desc:?Object, category:?Object}}
   */
  function mapColumns(cells) {
    var cols = {
      time: null,
      amount: null,
      amountDebit: null,
      amountCredit: null,
      direction: [],
      descList: [],
      counterparty: null,
      desc: null,
      category: null
    };
    var i;
    var j;
    var list = Array.isArray(cells) ? cells : [];
    for (i = 0; i < list.length; i++) {
      var header = String(list[i] === undefined || list[i] === null ? '' : list[i]);
      var norm = normHeader(header);
      if (!norm) { continue; }
      for (j = 0; j < FIELD_ALIASES.length; j++) {
        var def = FIELD_ALIASES[j];
        if (norm.indexOf(normHeader(def.alias)) === -1) { continue; }
        var cand = {
          index: i,
          score: def.weight * 1000 + def.alias.length,
          alias: def.alias,
          header: header.trim()
        };
        if (def.field === 'direction') {
          cols.direction.push(cand);
        } else if (def.field === 'desc') {
          var dup = false;
          var di;
          for (di = 0; di < cols.descList.length; di++) {
            if (cols.descList[di].index === i) {
              dup = true;
              if (cand.score > cols.descList[di].score) { cols.descList[di] = cand; }
              break;
            }
          }
          if (!dup) { cols.descList.push(cand); }
          if (!cols.desc || cand.score > cols.desc.score) { cols.desc = cand; }
        } else if (!cols[def.field] || cand.score > cols[def.field].score) {
          cols[def.field] = cand;
        }
      }
    }
    cols.direction.sort(function (a, b) { return b.score - a.score; });
    cols.descList.sort(function (a, b) { return b.score - a.score; });
    return cols;
  }

  /**
   * 是否识别到可用的金额列（单列 或 借方/贷方双列之一）。
   * @param {Object} cols mapColumns() 结果
   * @return {boolean}
   */
  function hasAmountColumn(cols) {
    if (!cols) { return false; }
    return !!(cols.amount || cols.amountDebit || cols.amountCredit);
  }

  /**
   * 扫描前 30 行，找同时含「时间列」与「金额列」的那一行作为表头。
   * @param {string[][]} rows
   * @return {?{index:number, columns:Object, score:number}}
   */
  function detectHeader(rows) {
    var list = Array.isArray(rows) ? rows : [];
    var limit = Math.min(list.length, 30);
    var best = null;
    var i;
    for (i = 0; i < limit; i++) {
      var cols = mapColumns(list[i]);
      if (!cols.time || !hasAmountColumn(cols)) { continue; }
      var score = 0;
      if (cols.time) { score += cols.time.score; }
      if (cols.amount) { score += cols.amount.score; }
      if (cols.amountDebit) { score += cols.amountDebit.score; }
      if (cols.amountCredit) { score += cols.amountCredit.score; }
      if (cols.direction.length > 0) { score += 50; }
      if (cols.counterparty) { score += 40; }
      if (cols.desc) { score += 30; }
      if (cols.category) { score += 20; }
      if (!best || score > best.score) {
        best = { index: i, columns: cols, score: score };
      }
    }
    return best;
  }

  /* ================================================================== */
  /* ④ 记录解析                                                          */
  /* ================================================================== */

  /**
   * 日期时间解析，兼容：
   *   2025-10-21 12:30:05 / 2025/10/21 / 2025年10月21日 / 10-21 12:30 / 20251021
   * @param {string} raw
   * @param {Date} [now] 补年份用
   * @return {?{date:string, time:string, month:string}}
   */
  function parseDateTime(raw, now) {
    var s = String(raw === undefined || raw === null ? '' : raw).trim();
    if (!s) { return null; }
    var base = now ? toDate(now) : new Date();
    var year = 0;
    var month = 0;
    var day = 0;

    var m = s.match(/(\d{4})\s*[-/年.]\s*(\d{1,2})\s*[-/月.]\s*(\d{1,2})/);
    if (m) {
      year = Number(m[1]);
      month = Number(m[2]);
      day = Number(m[3]);
    } else {
      var compact = s.match(/(\d{4})(\d{2})(\d{2})/);
      if (compact) {
        year = Number(compact[1]);
        month = Number(compact[2]);
        day = Number(compact[3]);
      } else {
        var short = s.match(/(\d{1,2})\s*[-/月]\s*(\d{1,2})/);
        if (short) {
          year = base.getFullYear();
          month = Number(short[1]);
          day = Number(short[2]);
        }
      }
    }
    if (!year || month < 1 || month > 12 || day < 1 || day > 31) { return null; }

    var time = '';
    var tm = s.match(/(\d{1,2}):(\d{2})(?::(\d{2}))?/);
    if (tm) {
      time = pad2(Number(tm[1])) + ':' + tm[2];
    }
    var date = year + '-' + pad2(month) + '-' + pad2(day);
    return { date: date, time: time, month: date.slice(0, 7) };
  }

  /**
   * 金额清洗：去掉 ¥ ￥ , " 空格；处理 -12.00 / (12.00) 负数写法。
   * @param {string} raw
   * @return {?{value:number, negative:boolean}}
   */
  function cleanAmount(raw) {
    var s = String(raw === undefined || raw === null ? '' : raw).trim();
    if (!s) { return null; }
    s = s.replace(/[¥￥$,\s"]/g, '');
    if (!s) { return null; }
    var negative = false;
    if (/^\(.*\)$/.test(s)) {
      negative = true;
      s = s.slice(1, -1);
    }
    if (s.charAt(0) === '-') {
      negative = true;
      s = s.slice(1);
    } else if (s.charAt(0) === '+') {
      s = s.slice(1);
    }
    // 去掉「元」等尾巴
    s = s.replace(/元$/, '');
    if (!/^\d+(\.\d+)?$/.test(s)) { return null; }
    var value = Number(s);
    if (!isFinite(value) || value <= 0) { return null; }
    return { value: round2(value), negative: negative };
  }

  /**
   * 收支方向文本归一。
   * 「不计收支 / 不计入收支」是微信转账行的标准写法，必须单独识别为 excluded，
   * 否则会落到兜底的 expense，把转账算成消费。
   * @param {string} raw
   * @return {string} 'income' | 'expense' | 'excluded' | ''
   */
  function normalizeDirection(raw) {
    var s = String(raw === undefined || raw === null ? '' : raw).replace(/\s/g, '');
    if (!s) { return ''; }
    if (s === '/' || s === '-' || s === '—' || s === '--') { return ''; }
    if (/^(不计收支|不计入收支|不计入|不计)/.test(s)) { return 'excluded'; }
    if (/^(收入|收|贷|入账|存入|转入|退款|收款)/.test(s)) { return 'income'; }
    if (/^(支出|支|借|出账|转出|付款|消费)/.test(s)) { return 'expense'; }
    return '';
  }

  /**
   * 「提现 / 还款 / 借贷」类：无论收支方向，永远不计入收支统计。
   * 这里**只认完整词**，刻意不走 BILL_EXCLUDED_CATEGORIES（那份列表含「转账」，
   * 会让「交易类型=转账 + 收/支=收入」的生活费被误排掉），也不用裸「借」「贷」
   * 二字，避免把「借贷宝超市」这类商户名误杀。
   * @param {string} text
   * @return {boolean}
   */
  function isWithdrawOrRepay(text) {
    var s = String(text === undefined || text === null ? '' : text);
    if (!s) { return false; }
    if (/提现/.test(s)) { return true; }
    if (/还款|信用卡还|还花呗/.test(s)) { return true; }
    if (/投资理财|理财赎回/.test(s)) { return true; }
    if (/借贷/.test(s)) { return true; }
    return false;
  }

  /**
   * 「转账 / 汇款」类文字。用于两处：支出方向 → 不计入消费；收入方向 → 记为转账型收入。
   * @param {string} text
   * @return {boolean}
   */
  function isTransferText(text) {
    var s = String(text === undefined || text === null ? '' : text);
    if (!s) { return false; }
    return /转账|转入|转出|汇款/.test(s);
  }

  /**
   * @deprecated 保留给旧调用；新代码请用 isWithdrawOrRepay / isTransferText
   * @param {string} text
   * @return {boolean}
   */
  function looksExcluded(text) {
    return isWithdrawOrRepay(text) || isTransferText(text);
  }

  /** 分类映射：14 → 应用内 9 类；未命中回退 nlp.classify() */
  function resolveCategory(rawCategory, text, type) {
    var map = DATA.BILL_CATEGORY_MAP || {};
    var excludedList = DATA.BILL_EXCLUDED_CATEGORIES || [];
    var raw = String(rawCategory === undefined || rawCategory === null ? '' : rawCategory).replace(/\s/g, '');
    var keys = Object.keys(map).sort(function (a, b) { return b.length - a.length; });
    var hit = '';
    var i;

    for (i = 0; i < keys.length; i++) {
      if (raw && raw.indexOf(keys[i]) !== -1) {
        hit = keys[i];
        break;
      }
    }

    /* 先判「转账 / 还款」——即使是收入方向，也不能算进收支统计 */
    var excluded = false;
    if (hit && excludedList.indexOf(hit) !== -1) { excluded = true; }
    if (raw && excludedList.indexOf(raw) !== -1) { excluded = true; }
    if (!excluded && /转账|还款|信用还款|提现/.test(raw)) { excluded = true; }
    if (!excluded && /转账给|给.{0,6}转账|还花呗|还款/.test(text)) { excluded = true; }
    if (excluded) {
      return { category: '其他', excluded: true };
    }

    if (type === 'income') {
      return { category: INCOME_CATEGORY, excluded: false };
    }

    var category = hit ? map[hit] : '';
    if (!category || category === INCOME_CATEGORY) { category = ''; }
    if (!category) {
      var guessed = (NLP && typeof NLP.classify === 'function') ? NLP.classify(text) : '其他';
      category = DATA.CATEGORY_KEYS.indexOf(guessed) !== -1 ? guessed : '其他';
    }
    return { category: category, excluded: false };
  }

  /**
   * 解析单个文件。
   * @param {{name:string, text?:string, bytes?:ArrayBuffer|Uint8Array, encoding?:string}} file
   * @param {{now?:Date}} [opts]
   * @return {Object} 文件解析结果（含 records / headerRow / skipped / columns）
   */
  function parseFile(file, opts) {
    var o = opts || {};
    var name = (file && file.name) ? String(file.name) : '未命名.csv';
    var result = {
      name: name,
      ok: false,
      reason: '',
      encoding: '',
      headerRow: 0,
      totalRows: 0,
      records: [],
      skipped: 0,
      skippedBefore: 0,
      transferIncomeCount: 0,
      columns: {},
      columnNames: {},
      delimiter: ','
    };

    var text = '';
    if (file && typeof file.text === 'string') {
      text = file.text;
      result.encoding = file.encoding || 'text';
    } else if (file && file.bytes) {
      if (looksBinary(file.bytes)) {
        result.reason = '这看起来是 PDF / Excel 等二进制文件，不是 CSV 文本。请在微信/支付宝里重新导出：选「CSV（用做个人对账）」格式，再导入。';
        return result;
      }
      var dec = decodeBytes(file.bytes);
      if (!dec.ok) {
        result.reason = dec.reason || '无法识别文件编码';
        return result;
      }
      text = dec.text;
      result.encoding = dec.encoding;
    } else {
      result.reason = '文件内容为空';
      return result;
    }

    if (!text.trim()) {
      result.reason = '文件内容为空';
      return result;
    }

    result.preview = firstLines(text, 4);

    var rows = parseDelimited(text);
    result.delimiter = detectDelimiter(text);
    result.totalRows = rows.length;

    var header = detectHeader(rows);
    if (!header) {
      result.reason = '没有找到表头：需要同时包含「时间」类列与「金额」类列';
      return result;
    }
    var cols = header.columns;
    var dualAmount = !!(cols.amountDebit || cols.amountCredit);
    result.headerRow = header.index + 1;

    var amountHeaderText = '';
    if (dualAmount) {
      /* amount 保留「主金额列」的表头文本（借方优先），双列信息另有独立字段 */
      amountHeaderText = (cols.amountDebit ? cols.amountDebit.header : '') ||
        (cols.amountCredit ? cols.amountCredit.header : '');
    } else if (cols.amount) {
      amountHeaderText = cols.amount.header;
    }
    result.columns = {
      time: cols.time ? cols.time.header : '',
      amount: amountHeaderText,
      amountDebit: cols.amountDebit ? cols.amountDebit.header : '',
      amountCredit: cols.amountCredit ? cols.amountCredit.header : '',
      direction: cols.direction.length ? cols.direction[0].header : '',
      counterparty: cols.counterparty ? cols.counterparty.header : '',
      desc: cols.desc ? cols.desc.header : '',
      category: cols.category ? cols.category.header : ''
    };

    /* 单金额列的「借 / 贷」语义要基于真实命中的表头文本判断，
       不能拿常量别名去 indexOf，否则「贷方发生额」这类列永远判不出来。 */
    var amountKind = '';
    if (!dualAmount && cols.amount) {
      var amtNorm = normHeader(cols.amount.header);
      if (amtNorm.indexOf('借方') !== -1 || amtNorm.indexOf('支出') !== -1 ||
          amtNorm.indexOf('付款') !== -1 || amtNorm.indexOf('转出') !== -1) {
        amountKind = 'debit';
      } else if (amtNorm.indexOf('贷方') !== -1 || amtNorm.indexOf('收入') !== -1 ||
          amtNorm.indexOf('存入') !== -1 || amtNorm.indexOf('转入') !== -1) {
        amountKind = 'credit';
      }
    }

    var i;
    var skipped = 0;
    var transferIncomeCount = 0;
    var timeIndex = cols.time.index;
    var amountIndex = cols.amount ? cols.amount.index : -1;
    var debitIndex = cols.amountDebit ? cols.amountDebit.index : -1;
    var creditIndex = cols.amountCredit ? cols.amountCredit.index : -1;

    for (i = header.index + 1; i < rows.length; i++) {
      var cells = rows[i];
      if (!cells || cells.length === 0) { skipped++; continue; }
      var joined = cells.join('').replace(/\s/g, '');
      if (!joined) { skipped++; continue; }

      var dt = parseDateTime(cells[timeIndex], o.now);
      if (!dt) { skipped++; continue; }

      /* ---- 金额：借方 / 贷方双列优先，单列兜底 ---- */
      var amt = null;
      var dualType = '';
      var amountConflict = false;
      if (debitIndex >= 0 || creditIndex >= 0) {
        var debitAmt = debitIndex >= 0 ? cleanAmount(cells[debitIndex]) : null;
        var creditAmt = creditIndex >= 0 ? cleanAmount(cells[creditIndex]) : null;
        if (debitAmt && creditAmt) {
          // 两列同时有值：取绝对值较大者，并打上冲突标记供 UI 提示
          amountConflict = true;
          if (debitAmt.value >= creditAmt.value) {
            amt = debitAmt;
            dualType = 'expense';
          } else {
            amt = creditAmt;
            dualType = 'income';
          }
        } else if (debitAmt) {
          amt = debitAmt;
          dualType = 'expense';
        } else if (creditAmt) {
          amt = creditAmt;
          dualType = 'income';
        }
      }
      if (!amt && amountIndex >= 0) { amt = cleanAmount(cells[amountIndex]); }
      if (!amt) { skipped++; continue; }

      /* ---- 收支方向：取第一个能识别的方向列，同时把其余列文本留作排除判断 ---- */
      var direction = '';
      var typeColText = '';
      var d;
      for (d = 0; d < cols.direction.length; d++) {
        var dRaw = cells[cols.direction[d].index];
        var dText = String(dRaw === undefined || dRaw === null ? '' : dRaw).trim();
        if (!dText) { continue; }
        typeColText += ' ' + dText;
        var dir = normalizeDirection(dText);
        if (dir && !direction) { direction = dir; }
      }

      var type;
      if (direction === 'excluded') {
        // 「不计收支」的转账行：金额仍在，但不能进任何合计
        type = 'expense';
      } else if (direction) {
        type = direction;
      } else if (dualType) {
        type = dualType;
      } else if (amt.negative) {
        type = 'expense';
      } else if (amountKind === 'debit') {
        type = 'expense';
      } else if (amountKind === 'credit') {
        type = 'income';
      } else {
        // 既没有收支列、金额也是正数：优先按支出理解（消费分析为主，避免虚增收入）
        type = 'expense';
      }

      var counterparty = cols.counterparty
        ? String(cells[cols.counterparty.index] || '').trim() : '';

      /* 说明列按分数依次回退：备注为空时自动落到「商品」，两列都有值时优先高分列 */
      var desc = '';
      var dl;
      for (dl = 0; dl < cols.descList.length; dl++) {
        var dCell = cells[cols.descList[dl].index];
        var dVal = String(dCell === undefined || dCell === null ? '' : dCell).trim();
        if (dVal) { desc = dVal; break; }
      }

      var rawCategory = cols.category
        ? String(cells[cols.category.index] || '').trim() : '';

      var mapText = (counterparty + ' ' + desc + ' ' + rawCategory + ' ' + typeColText).trim();
      var resolved = resolveCategory(rawCategory, mapText, type);

      /* ---- 是否计入收支 ----
         优先级（顺序不能换）：
           ① 「不计收支」显式排除 → 永远 excluded
           ② 提现 / 还款 / 借贷 → 永远 excluded（收入方向也不算收入）
           ③ 收入方向 → 计入收入；即使「交易类型=转账」也照收（生活费常由转账进来），
              只打 transferIncome 标记，方便用户自查并手动排除本人账户互转
           ④ 支出方向且文字含转账 / 汇款 → excluded（给室友转账不是消费）
         提现/还款只匹配「分类 + 交易类型」这类标签列，不匹配对方名 / 商品名，
         否则「借贷宝超市」会被当成借贷记录误杀。 */
      var labelText = (rawCategory + ' ' + typeColText).trim();
      var withdrawRepay = isWithdrawOrRepay(labelText);
      var transferText = isTransferText(rawCategory + ' ' + typeColText + ' ' + desc) || resolved.excluded;

      var isExcluded = false;
      var transferIncome = false;
      if (direction === 'excluded') {
        isExcluded = true;
      } else if (withdrawRepay) {
        isExcluded = true;
      } else if (type === 'income') {
        isExcluded = false;
        transferIncome = transferText;
      } else if (transferText) {
        isExcluded = true;
      }

      var finalCategory = isExcluded
        ? '其他'
        : (type === 'income' ? INCOME_CATEGORY : resolved.category);

      if (transferIncome) { transferIncomeCount += 1; }

      var motive = (NLP && typeof NLP.detectMotivation === 'function')
        ? NLP.detectMotivation(counterparty + ' ' + desc + ' ' + rawCategory)
        : { motivation: '刚需', want: false };

      result.records.push({
        file: name,
        row: i + 1,
        date: dt.date,
        time: dt.time,
        month: dt.month,
        amount: amt.value,
        type: type,
        rawCategory: rawCategory,
        category: finalCategory,
        excluded: isExcluded,
        transferIncome: transferIncome,
        amountConflict: amountConflict,
        counterparty: counterparty,
        desc: desc,
        note: (counterparty ? counterparty + ' ' : '') + desc,
        motivation: type === 'income' ? '刚需' : motive.motivation,
        want: type === 'income' ? false : !!motive.want,
        excludedReason: isExcluded
          ? (direction === 'excluded' ? '「不计收支」的转账 / 还款记录，不计入统计' : '转账 / 还款不计入消费统计')
          : ''
      });
    }

    result.skipped = skipped;
    result.transferIncomeCount = transferIncomeCount;
    /* 表头之前的说明行（导出文件顶部的账号、时间范围等）单独计数，
       不能和表头之后的坏行混成一个「跳过 N 行」。 */
    result.skippedBefore = header.index;
    result.ok = result.records.length > 0;
    if (!result.ok && !result.reason) {
      result.reason = '表头识别成功，但没有解析出有效记录（请检查日期与金额列）';
    }
    return result;
  }

  /* ================================================================== */
  /* ⑤ 去重                                                              */
  /* ================================================================== */

  /**
   * 同「日期 + 金额 + 对方」判为疑似重复（跨文件与文件内都判）。
   * 只标记不删除：dupIndex === 0 的保留，其余 isDuplicate = true。
   * @param {Array} rows
   * @return {Array<{key:string,date:string,amount:number,counterparty:string,items:Array}>}
   */
  function markDuplicates(rows) {
    var list = Array.isArray(rows) ? rows : [];
    var map = {};
    var order = [];
    var i;
    for (i = 0; i < list.length; i++) {
      var row = list[i];
      if (!row || !row.date || !row.amount) { continue; }
      var cp = String(row.counterparty || '').replace(/\s/g, '');
      var key = row.date + '|' + round2(row.amount).toFixed(2) + '|' + cp;
      row.dupKey = key;
      if (!Object.prototype.hasOwnProperty.call(map, key)) {
        map[key] = [];
        order.push(key);
      }
      map[key].push(row);
    }

    var groups = [];
    var g;
    for (g = 0; g < order.length; g++) {
      var key2 = order[g];
      var items = map[key2];
      if (items.length < 2) {
        var only = items[0];
        if (only) {
          only.dupIndex = 0;
          only.isDuplicate = false;
          only.duplicateOf = '';
        }
        continue;
      }
      var group = {
        key: key2,
        date: items[0].date,
        amount: round2(items[0].amount),
        counterparty: items[0].counterparty,
        items: items
      };
      var j;
      for (j = 0; j < items.length; j++) {
        items[j].dupIndex = j;
        items[j].isDuplicate = j > 0;
        items[j].duplicateOf = j === 0 ? '' : String(items[0].file) + '#' + items[0].row;
      }
      groups.push(group);
    }
    return groups;
  }

  /**
   * 多文件汇总。rows 已经打完去重标记。
   * @param {Array} files parseFile 结果数组
   * @param {{now?:Date}} [opts]
   * @return {{rows:Array, files:Array, duplicates:Array}}
   */
  function buildRows(files, opts) {
    var list = Array.isArray(files) ? files : [];
    var rows = [];
    var metas = [];
    var i;
    var j;
    for (i = 0; i < list.length; i++) {
      var meta = list[i];
      metas.push({
        name: meta.name,
        ok: !!meta.ok,
        reason: meta.reason || '',
        preview: meta.preview || '',
        encoding: meta.encoding || '',
        headerRow: meta.headerRow || 0,
        totalRows: meta.totalRows || 0,
        skipped: meta.skipped || 0,
        skippedBefore: meta.skippedBefore || 0,
        transferIncomeCount: meta.transferIncomeCount || 0,
        columns: meta.columns || {},
        records: (meta.records || []).length,
        delimiter: meta.delimiter || ','
      });
      for (j = 0; j < (meta.records || []).length; j++) {
        rows.push(meta.records[j]);
      }
    }
    var duplicates = markDuplicates(rows);
    return { rows: rows, files: metas, duplicates: duplicates };
  }

  /* ================================================================== */
  /* ⑥ 报告                                                              */
  /* ================================================================== */

  function inferMonth(rows) {
    var best = '';
    var i;
    for (i = 0; i < rows.length; i++) {
      var m = rows[i] && rows[i].month ? rows[i].month : monthKeyOf(rows[i] && rows[i].date);
      if (m && m > best) { best = m; }
    }
    return best || currentMonth();
  }

  function collectDuplicateGroups(rows) {
    var map = {};
    var order = [];
    var i;
    for (i = 0; i < rows.length; i++) {
      var row = rows[i];
      if (!row || !row.date || !row.amount) { continue; }
      var cp = String(row.counterparty || '').replace(/\s/g, '');
      var key = row.date + '|' + round2(row.amount).toFixed(2) + '|' + cp;
      if (!Object.prototype.hasOwnProperty.call(map, key)) {
        map[key] = [];
        order.push(key);
      }
      map[key].push(row);
    }
    var out = [];
    var k;
    for (k = 0; k < order.length; k++) {
      var items = map[order[k]];
      if (items.length < 2) { continue; }
      out.push({
        key: order[k],
        date: items[0].date,
        amount: round2(items[0].amount),
        counterparty: items[0].counterparty || items[0].note || '',
        items: items.map(function (r) {
          return { file: r.file, row: r.row, desc: r.desc, category: r.category };
        })
      });
    }
    return out;
  }

  /** 分组求和工具 */
  function groupSum(rows, keyFn) {
    var map = {};
    var i;
    for (i = 0; i < rows.length; i++) {
      var k = keyFn(rows[i]);
      if (k === undefined || k === null || k === '') { continue; }
      if (!Object.prototype.hasOwnProperty.call(map, k)) {
        map[k] = { key: k, amount: 0, count: 0, rows: [] };
      }
      map[k].amount = round2(map[k].amount + num(rows[i].amount));
      map[k].count += 1;
      map[k].rows.push(rows[i]);
    }
    return map;
  }

  /**
   * 生成 9 节报告。
   * @param {Array} rows 记录（可含 excluded / isDuplicate 标记）
   * @param {{month?:string, excludeDuplicates?:boolean, files?:Array}} [opts]
   * @return {Object}
   */
  function report(rows, opts) {
    var o = opts || {};
    var all = Array.isArray(rows) ? rows : [];
    var excludeDuplicates = !!o.excludeDuplicates;
    var month = o.month || inferMonth(all);
    var prevMonth = shiftMonth(month, -1);
    var i;

    /* ---- 有效行（排除 转账/还款；可选排除重复项） ---- */
    var valid = [];
    for (i = 0; i < all.length; i++) {
      var r = all[i];
      if (!r || !r.date || !r.amount) { continue; }
      if (r.excluded) { continue; }
      if (excludeDuplicates && r.isDuplicate) { continue; }
      valid.push(r);
    }

    var monthRows = [];
    var prevRows = [];
    for (i = 0; i < valid.length; i++) {
      var m = valid[i].month || monthKeyOf(valid[i].date);
      if (m === month) { monthRows.push(valid[i]); }
      else if (m === prevMonth) { prevRows.push(valid[i]); }
    }

    var expenseRows = [];
    var incomeRows = [];
    for (i = 0; i < monthRows.length; i++) {
      if (monthRows[i].type === 'income') { incomeRows.push(monthRows[i]); }
      else { expenseRows.push(monthRows[i]); }
    }
    var prevExpenseRows = [];
    var prevIncomeRows = [];
    for (i = 0; i < prevRows.length; i++) {
      if (prevRows[i].type === 'income') { prevIncomeRows.push(prevRows[i]); }
      else { prevExpenseRows.push(prevRows[i]); }
    }

    var totalExpense = sum(expenseRows, function (x) { return x.amount; });
    var totalIncome = sum(incomeRows, function (x) { return x.amount; });
    var balance = round2(totalIncome - totalExpense);

    /* ---- 1. 总览 ---- */
    var activeDays = {};
    for (i = 0; i < expenseRows.length; i++) { activeDays[expenseRows[i].date] = true; }
    var activeDayCount = Object.keys(activeDays).length;

    var prevExpense = sum(prevExpenseRows, function (x) { return x.amount; });
    var prevIncome = sum(prevIncomeRows, function (x) { return x.amount; });
    var hasPrev = prevRows.length > 0;

    var overview = {
      month: month,
      prevMonth: prevMonth,
      expense: totalExpense,
      income: totalIncome,
      balance: balance,
      count: expenseRows.length,
      expenseCount: expenseRows.length,
      incomeCount: incomeRows.length,
      avgPerTx: expenseRows.length > 0 ? round2(totalExpense / expenseRows.length) : 0,
      activeDays: activeDayCount,
      daysInMonth: daysInMonth(month),
      avgPerDay: activeDayCount > 0 ? round2(totalExpense / activeDayCount) : 0,
      prevExpense: hasPrev ? prevExpense : null,
      prevIncome: hasPrev ? prevIncome : null,
      expenseDelta: hasPrev ? round2(totalExpense - prevExpense) : null,
      expenseDeltaPercent: (hasPrev && prevExpense > 0)
        ? round2((totalExpense - prevExpense) / prevExpense * 100) : null,
      savingsRate: totalIncome > 0 ? round2(balance / totalIncome * 100) : null,
      hasPrev: hasPrev
    };

    /* ---- 2. 分类占比与环比 ---- */
    var catNow = groupSum(expenseRows, function (x) { return x.category; });
    var catPrev = groupSum(prevExpenseRows, function (x) { return x.category; });
    var categories = [];
    var keys = DATA.CATEGORY_KEYS.slice();
    var keySet = {};
    for (i = 0; i < keys.length; i++) { keySet[keys[i]] = true; }
    var extraKeys = Object.keys(catNow);
    for (i = 0; i < extraKeys.length; i++) {
      if (!keySet[extraKeys[i]]) { keys.push(extraKeys[i]); keySet[extraKeys[i]] = true; }
    }
    var k;
    for (k = 0; k < keys.length; k++) {
      var cat = keys[k];
      var now = catNow[cat] || { amount: 0, count: 0 };
      var prev = catPrev[cat] || { amount: 0, count: 0 };
      if (now.amount <= 0 && prev.amount <= 0) { continue; }
      categories.push({
        category: cat,
        amount: round2(now.amount),
        count: now.count,
        avg: now.count > 0 ? round2(now.amount / now.count) : 0,
        percent: totalExpense > 0 ? round2(now.amount / totalExpense * 100) : 0,
        prevAmount: round2(prev.amount),
        delta: round2(now.amount - prev.amount),
        deltaPercent: prev.amount > 0 ? round2((now.amount - prev.amount) / prev.amount * 100) : null
      });
    }
    categories.sort(function (a, b) { return b.amount - a.amount; });

    /* ---- 3. Top 10 单笔大额 ---- */
    var sortedByAmount = expenseRows.slice().sort(function (a, b) {
      if (b.amount !== a.amount) { return b.amount - a.amount; }
      return a.date < b.date ? -1 : 1;
    });
    var topExpenses = sortedByAmount.slice(0, 10).map(function (x) {
      return {
        date: x.date,
        time: x.time || '',
        counterparty: x.counterparty || '',
        desc: x.desc || '',
        category: x.category,
        amount: round2(x.amount)
      };
    });

    /* ---- 4. Top 10 高频商户 ---- */
    var merchantMap = groupSum(expenseRows, function (x) {
      return String(x.counterparty || '').trim();
    });
    var topMerchants = Object.keys(merchantMap).map(function (name) {
      var g = merchantMap[name];
      return {
        name: name,
        count: g.count,
        amount: round2(g.amount),
        avg: round2(g.amount / g.count)
      };
    }).sort(function (a, b) {
      if (b.count !== a.count) { return b.count - a.count; }
      return b.amount - a.amount;
    }).slice(0, 10);

    /* ---- 5. 周末 vs 工作日（用日均比，不用总额比） ---- */
    var buckets = {
      weekend: { count: 0, amount: 0, days: {} },
      weekday: { count: 0, amount: 0, days: {} }
    };
    for (i = 0; i < expenseRows.length; i++) {
      var e = expenseRows[i];
      var bucket = isWeekend(e.date) ? buckets.weekend : buckets.weekday;
      bucket.count += 1;
      bucket.amount = round2(bucket.amount + num(e.amount));
      bucket.days[e.date] = true;
    }
    var weekendDays = Object.keys(buckets.weekend.days).length;
    var weekdayDays = Object.keys(buckets.weekday.days).length;
    var weekendAvg = weekendDays > 0 ? round2(buckets.weekend.amount / weekendDays) : 0;
    var weekdayAvg = weekdayDays > 0 ? round2(buckets.weekday.amount / weekdayDays) : 0;
    var weekendVsWeekday = {
      weekend: {
        count: buckets.weekend.count,
        amount: round2(buckets.weekend.amount),
        days: weekendDays,
        avg: weekendAvg
      },
      weekday: {
        count: buckets.weekday.count,
        amount: round2(buckets.weekday.amount),
        days: weekdayDays,
        avg: weekdayAvg
      },
      ratio: weekdayAvg > 0 ? round2(weekendAvg / weekdayAvg) : null
    };

    /* ---- 6. 订阅型支出（连续 ≥3 个月 同对方 + 同金额） ---- */
    var allExpense = [];
    for (i = 0; i < valid.length; i++) {
      if (valid[i].type !== 'income') { allExpense.push(valid[i]); }
    }
    var subMap = {};
    var subOrder = [];
    for (i = 0; i < allExpense.length; i++) {
      var row2 = allExpense[i];
      var name = String(row2.counterparty || '').trim();
      if (!name) { continue; }
      var subKey = name + '|' + round2(row2.amount).toFixed(2);
      if (!Object.prototype.hasOwnProperty.call(subMap, subKey)) {
        subMap[subKey] = { name: name, amount: round2(row2.amount), months: {}, count: 0 };
        subOrder.push(subKey);
      }
      subMap[subKey].months[row2.month || monthKeyOf(row2.date)] = true;
      subMap[subKey].count += 1;
    }
    var subscriptions = [];
    var s;
    for (s = 0; s < subOrder.length; s++) {
      var sub = subMap[subOrder[s]];
      var months = Object.keys(sub.months).sort();
      if (months.length < 3) { continue; }
      // 找最长连续月份段
      var bestRun = [];
      var run = [months[0]];
      var mi;
      for (mi = 1; mi < months.length; mi++) {
        if (months[mi] === shiftMonth(months[mi - 1], 1)) {
          run.push(months[mi]);
        } else {
          if (run.length > bestRun.length) { bestRun = run.slice(); }
          run = [months[mi]];
        }
      }
      if (run.length > bestRun.length) { bestRun = run.slice(); }
      if (bestRun.length < 3) { continue; }
      subscriptions.push({
        name: sub.name,
        amount: sub.amount,
        months: bestRun.length,
        monthList: bestRun,
        activeThisMonth: bestRun.indexOf(month) !== -1,
        annual: round2(sub.amount * 12),
        lastMonth: bestRun[bestRun.length - 1]
      });
    }
    subscriptions.sort(function (a, b) { return b.annual - a.annual; });

    /* ---- 7. 异常大额（该分类其余各笔笔均 ×3） ---- */
    var anomalies = [];
    var catRows = groupSum(expenseRows, function (x) { return x.category; });
    var catKeys = Object.keys(catRows);
    var c;
    for (c = 0; c < catKeys.length; c++) {
      var group = catRows[catKeys[c]];
      if (group.rows.length < 3) { continue; }
      var totalCat = group.amount;
      var n = group.rows.length;
      var ri;
      for (ri = 0; ri < group.rows.length; ri++) {
        var rr = group.rows[ri];
        var othersAvg = (totalCat - rr.amount) / (n - 1);
        if (othersAvg > 0 && rr.amount > othersAvg * 3) {
          anomalies.push({
            date: rr.date,
            counterparty: rr.counterparty || '',
            desc: rr.desc || '',
            category: rr.category,
            amount: round2(rr.amount),
            othersAvg: round2(othersAvg),
            times: round2(rr.amount / othersAvg)
          });
        }
      }
    }
    anomalies.sort(function (a, b) { return b.amount - a.amount; });

    /* ---- 8. 疑似重复 ---- */
    var duplicates = collectDuplicateGroups(all).map(function (g) {
      return {
        date: g.date,
        amount: g.amount,
        counterparty: g.counterparty,
        items: g.items
      };
    });

    /* ---- 9. 解析情况 ---- */
    var fileMetas = Array.isArray(o.files) ? o.files : [];
    var excludedTransfer = 0;
    var excludedDuplicate = 0;
    var transferIncomeCount = 0;
    var qi;
    for (qi = 0; qi < all.length; qi++) {
      if (!all[qi]) { continue; }
      if (all[qi].excluded) { excludedTransfer += 1; }
      if (all[qi].isDuplicate) { excludedDuplicate += 1; }
      if (all[qi].transferIncome) { transferIncomeCount += 1; }
    }
    var parseInfo = {
      files: fileMetas.map(function (f) {
        return {
          name: f.name,
          ok: !!f.ok,
          reason: f.reason || '',
          encoding: f.encoding || '',
          headerRow: f.headerRow || 0,
          records: typeof f.records === 'number' ? f.records : 0,
          skipped: f.skipped || 0,
          skippedBefore: f.skippedBefore || 0,
          transferIncomeCount: f.transferIncomeCount || 0,
          totalRows: f.totalRows || 0,
          columns: f.columns || {}
        };
      }),
      totalRecords: all.length,
      totalSkipped: fileMetas.reduce(function (acc, f) { return acc + (f.skipped || 0); }, 0),
      totalSkippedBefore: fileMetas.reduce(function (acc, f) { return acc + (f.skippedBefore || 0); }, 0),
      /* 「转账/还款」与「疑似重复」是两种完全不同的排除原因，必须分开计数 */
      excludedTransfer: excludedTransfer,
      excludedDuplicate: excludedDuplicate,
      /* 以「交易类型=转账」进来的收入：已计入收入，单独计数供 UI 提示 */
      transferIncomeCount: transferIncomeCount,
      excludedRecords: excludedTransfer
    };

    /* ---- 建议输入派生指标 ---- */
    var food = catNow['餐饮'] || { amount: 0, count: 0 };
    var emotional = expenseRows.filter(function (x) { return x.motivation === '情绪'; });
    var emotionAmount = sum(emotional, function (x) { return x.amount; });
    var nightFood = expenseRows.filter(function (x) {
      if (x.category !== '餐饮' && x.category !== '社交') { return false; }
      var h = Number(String(x.time || '').slice(0, 2));
      if (!isFinite(h) || !x.time) { return false; }
      return h >= 21 || h < 2;
    });
    var nightAmount = sum(nightFood, function (x) { return x.amount; });
    var small = expenseRows.filter(function (x) { return x.amount < 20; });
    var maxGrowth = null;
    for (i = 0; i < categories.length; i++) {
      var cg = categories[i];
      if (cg.deltaPercent === null || cg.deltaPercent < 0) { continue; }
      if (!maxGrowth || cg.deltaPercent > maxGrowth.deltaPercent) { maxGrowth = cg; }
    }

    var extras = {
      engelPercent: totalExpense > 0 ? round2(food.amount / totalExpense * 100) : 0,
      foodAmount: round2(food.amount),
      foodCount: food.count,
      emotion: {
        count: emotional.length,
        amount: emotionAmount,
        ratioAmount: totalExpense > 0 ? round2(emotionAmount / totalExpense * 100) : 0,
        ratioCount: expenseRows.length > 0 ? round2(emotional.length / expenseRows.length * 100) : 0
      },
      nightFood: {
        count: nightFood.length,
        amount: nightAmount,
        ratioOfFood: food.amount > 0 ? round2(nightAmount / food.amount * 100) : 0
      },
      small: {
        count: small.length,
        amount: sum(small, function (x) { return x.amount; }),
        ratioCount: expenseRows.length > 0 ? round2(small.length / expenseRows.length * 100) : 0
      },
      maxGrowth: maxGrowth
    };

    return {
      overview: overview,
      categories: categories,
      topExpenses: topExpenses,
      topMerchants: topMerchants,
      weekendVsWeekday: weekendVsWeekday,
      subscriptions: subscriptions,
      anomalies: anomalies,
      duplicates: duplicates,
      parseInfo: parseInfo,
      extras: extras,
      meta: {
        month: month,
        prevMonth: prevMonth,
        excludeDuplicates: excludeDuplicates,
        rowCount: all.length,
        validCount: valid.length,
        generatedAt: new Date().toISOString()
      }
    };
  }

  /* ================================================================== */
  /* ⑦ 消费建议                                                          */
  /* ================================================================== */

  /**
   * 基于报告生成 3~5 条带数字证据的建议。
   * 语气克制、不下价值判断、不推荐任何具体产品 / 平台 / 理财。
   * @param {Object} rep report() 结果
   * @param {Object} [budgetState] getBudgetState() 结果（可选）
   * @return {Array<{level:string,title:string,evidence:string,action:string}>}
   */
  function insights(rep, budgetState) {
    var r = rep || {};
    var ov = r.overview || {};
    var ex = r.extras || {};
    var out = [];

    if (ov.expense > 0) {
      /* 1. 恩格尔系数 */
      if (ex.engelPercent > 50) {
        out.push({
          level: 'warn',
          title: '餐饮占掉了过半支出',
          evidence: '本月餐饮 ' + money(ex.foodAmount) + '，占总支出 ' +
            percent(ex.engelPercent) + '（' + (ov.count || 0) + ' 笔中有 ' + (ex.foodCount || 0) + ' 笔是餐饮）。',
          action: '把外卖和奶茶各压两成，按当前餐饮金额能省回约 ' + money(ex.foodAmount * 0.2) + '。'
        });
      }

      /* 2. 情绪型消费占比 */
      if (ex.emotion && ex.emotion.ratioAmount > 15) {
        out.push({
          level: 'warn',
          title: '情绪型消费占比偏高',
          evidence: '情绪型消费 ' + ex.emotion.count + ' 笔、合计 ' + money(ex.emotion.amount) +
            '，占本月支出 ' + percent(ex.emotion.ratioAmount) + '。',
          action: '下次这类消费先放进购物车放 24 小时，回来再决定买不买。'
        });
      }

      /* 3. 夜间餐饮 */
      if (ex.nightFood && ex.nightFood.count >= 2 && ex.nightFood.ratioOfFood >= 25) {
        out.push({
          level: 'tip',
          title: '夜里的外卖和餐饮有点集中',
          evidence: '21:00 之后的餐饮 ' + ex.nightFood.count + ' 笔 ' + money(ex.nightFood.amount) +
            '，占餐饮支出 ' + percent(ex.nightFood.ratioOfFood) + '。',
          action: '这 ' + money(ex.nightFood.amount) + ' 可以先试着挪到白天：定一条「22 点后不下单」，坚持一周看效果。'
        });
      }

      /* 4. 小额高频 */
      if (ex.small && ex.small.ratioCount > 30 && ex.small.count >= 5) {
        out.push({
          level: 'tip',
          title: '小额支出笔数多',
          evidence: '单笔 20 元以下的支出 ' + ex.small.count + ' 笔、合计 ' + money(ex.small.amount) +
            '，占本月支出笔数的 ' + percent(ex.small.ratioCount) + '。',
          action: '把这 ' + ex.small.count + ' 笔、合计 ' + money(ex.small.amount) +
            ' 的零碎花费合成一个「日限额」，超了就停。'
        });
      }

      /* 5. 订阅型支出 */
      if (r.subscriptions && r.subscriptions.length >= 3) {
        var annualTotal = 0;
        var i;
        for (i = 0; i < r.subscriptions.length; i++) {
          annualTotal += r.subscriptions[i].annual;
        }
        out.push({
          level: 'tip',
          title: '有 ' + r.subscriptions.length + ' 笔固定订阅在扣',
          evidence: '「' + r.subscriptions[0].name + '」等 ' + r.subscriptions.length + ' 笔每月固定 ' +
            money(sum(r.subscriptions, function (x) { return x.amount; })) + '，一年要花 ' +
            money(annualTotal) + '。',
          action: '看看哪几个最近没怎么用，先停一个，一年就是 ' + money(r.subscriptions[0].annual) + '。'
        });
      }

      /* 6. 周末日均 */
      var wv = r.weekendVsWeekday || {};
      if (wv.ratio && wv.ratio > 2) {
        out.push({
          level: 'tip',
          title: '周末花得比平时快',
          evidence: '周末日均 ' + money(wv.weekend.avg) + '，工作日日均 ' + money(wv.weekday.avg) +
            '，相差 ' + wv.ratio.toFixed(1) + ' 倍（周末 ' + wv.weekend.count + ' 笔 / 工作日 ' + wv.weekday.count + ' 笔）。',
          action: '周末出门前先定一个当天上限，比如 ' + money(wv.weekend.avg * 0.7) + '。'
        });
      }

      /* 7. 分类环比 */
      if (ex.maxGrowth && ex.maxGrowth.deltaPercent > 30 && ex.maxGrowth.delta > 50) {
        out.push({
          level: 'tip',
          title: ex.maxGrowth.category + '比上月涨了 ' + Math.round(ex.maxGrowth.deltaPercent) + '%',
          evidence: '本月 ' + ex.maxGrowth.category + ' ' + money(ex.maxGrowth.amount) +
            '，上月 ' + money(ex.maxGrowth.prevAmount) + '，多了 ' + money(ex.maxGrowth.delta) + '。',
          action: '本月多了 ' + money(ex.maxGrowth.delta) + '，先翻这 ' + money(ex.maxGrowth.amount) +
            ' 的明细，看看哪几笔是可省的。'
        });
      }
    }

    /* 8. 储蓄率 */
    if (ov.savingsRate !== null && ov.savingsRate < 10) {
      out.push({
        level: 'warn',
        title: '这个月几乎没存下钱',
        evidence: '本月收入 ' + money(ov.income) + '、支出 ' + money(ov.expense) +
          '，结余 ' + money(ov.balance) + '，储蓄率 ' + percent(ov.savingsRate) + '。',
        action: '先把目标定成每月存 ' + money(Math.max(50, ov.expense * 0.1)) + '，发钱当天就先转出去。'
      });
    }

    /* ---- 兜底：保证至少 3 条，且每条都带数字 ---- */
    if (out.length < 3 && ov.expense > 0) {
      var top = (r.categories && r.categories.length > 0) ? r.categories[0] : null;
      if (top) {
        out.push({
          level: 'tip',
          title: '本月最大的一类是' + top.category,
          evidence: top.category + ' ' + money(top.amount) + '，占支出 ' + percent(top.percent) +
            '，共 ' + top.count + ' 笔，笔均 ' + money(top.avg) + '。',
          action: '先从笔均 ' + money(top.avg) + ' 的那几笔看起，通常最容易省。'
        });
      }
      out.push({
        level: 'tip',
        title: '本月支出概况',
        evidence: '共 ' + ov.count + ' 笔、合计 ' + money(ov.expense) + '，笔均 ' + money(ov.avgPerTx) +
          '，有记录的 ' + ov.activeDays + ' 天里日均 ' + money(ov.avgPerDay) + '。',
        action: '按 ' + ov.daysInMonth + ' 天摊，每天约 ' + money(ov.expense / ov.daysInMonth) +
          '，可以拿它当每日限额的参考。'
      });
    }
    /* 这一支只在「有收入」且前面凑不满 3 条时执行。此时结余一定是正的：
       ① expense === 0 → balance === income > 0；
       ② expense > 0 且 balance < 0 → 储蓄率必为负数 → 上面「储蓄率 < 10%」那条必然命中，
          再由 `out.length < 3 && ov.expense > 0` 补足到 3 条，走不到这里。
       所以不需要再判负结余。
       金额用比例（50% / 50%）而不是 money(balance * 0.5)：后者在 report 里反查不到，
       会违反「建议里引用的每个 ¥ 金额都能回到报告」这条约束。 */
    if (out.length < 3 && ov.income > 0) {
      out.push({
        level: 'tip',
        title: '本月收支结构',
        evidence: '收入 ' + money(ov.income) + '、支出 ' + money(ov.expense) + '，结余 ' + money(ov.balance) +
          '，储蓄率 ' + (ov.savingsRate === null ? '—' : percent(ov.savingsRate)) + '。',
        action: '把结余 ' + money(ov.balance) + ' 按 50% / 50% 拆开：一半先转进目标池，一半再当零花。'
      });
    }

    return out.slice(0, 5);
  }

  /* ================================================================== */
  /* ⑧ Markdown 导出                                                     */
  /* ================================================================== */

  /**
   * 第 9 节「列映射」展示串。借贷双列时两个金额列都要展示，
   * 否则用户看到「记账日期 / 借方发生额 / 对方户名」会以为收入列没被识别。
   * @param {Object} cols parseFile().columns
   * @param {boolean} [full] true 时附带「说明 / 分类」（看板用）
   * @return {string}
   */
  function columnMapText(cols, full) {
    var c = cols || {};
    var amountText;
    if (c.amountDebit && c.amountCredit) {
      amountText = c.amountDebit + ' / ' + c.amountCredit;
    } else {
      amountText = c.amountDebit || c.amountCredit || c.amount || '';
    }
    var parts = [c.time, amountText, c.direction, c.counterparty];
    if (full) { parts.push(c.desc, c.category); }
    return parts.filter(Boolean).join(' / ') || '—';
  }

  function mdTable(headers, rows) {
    var out = [];
    out.push('| ' + headers.join(' | ') + ' |');
    out.push('| ' + headers.map(function () { return '---'; }).join(' | ') + ' |');
    var i;
    for (i = 0; i < rows.length; i++) {
      out.push('| ' + rows[i].join(' | ') + ' |');
    }
    return out.join('\n');
  }

  /**
   * 报告 → Markdown 文本（9 节）。
   * @param {Object} rep
   * @return {string}
   */
  function toMarkdown(rep) {
    var r = rep || {};
    var ov = r.overview || {};
    var lines = [];
    lines.push('# 账单分析报告（' + (ov.month || '—') + '）');
    lines.push('');
    lines.push('> 生成时间：' + new Date().toLocaleString('zh-CN') + '　|　共 ' + ((r.meta && r.meta.validCount) || 0) + ' 条有效记录');
    lines.push('');

    lines.push('## 1. 总览');
    lines.push('');
    var prevText = ov.hasPrev
      ? (ov.expenseDeltaPercent === null ? '—' : (ov.expenseDeltaPercent >= 0 ? '+' : '') + ov.expenseDeltaPercent.toFixed(1) + '%')
      : '—';
    lines.push(mdTable(['指标', '数值'], [
      ['总支出', money(ov.expense)],
      ['总收入', money(ov.income)],
      ['结余', money(ov.balance)],
      ['支出笔数', String(ov.count)],
      ['笔均', money(ov.avgPerTx)],
      ['日均（按有记录的天数）', money(ov.avgPerDay) + '（' + ov.activeDays + ' 天）'],
      ['与上月支出对比', prevText],
      ['储蓄率', ov.savingsRate === null ? '—' : percent(ov.savingsRate)]
    ]));
    lines.push('');

    lines.push('## 2. 分类占比与环比');
    lines.push('');
    lines.push(mdTable(['分类', '金额', '占比', '笔数', '笔均', '环比'], (r.categories || []).map(function (c) {
      return [
        c.category,
        money(c.amount),
        percent(c.percent),
        String(c.count),
        money(c.avg),
        c.deltaPercent === null ? '—' : (c.deltaPercent >= 0 ? '+' : '') + c.deltaPercent.toFixed(1) + '%'
      ];
    })));
    lines.push('');

    lines.push('## 3. Top 10 单笔大额');
    lines.push('');
    lines.push(mdTable(['日期', '对方', '说明', '分类', '金额'], (r.topExpenses || []).map(function (x) {
      return [x.date, x.counterparty || '—', x.desc || '—', x.category, money(x.amount)];
    })));
    lines.push('');

    lines.push('## 4. Top 10 高频商户');
    lines.push('');
    lines.push(mdTable(['商户', '笔数', '金额', '笔均'], (r.topMerchants || []).map(function (x) {
      return [x.name, String(x.count), money(x.amount), money(x.avg)];
    })));
    lines.push('');

    lines.push('## 5. 周末 vs 工作日');
    lines.push('');
    var wv = r.weekendVsWeekday || { weekend: {}, weekday: {} };
    lines.push(mdTable(['口径', '笔数', '合计', '天数', '日均'], [
      ['周末', String(wv.weekend.count || 0), money(wv.weekend.amount || 0), String(wv.weekend.days || 0), money(wv.weekend.avg || 0)],
      ['工作日', String(wv.weekday.count || 0), money(wv.weekday.amount || 0), String(wv.weekday.days || 0), money(wv.weekday.avg || 0)]
    ]));
    lines.push('');
    lines.push('周末日均 / 工作日日均 = ' + (wv.ratio === null || wv.ratio === undefined ? '—' : wv.ratio.toFixed(2) + ' 倍'));
    lines.push('');

    lines.push('## 6. 订阅型支出');
    lines.push('');
    if ((r.subscriptions || []).length === 0) {
      lines.push('未发现连续 3 个月「同商户 + 同金额」的固定扣款。');
    } else {
      lines.push(mdTable(['商户', '月扣', '连续月数', '本月仍在扣', '折合一年'], r.subscriptions.map(function (s) {
        return [s.name, money(s.amount), String(s.months), s.activeThisMonth ? '是' : '否', money(s.annual)];
      })));
    }
    lines.push('');

    lines.push('## 7. 异常大额');
    lines.push('');
    if ((r.anomalies || []).length === 0) {
      lines.push('没有单笔超过该分类笔均 3 倍的支出。');
    } else {
      lines.push(mdTable(['日期', '对方', '说明', '分类', '金额', '该分类其余笔均', '倍数'], r.anomalies.map(function (a) {
        return [a.date, a.counterparty || '—', a.desc || '—', a.category, money(a.amount), money(a.othersAvg), a.times.toFixed(1) + '×'];
      })));
    }
    lines.push('');

    lines.push('## 8. 疑似重复');
    lines.push('');
    if ((r.duplicates || []).length === 0) {
      lines.push('未发现同日期 + 同金额 + 同对方的重复记录。');
    } else {
      (r.duplicates || []).forEach(function (g, idx) {
        lines.push((idx + 1) + '. ' + g.date + '　' + money(g.amount) + '　' + (g.counterparty || '—'));
        g.items.forEach(function (it) {
          lines.push('   - ' + it.file + ' 第 ' + it.row + ' 行：' + (it.desc || '—'));
        });
      });
    }
    lines.push('');

    lines.push('## 9. 解析情况');
    lines.push('');
    lines.push(mdTable(['文件', '编码', '表头行', '有效记录', '前置说明行', '无效数据行', '列映射'], (r.parseInfo && r.parseInfo.files || []).map(function (f) {
      return [
        f.name,
        f.encoding || '—',
        f.headerRow ? String(f.headerRow) : '—',
        String(f.records),
        String(f.skippedBefore || 0),
        String(f.skipped || 0),
        columnMapText(f.columns)
      ];
    })));
    lines.push('');

    return lines.join('\n');
  }

  /* ================================================================== */
  /* ⑨ 导入账本                                                          */
  /* ================================================================== */

  /**
   * 推断导入收入的来源（生活费 / 兼职 / 奖学金 …），推断不出才留「其他」。
   * @param {Object} row 记录
   * @return {string}
   */
  function guessIncomeSource(row) {
    var r = row || {};
    var text = [(r.desc || ''), (r.counterparty || ''), (r.note || ''), (r.rawCategory || '')]
      .join(' ').trim();
    var guessed = '';
    if (NLP && typeof NLP.detectIncomeSource === 'function') {
      guessed = NLP.detectIncomeSource(text);
    }
    var sources = DATA.INCOME_SOURCES || [];
    if (guessed && (sources.length === 0 || sources.indexOf(guessed) !== -1)) { return guessed; }
    return '其他';
  }

  /**
   * 把导入记录转成账单草稿（供 app.js commitBill 使用）。
   * @param {Array} rows
   * @param {{month?:string, excludeDuplicates?:boolean}} [opts]
   * @return {Array}
   */
  function rowsToBills(rows, opts) {
    var o = opts || {};
    var list = Array.isArray(rows) ? rows : [];
    var out = [];
    var i;
    for (i = 0; i < list.length; i++) {
      var r = list[i];
      if (!r || !r.date || !r.amount) { continue; }
      if (r.excluded) { continue; }
      if (o.excludeDuplicates && r.isDuplicate) { continue; }
      if (o.month && (r.month || monthKeyOf(r.date)) !== o.month) { continue; }
      out.push({
        date: r.date,
        amount: round2(r.amount),
        category: r.type === 'income' ? INCOME_CATEGORY : r.category,
        source: r.type === 'income' ? guessIncomeSource(r) : '',
        note: r.note || r.desc || r.counterparty || r.category,
        motivation: r.type === 'income' ? '刚需' : (r.motivation || '刚需'),
        want: r.type === 'income' ? false : !!r.want,
        type: r.type === 'income' ? 'income' : 'expense',
        imported: true
      });
    }
    return out;
  }

  var API = {
    decodeBytes: decodeBytes,
    isGarbled: isGarbled,
    detectDelimiter: detectDelimiter,
    parseDelimited: parseDelimited,
    parseCsv: parseCsv,
    normHeader: normHeader,
    mapColumns: mapColumns,
    hasAmountColumn: hasAmountColumn,
    detectHeader: detectHeader,
    parseDateTime: parseDateTime,
    cleanAmount: cleanAmount,
    normalizeDirection: normalizeDirection,
    looksExcluded: looksExcluded,
    isWithdrawOrRepay: isWithdrawOrRepay,
    isTransferText: isTransferText,
    resolveCategory: resolveCategory,
    parseFile: parseFile,
    markDuplicates: markDuplicates,
    buildRows: buildRows,
    report: report,
    insights: insights,
    toMarkdown: toMarkdown,
    rowsToBills: rowsToBills,
    guessIncomeSource: guessIncomeSource,
    columnMapText: columnMapText,
    money: money,
    percent: percent,
    shiftMonth: shiftMonth,
    monthKeyOf: monthKeyOf
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.analysis = API;
  }
})(typeof globalThis !== 'undefined' ? globalThis : this);

  </script>
<script>
/**
 * ocr.js — 消费截图识别记账（三层降级）
 *
 * 全局命名空间：window.AJ.ocr
 * Node 单测：require('./ocr.js')
 *
 * 三层降级：
 *   ① 浏览器原生 window.TextDetector —— 本地识别，零网络
 *   ② 云 OCR（腾讯云 GeneralBasicOCR，可选）—— 用户配置凭据后才可能发请求
 *   ③ 演示模式 —— 内置 3 份示例小票文本，**仅由用户显式选择时触发**
 *
 * ⚠️ 演示模式绝不作为 auto 的自动回落：没有可用识别能力时返回 ok:false /
 *    source:'none'，UI 会引导用户「看示例 / 配云 OCR / 手动录入」。
 *    拿示例数据冒充用户图片的识别结果属于不可接受的误导。
 *
 * ⚠️ 本文件是全项目唯一允许出现 fetch 的文件。
 *    未配置凭据时 detect() 绝不发起任何网络请求。
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);

  /** 凭据单独存一个 key，与账本数据隔离 */
  var CRED_KEY = 'ai_jizhang_ocr';
  var CLOUD_ENDPOINT = 'https://ocr.tencentcloudapi.com';
  var CLOUD_HOST = 'ocr.tencentcloudapi.com';
  var CLOUD_SERVICE = 'ocr';
  var CLOUD_ACTION = 'GeneralBasicOCR';
  var CLOUD_VERSION = '2018-11-19';

  /** 内存兜底（无 localStorage 或读写失败时使用） */
  var memCred = { secretId: '', secretKey: '', region: 'ap-guangzhou' };

  /* ================================================================== */
  /* 演示样例（3 份，覆盖 high / medium / low 三种置信度）               */
  /* ================================================================== */

  /** 本地时区的 YYYY-MM-DD */
  function formatDay(date) {
    var d = (date instanceof Date) ? date : new Date();
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  /**
   * 构造 3 份演示样例。
   * 日期必须按「调用时」现算：写死往年日期会让用户确认入账后
   * 看板的「今日支出 / 本周期支出」毫无变化，演示时像是功能坏了。
   * @param {Date} [now]
   * @return {Array<Object>}
   */
  function buildSamples(now) {
    var base = (now instanceof Date) ? now : new Date();
    var today = formatDay(base);
    var shortDay = pad2(base.getMonth() + 1) + '-' + pad2(base.getDate());
    return [
      {
        id: 'sample_wx',
        title: '微信支付凭证',
        expect: 'high',
        text: [
          '微信支付',
          '商户名称：三食堂麻辣香锅',
          '支付金额 ¥32.00',
          '支付时间 ' + today + ' 12:30',
          '支付方式：零钱'
        ].join('\n')
      },
      {
        id: 'sample_alipay',
        title: '支付宝账单详情',
        expect: 'medium',
        text: [
          '支付宝',
          '订单号 2025102122001456789012',
          '商户名称：瑞幸咖啡',
          '商品说明：生椰拿铁 x2',
          '订单金额 38.00',
          '优惠 -6.00',
          '合计 32.00',
          '实付 32.00',
          '交易时间 ' + shortDay + ' 12:30'
        ].join('\n')
      },
      {
        id: 'sample_canteen',
        title: '食堂小票',
        expect: 'low',
        text: [
          '校园食堂',
          '黄焖鸡 18.00',
          '米饭 2.00',
          '紫菜蛋花汤 3.00'
        ].join('\n')
      }
    ];
  }

  /* ================================================================== */
  /* 通用工具                                                            */
  /* ================================================================== */

  function pad2(n) {
    return n < 10 ? '0' + n : '' + n;
  }

  function round2(n) {
    var v = Number(n);
    if (!isFinite(v)) { return 0; }
    return Math.round((v + Number.EPSILON) * 100) / 100;
  }

  /** 全角数字 / 符号 → 半角（1:1 替换，不改变长度） */
  function normalizeWidth(text) {
    return String(text === undefined || text === null ? '' : text)
      .replace(/[\uFF10-\uFF19]/g, function (c) {
        return String.fromCharCode(c.charCodeAt(0) - 0xFEE0);
      })
      .replace(/\uFF0E/g, '.')
      .replace(/\uFF1A/g, ':')
      .replace(/\uFF0C/g, ',')
      .replace(/\uFF0D/g, '-')
      .replace(/\uFFE5/g, '¥');
  }

  function errorMessage(err) {
    if (!err) { return '未知错误'; }
    if (typeof err === 'string') { return err; }
    if (err.message) { return String(err.message); }
    return String(err);
  }

  /* ================================================================== */
  /* 小票文本解析                                                        */
  /* ================================================================== */

  /**
   * 金额标签优先级（数字越大越可信）。
   * 「实付 / 支付金额」优先于「合计 / 总计」，因为合计里可能含优惠前的原价。
   */
  var AMOUNT_LABELS = [
    { word: '实付', score: 100 },
    { word: '支付金额', score: 96 },
    { word: '付款金额', score: 94 },
    { word: '消费金额', score: 90 },
    { word: '本次支付', score: 90 },
    { word: '实收', score: 86 },
    { word: '应收', score: 80 },
    { word: '合计', score: 76 },
    { word: '总计', score: 74 },
    { word: '小计', score: 70 },
    { word: '金额', score: 60 }
  ];

  var MERCHANT_HINTS = ['店', '餐厅', '超市', '咖啡', '食堂', '小吃', '便利店', '餐', '奶茶', '药房', '书店', '水果', '烘焙'];
  var MERCHANT_PREFIX = /^(商户名称|商户|收款方|商家|店铺|收款单位)\s*[:：]\s*/;

  /**
   * 抽取金额。
   * @param {string} text 已归一化文本
   * @return {?{amount:number, label:string, score:number, byMax:boolean}}
   */
  function extractAmount(text) {
    var best = null;
    var i;
    for (i = 0; i < AMOUNT_LABELS.length; i++) {
      var def = AMOUNT_LABELS[i];
      var re = new RegExp(def.word + '\\s*[:：]?\\s*[¥￥]?\\s*(-?\\d+(?:\\.\\d{1,2})?)', 'g');
      var m;
      var last = null;
      while ((m = re.exec(text)) !== null) {
        var v = Number(m[1]);
        if (isFinite(v) && v > 0) {
          last = { value: v, label: def.word, score: def.score };
        }
      }
      if (last && (!best || last.score > best.score)) {
        best = { amount: round2(last.value), label: last.label, score: last.score, byMax: false };
      }
    }
    if (best) { return best; }

    /* 兜底：去掉日期 / 时间 / 长订单号后，取最大数字 */
    var cleaned = String(text)
      .replace(/\d{4}\s*[-/年.]\s*\d{1,2}\s*[-/月.]\s*\d{1,2}/g, ' ')
      .replace(/\d{1,2}:\d{2}(?::\d{2})?/g, ' ')
      .replace(/\d{7,}/g, ' ');

    var candidates = [];
    var reMoney = /[¥￥]\s*(\d+(?:\.\d{1,2})?)/g;
    var mm;
    while ((mm = reMoney.exec(cleaned)) !== null) {
      var mv = Number(mm[1]);
      if (isFinite(mv) && mv > 0) { candidates.push(mv); }
    }
    if (candidates.length === 0) {
      var reDecimal = /(\d+\.\d{1,2})/g;
      while ((mm = reDecimal.exec(cleaned)) !== null) {
        var dv = Number(mm[1]);
        if (isFinite(dv) && dv > 0) { candidates.push(dv); }
      }
    }
    if (candidates.length === 0) {
      var reInt = /(?:^|[^\d.])(\d{1,6})(?![\d.])/g;
      while ((mm = reInt.exec(cleaned)) !== null) {
        var iv = Number(mm[1]);
        if (isFinite(iv) && iv > 0) { candidates.push(iv); }
      }
    }
    if (candidates.length === 0) { return null; }
    var max = 0;
    for (i = 0; i < candidates.length; i++) {
      if (candidates[i] > max) { max = candidates[i]; }
    }
    return { amount: round2(max), label: '', score: 0, byMax: true };
  }

  /**
   * 抽取商户名：优先带「商户 / 收款方」前缀的行，其次命中行业关键词的行，最后取首行。
   * @param {string} text
   * @return {{merchant:string, hasHint:boolean}}
   */
  function extractMerchant(text) {
    var rawLines = String(text).split(/\r?\n/);
    var lines = [];
    var i;
    for (i = 0; i < rawLines.length; i++) {
      var t = rawLines[i].trim();
      if (t) { lines.push(t); }
    }
    for (i = 0; i < lines.length; i++) {
      if (MERCHANT_PREFIX.test(lines[i])) {
        var stripped = lines[i].replace(MERCHANT_PREFIX, '').trim();
        if (stripped) { return { merchant: stripped, hasHint: true }; }
      }
    }
    for (i = 0; i < lines.length; i++) {
      var j;
      for (j = 0; j < MERCHANT_HINTS.length; j++) {
        if (lines[i].indexOf(MERCHANT_HINTS[j]) !== -1) {
          return { merchant: lines[i], hasHint: true };
        }
      }
    }
    for (i = 0; i < lines.length; i++) {
      // 纯数字 / 纯时间 / 支付渠道名不作为商户
      if (/^[\d\s.:½¥￥-]+$/.test(lines[i])) { continue; }
      if (/^(微信支付|支付宝|微信|账单详情|支付凭证|交易详情|收银台)$/.test(lines[i])) { continue; }
      return { merchant: lines[i], hasHint: false };
    }
    return { merchant: '', hasHint: false };
  }

  /**
   * 抽取日期：优先完整日期（含年份），否则 MM-DD 补当前年份。
   * @param {string} text
   * @param {Date} now
   * @return {{date:string, full:boolean, hasTime:boolean}}
   */
  function extractDate(text, now) {
    var base = now instanceof Date ? now : new Date();
    var m = String(text).match(/(\d{4})\s*[-/年.]\s*(\d{1,2})\s*[-/月.]\s*(\d{1,2})/);
    if (m) {
      return {
        date: Number(m[1]) + '-' + pad2(Number(m[2])) + '-' + pad2(Number(m[3])),
        full: true,
        hasTime: /\d{1,2}:\d{2}/.test(text)
      };
    }
    var short = String(text).match(/(\d{1,2})\s*[-/月]\s*(\d{1,2})(?!\s*[-/:])/);
    if (short) {
      return {
        date: base.getFullYear() + '-' + pad2(Number(short[1])) + '-' + pad2(Number(short[2])),
        full: false,
        hasTime: /\d{1,2}:\d{2}/.test(text)
      };
    }
    return { date: '', full: false, hasTime: false };
  }

  /** 支付方式 */
  function extractPayMethod(text) {
    var s = String(text);
    if (/云闪付/.test(s)) { return '云闪付'; }
    if (/微信/.test(s)) { return '微信支付'; }
    if (/支付宝/.test(s)) { return '支付宝'; }
    if (/银行卡|储蓄卡|信用卡|银联/.test(s)) { return '银行卡'; }
    if (/现金/.test(s)) { return '现金'; }
    return '';
  }

  /**
   * 解析小票 OCR 文本。
   * @param {string} text
   * @param {Date} [now] 补年份用（便于测试）
   * @return {{ok:boolean, amount?:number, merchant?:string, date?:string, payMethod?:string,
   *           confidence?:string, raw:string, reason?:string, label?:string}}
   */
  function parseReceipt(text, now) {
    var raw = String(text === undefined || text === null ? '' : text);
    if (!raw.trim()) {
      return { ok: false, reason: '未识别到金额', raw: raw };
    }
    var normalized = normalizeWidth(raw);
    var amountInfo = extractAmount(normalized);
    if (!amountInfo || !amountInfo.amount) {
      return { ok: false, reason: '未识别到金额', raw: raw };
    }

    var merchantInfo = extractMerchant(normalized);
    var dateInfo = extractDate(normalized, now);
    var payMethod = extractPayMethod(normalized);

    var confidence;
    if (amountInfo.label && dateInfo.full) {
      confidence = 'high';
    } else if (amountInfo.label) {
      confidence = 'medium';
    } else if (!amountInfo.byMax && dateInfo.date) {
      confidence = 'medium';
    } else {
      confidence = 'low';
    }

    /* 识别出的日期比「去年」还早：多半是小票年份印错或截图里混进了旧订单号。
       保留原值但降一档置信度并给出提示，不静默接受。 */
    var dateWarn = '';
    if (dateInfo.date) {
      var base = (now instanceof Date) ? now : new Date();
      var year = Number(String(dateInfo.date).slice(0, 4));
      if (isFinite(year) && year < base.getFullYear() - 1) {
        dateWarn = '识别到的日期较早（' + dateInfo.date + '），请核对';
        if (confidence === 'high') { confidence = 'medium'; }
        else if (confidence === 'medium') { confidence = 'low'; }
      }
    }

    return {
      ok: true,
      amount: amountInfo.amount,
      merchant: merchantInfo.merchant,
      date: dateInfo.date,
      payMethod: payMethod,
      confidence: confidence,
      dateWarn: dateWarn,
      label: amountInfo.label,
      raw: raw
    };
  }

  /* ================================================================== */
  /* 凭据管理（localStorage key: ai_jizhang_ocr）                        */
  /* ================================================================== */

  function getStorage() {
    try {
      if (global && global.localStorage) { return global.localStorage; }
    } catch (e) {
      return null;
    }
    return null;
  }

  /** @return {{secretId:string, secretKey:string, region:string}} */
  function getCredentials() {
    var store = getStorage();
    if (store) {
      try {
        var raw = store.getItem(CRED_KEY);
        if (raw) {
          var obj = JSON.parse(raw);
          if (obj && typeof obj === 'object') {
            return {
              secretId: String(obj.secretId || ''),
              secretKey: String(obj.secretKey || ''),
              region: String(obj.region || 'ap-guangzhou')
            };
          }
        }
      } catch (e) {
        // 读失败 → 用内存副本
      }
    }
    return {
      secretId: memCred.secretId,
      secretKey: memCred.secretKey,
      region: memCred.region || 'ap-guangzhou'
    };
  }

  /**
   * 保存凭据（只存本机浏览器，仅本地调用）。
   * @param {{secretId:string, secretKey:string, region:string}} cred
   * @return {boolean} 是否成功写入 localStorage
   */
  function saveCredentials(cred) {
    var obj = {
      secretId: String((cred && cred.secretId) || ''),
      secretKey: String((cred && cred.secretKey) || ''),
      region: String((cred && cred.region) || 'ap-guangzhou')
    };
    memCred = obj;
    var store = getStorage();
    if (!store) { return false; }
    try {
      store.setItem(CRED_KEY, JSON.stringify(obj));
      return true;
    } catch (e) {
      return false;
    }
  }

  /** 清除凭据 */
  function clearCredentials() {
    memCred = { secretId: '', secretKey: '', region: 'ap-guangzhou' };
    var store = getStorage();
    if (!store) { return true; }
    try {
      store.removeItem(CRED_KEY);
      return true;
    } catch (e) {
      return false;
    }
  }

  /** 是否已配置可用凭据 */
  function hasCredentials() {
    var c = getCredentials();
    return !!(c.secretId && c.secretKey);
  }

  /** 当前能力矩阵（UI 用） */
  function capabilities() {
    var native = (typeof global !== 'undefined' && typeof global.TextDetector === 'function');
    var cloud = hasCredentials();
    return {
      native: native,
      cloud: cloud,
      demo: true,
      recommended: native ? 'native' : (cloud ? 'cloud' : 'demo')
    };
  }

  /* ================================================================== */
  /* ① 浏览器原生识别（零网络）                                          */
  /* ================================================================== */

  /**
   * @param {Blob|File} file
   * @return {Promise<{ok:boolean, source:string, text:string, reason:string}>}
   */
  function detectNative(file) {
    return new Promise(function (resolve) {
      var TD = (typeof global !== 'undefined') ? global.TextDetector : null;
      var createBitmap = (typeof global !== 'undefined') ? global.createImageBitmap : null;
      if (typeof TD !== 'function') {
        resolve({ ok: false, source: 'native', text: '', reason: '当前浏览器不支持本地文字识别（TextDetector）' });
        return;
      }
      if (typeof createBitmap !== 'function' || !file) {
        resolve({ ok: false, source: 'native', text: '', reason: '无法读取图片（需要可用的图片文件）' });
        return;
      }
      var bitmapPromise;
      try {
        bitmapPromise = createBitmap(file);
      } catch (e) {
        resolve({ ok: false, source: 'native', text: '', reason: '图片解码失败：' + errorMessage(e) });
        return;
      }
      bitmapPromise.then(function (bitmap) {
        var detector;
        try {
          detector = new TD();
        } catch (e) {
          return { ok: false, source: 'native', text: '', reason: '本地识别器初始化失败：' + errorMessage(e) };
        }
        return detector.detect(bitmap).then(function (items) {
          var texts = [];
          var i;
          for (i = 0; i < (items || []).length; i++) {
            if (items[i] && items[i].rawValue) { texts.push(String(items[i].rawValue)); }
          }
          if (texts.length === 0) {
            return { ok: false, source: 'native', text: '', reason: '本地识别没有读到文字' };
          }
          return { ok: true, source: 'native', text: texts.join('\n'), reason: '' };
        });
      }).then(function (result) {
        resolve(result);
      }).catch(function (err) {
        resolve({ ok: false, source: 'native', text: '', reason: '本地识别失败：' + errorMessage(err) });
      });
    });
  }

  /* ================================================================== */
  /* ② 云 OCR（腾讯云 GeneralBasicOCR / TC3-HMAC-SHA256）                */
  /* ================================================================== */

  function utf8Bytes(str) {
    return new TextEncoder().encode(String(str));
  }

  function toHex(buffer) {
    var bytes = new Uint8Array(buffer);
    var out = '';
    var i;
    for (i = 0; i < bytes.length; i++) {
      var h = bytes[i].toString(16);
      out += h.length === 1 ? '0' + h : h;
    }
    return out;
  }

  function sha256Hex(input) {
    var data = (typeof input === 'string') ? utf8Bytes(input) : input;
    return global.crypto.subtle.digest('SHA-256', data).then(function (buf) {
      return toHex(buf);
    });
  }

  function hmacSha256(keyBytes, msg) {
    return global.crypto.subtle.importKey(
      'raw', keyBytes, { name: 'HMAC', hash: { name: 'SHA-256' } }, false, ['sign']
    ).then(function (key) {
      return global.crypto.subtle.sign('HMAC', key, utf8Bytes(msg));
    }).then(function (sig) {
      return new Uint8Array(sig);
    });
  }

  /**
   * 构造腾讯云 TC3-HMAC-SHA256 签名所需 Header。
   * @param {{secretId:string, secretKey:string, region:string, payload:string}} opts
   * @return {Promise<Object>} fetch headers
   */
  function buildTc3Headers(opts) {
    var secretId = opts.secretId;
    var secretKey = opts.secretKey;
    var region = opts.region || 'ap-guangzhou';
    var payload = opts.payload;
    var timestamp = Math.floor(Date.now() / 1000);
    var d = new Date(timestamp * 1000);
    var date = d.getUTCFullYear() + '-' + pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate());
    var actionLower = CLOUD_ACTION.toLowerCase();
    var contentType = 'application/json; charset=utf-8';
    var signedHeaders = 'content-type;host;x-tc-action';
    var canonicalHeaders = 'content-type:' + contentType + '\n' +
      'host:' + CLOUD_HOST + '\n' +
      'x-tc-action:' + actionLower + '\n';
    var canonicalRequest = 'POST\n/\n\n' + canonicalHeaders + '\n' + signedHeaders + '\n';
    var credentialScope = date + '/' + CLOUD_SERVICE + '/tc3_request';

    return sha256Hex(payload).then(function (hashedPayload) {
      var fullCanonical = canonicalRequest + hashedPayload;
      return sha256Hex(fullCanonical);
    }).then(function (hashedCanonical) {
      var stringToSign = 'TC3-HMAC-SHA256\n' + timestamp + '\n' + credentialScope + '\n' + hashedCanonical;
      return hmacSha256(utf8Bytes('TC3' + secretKey), date).then(function (secretDate) {
        return hmacSha256(secretDate, CLOUD_SERVICE);
      }).then(function (secretService) {
        return hmacSha256(secretService, 'tc3_request');
      }).then(function (secretSigning) {
        return hmacSha256(secretSigning, stringToSign);
      }).then(function (signatureBytes) {
        var signature = toHex(signatureBytes);
        var authorization = 'TC3-HMAC-SHA256 Credential=' + secretId + '/' + credentialScope +
          ', SignedHeaders=' + signedHeaders + ', Signature=' + signature;
        return {
          'Content-Type': contentType,
          'Host': CLOUD_HOST,
          'X-TC-Action': CLOUD_ACTION,
          'X-TC-Version': CLOUD_VERSION,
          'X-TC-Timestamp': String(timestamp),
          'X-TC-Region': region,
          'Authorization': authorization
        };
      });
    });
  }

  /**
   * 云 OCR 识别。未配置凭据 / 无图片时立即返回结构化错误，不做任何网络请求。
   * @param {string} dataUrl 'data:image/png;base64,...'
   * @return {Promise<{ok:boolean, source:string, text:string, reason:string}>}
   */
  function detectCloud(dataUrl) {
    var cred = getCredentials();
    if (!cred.secretId || !cred.secretKey) {
      return Promise.resolve({
        ok: false,
        source: 'cloud',
        text: '',
        reason: '还没有配置云 OCR 凭据，云端识别不可用'
      });
    }
    if (!dataUrl || typeof dataUrl !== 'string' || dataUrl.indexOf('base64,') === -1) {
      return Promise.resolve({
        ok: false,
        source: 'cloud',
        text: '',
        reason: '没有可识别的图片数据，请重新选择图片'
      });
    }
    if (typeof global.fetch !== 'function') {
      return Promise.resolve({ ok: false, source: 'cloud', text: '', reason: '当前环境不支持网络请求' });
    }
    if (!global.crypto || !global.crypto.subtle) {
      return Promise.resolve({
        ok: false,
        source: 'cloud',
        text: '',
        reason: '当前浏览器不支持 Web Crypto，无法签名，云端识别不可用'
      });
    }

    var base64 = dataUrl.split('base64,')[1] || '';
    var payload = JSON.stringify({ ImageBase64: base64 });
    var headers;

    return buildTc3Headers({
      secretId: cred.secretId,
      secretKey: cred.secretKey,
      region: cred.region,
      payload: payload
    }).then(function (h) {
      headers = h;
      return global.fetch(CLOUD_ENDPOINT, {
        method: 'POST',
        headers: headers,
        body: payload
      });
    }).then(function (resp) {
      if (!resp || !resp.json) {
        return { ok: false, source: 'cloud', text: '', reason: '云端返回格式异常' };
      }
      return resp.json().then(function (json) {
        var r = json && json.Response ? json.Response : null;
        if (!r) {
          return { ok: false, source: 'cloud', text: '', reason: '云端返回为空' };
        }
        if (r.Error) {
          return {
            ok: false,
            source: 'cloud',
            text: '',
            reason: '云端识别失败：' + (r.Error.Message || r.Error.Code || '未知错误')
          };
        }
        var detections = r.TextDetections || [];
        var texts = [];
        var i;
        for (i = 0; i < detections.length; i++) {
          if (detections[i] && detections[i].DetectedText) {
            texts.push(String(detections[i].DetectedText));
          }
        }
        if (texts.length === 0) {
          return { ok: false, source: 'cloud', text: '', reason: '云端没有识别到文字' };
        }
        return { ok: true, source: 'cloud', text: texts.join('\n'), reason: '' };
      });
    }).catch(function (err) {
      return {
        ok: false,
        source: 'cloud',
        text: '',
        reason: '云端识别失败，可能是跨域限制或网络问题，已保留手动录入入口（' + errorMessage(err) + '）'
      };
    });
  }

  /**
   * 走 WorkBuddy 云服务视觉大模型识别截图文字（免密钥，由 app.js 注入 global.AJ.visionOcr）。
   * 与 detectCloud 返回同一套结构化结果；任何失败都返回 ok:false，便于上层降级。
   * @param {string} dataUrl 'data:image/png;base64,...'
   * @return {Promise<{ok:boolean, source:string, text:string, reason:string}>}
   */
  function detectBackend(dataUrl) {
    if (!dataUrl || typeof dataUrl !== 'string' || dataUrl.indexOf('base64,') === -1) {
      return Promise.resolve({
        ok: false,
        source: 'backend',
        text: '',
        reason: '没有可识别的图片数据'
      });
    }
    if (typeof global.AJ === 'object' && typeof global.AJ.visionOcr === 'function') {
      return global.AJ.visionOcr(dataUrl);
    }
    return Promise.resolve({
      ok: false,
      source: 'backend',
      text: '',
      reason: 'WorkBuddy 云服务未连接（请用 python server.py 启动本页并确认能联网）'
    });
  }

  /**
   * 按开关选择云端识别实现：
   *   - 启用了后端 OCR（global.AJ_BACKEND_OCR 为真，即由 server.py 托管页面）走 WorkBuddy 云服务视觉模型
   *   - 否则保留浏览器直连腾讯云 detectCloud（用 file:// 直接打开页面时）
   */
  function cloudDetect(dataUrl) {
    return (global && global.AJ_BACKEND_OCR) ? detectBackend(dataUrl) : detectCloud(dataUrl);
  }

  /* ================================================================== */
  /* ③ 演示模式                                                          */
  /* ================================================================== */

  /**
   * @param {number} index 0-2
   * @param {Date} [now] 用于生成演示样例里的日期
   * @return {{ok:boolean, source:string, text:string, reason:string, sample:Object}}
   */
  function detectDemo(index, now) {
    var samples = buildSamples(now);
    var i = Number(index);
    if (!isFinite(i) || i < 0 || i >= samples.length) { i = 0; }
    var sample = samples[i];
    return {
      ok: true,
      source: 'demo',
      text: sample.text,
      reason: '',
      sample: { id: sample.id, title: sample.title, expect: sample.expect }
    };
  }

  /* ================================================================== */
  /* 统一入口                                                            */
  /* ================================================================== */

  /**
   * auto 模式下三层（原生 / 云 / 演示）全部不可用时给用户看的总说明。
   * 演示样例（demo）**只能由用户显式选择**（mode:'demo' 或点示例小票）触发，
   * auto 分支绝不再回落到 demo —— 否则用户上传自己的截图会被"识别"成
   * 内置样例的金额和商户，看起来像真的识别成功，属于最严重的信任问题。
   */
  var NO_CAPABILITY_REASON = '当前浏览器没有可用的文字识别能力：Windows 版 Chrome 不支持本地文字识别' +
    '（TextDetector），且 WorkBuddy 云服务也未连接。请用线上版本打开本应用以启用视觉识别，' +
    '或点下面的「示例小票」看演示效果，或直接手动录入。';

  /**
   * 构造结构化失败结果。text 恒为空字符串，绝不携带任何示例文本。
   * @param {string} reason 面向用户的说明
   * @param {Array<string>} tried 尝试/考察过的层（'native' | 'cloud'）
   * @param {Array<string>} details 各层原始原因（面向开发/排查）
   * @return {{ok:boolean, source:string, text:string, reason:string, tried:Array<string>, details:Array<string>}}
   */
  function failureResult(reason, tried, details) {
    return {
      ok: false,
      source: 'none',
      text: '',
      reason: reason,
      tried: (tried || []).slice(),
      details: (details || []).slice()
    };
  }

  /**
   * 拼接 auto 模式失败说明：分「本地失败 / 云端失败 / 都失败」三种口径，
   * 并把各层原始 reason 带上，便于用户和我们自己判断到底卡在哪。
   * @param {string} nativeReason 本地层失败原因（未尝试时传空串）
   * @param {string} cloudReason 云端层失败原因（未尝试时传空串）
   * @return {string}
   */
  function composeFailureReason(nativeReason, cloudReason) {
    var head;
    if (nativeReason && cloudReason) {
      head = '本地识别和云端识别都没有成功，所以没能识别这张截图。';
    } else if (cloudReason) {
      head = '云端识别没有成功，所以没能识别这张截图。';
    } else if (nativeReason) {
      head = '本地识别没有成功，也没有可用的云端识别（WorkBuddy 云服务未连接），所以没能识别这张截图。';
    } else {
      head = NO_CAPABILITY_REASON;
    }
    var parts = [];
    if (nativeReason) { parts.push('本地：' + nativeReason); }
    if (cloudReason) { parts.push('云端：' + cloudReason); }
    var detail = parts.length > 0 ? '（' + parts.join('；') + '）' : '';
    return head + detail + '可以点「用示例小票演示」看流程，或直接手动录入。';
  }

  /**
   * 三层降级的统一识别入口。**永不 reject**，失败也返回结构化对象。
   *
   * 重要：mode:'auto' 在没有可用识别能力时返回 ok:false / source:'none'，
   * 不会返回演示样例。演示样例只走 mode:'demo'。
   *
   * @param {{mode?:string, file?:Object, dataUrl?:string, demoIndex?:number, now?:Date}} [opts]
   *        mode: 'auto'（默认）| 'native' | 'cloud' | 'demo'
   * @return {Promise<{ok:boolean, source:string, text:string, reason:string, tried?:Array<string>}>}
   */
  function detect(opts) {
    var o = opts || {};
    var mode = o.mode || 'auto';

    return Promise.resolve().then(function () {
      /* 显式演示入口：用户主动点示例小票时走这里，路径保持不变 */
      if (mode === 'demo') { return detectDemo(o.demoIndex, o.now); }
      if (mode === 'native') { return detectNative(o.file); }
      if (mode === 'cloud') { return cloudDetect(o.dataUrl); }

      var nativeAvailable = (typeof global !== 'undefined' && typeof global.TextDetector === 'function');
      /* 云端可用性：旧版「腾讯云 OCR 凭据」或新版「WorkBuddy 云服务视觉识别」二者其一即可。
         注意：hasCredentials() 只认腾讯云凭据；现在截图识别走 WorkBuddy 云服务（免密钥），
         只要 app.js 已注入 global.AJ.visionOcr 就视为云端可用 —— 否则 auto 模式永远走不到云端。 */
      var wbCloudFn = (typeof global !== 'undefined' && global.AJ && typeof global.AJ.visionOcr === 'function');
      var cloudAvailable = !!o.dataUrl && (hasCredentials() || (global.AJ_BACKEND_OCR && wbCloudFn));

      /* 已配云端但没拿到图片数据：说明问题在图片，不在能力 */
      if (!nativeAvailable && hasCredentials() && !o.dataUrl) {
        return failureResult(
          '没有可用的图片数据，没法调用云端识别。请重新选择一张截图，或直接用示例小票 / 手动录入。',
          ['cloud'],
          ['没有可识别的图片数据']
        );
      }

      /* 三层里没有一层可用：直说不可用，绝不拿示例数据冒充识别结果 */
      if (!nativeAvailable && !cloudAvailable) {
        return failureResult(NO_CAPABILITY_REASON, ['native', 'cloud'], []);
      }

      /**
       * 本地不可用 / 本地失败后走云端；云端也失败则返回失败。
       * @param {string} nativeReason 本地层失败原因（本地根本不可用时为空串）
       * @return {Promise<Object>}
       */
      function tryCloud(nativeReason) {
        if (!cloudAvailable) {
          var triedLocal = nativeReason ? ['native'] : ['native', 'cloud'];
          var detailsLocal = nativeReason ? [nativeReason] : [];
          return Promise.resolve(
            failureResult(composeFailureReason(nativeReason, ''), triedLocal, detailsLocal)
          );
        }
        return cloudDetect(o.dataUrl).then(function (cloudRes) {
          if (cloudRes && cloudRes.ok) { return cloudRes; }
          var cloudReason = (cloudRes && cloudRes.reason) || '云端识别没有返回结果';
          var tried = nativeReason ? ['native', 'cloud'] : ['cloud'];
          var details = nativeReason ? [nativeReason, cloudReason] : [cloudReason];
          return failureResult(composeFailureReason(nativeReason, cloudReason), tried, details);
        });
      }

      if (!nativeAvailable) {
        /* 没有原生识别：只可能走云端 */
        return tryCloud('');
      }

      /* 有原生识别：先本地，本地失败再考虑云端，两者都失败 → 返回失败 */
      return detectNative(o.file).then(function (res) {
        if (res && res.ok) { return res; }
        return tryCloud((res && res.reason) || '本地识别没有返回结果');
      });
    }).catch(function (err) {
      return failureResult(
        '识别流程出现异常：' + errorMessage(err) + '，不是你操作的问题，可以直接手动录入。',
        [],
        [errorMessage(err)]
      );
    });
  }

  var API = {
    buildSamples: buildSamples,
    formatDay: formatDay,
    CRED_KEY: CRED_KEY,
    parseReceipt: parseReceipt,
    extractAmount: extractAmount,
    extractMerchant: extractMerchant,
    extractDate: extractDate,
    extractPayMethod: extractPayMethod,
    detect: detect,
    detectNative: detectNative,
    detectCloud: detectCloud,
    detectBackend: detectBackend,
    cloudDetect: cloudDetect,
    detectDemo: detectDemo,
    hasCredentials: hasCredentials,
    getCredentials: getCredentials,
    saveCredentials: saveCredentials,
    clearCredentials: clearCredentials,
    capabilities: capabilities,
    buildTc3Headers: buildTc3Headers,
    normalizeWidth: normalizeWidth
  };

  /* SAMPLES 用 getter 暴露：每次访问都以「今天」为基准重新构造，
     避免页面长期开着或写死日期导致演示样例的日期过期。 */
  Object.defineProperty(API, 'SAMPLES', {
    enumerable: true,
    get: function () { return buildSamples(new Date()); }
  });

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.ocr = API;
  }
})(typeof globalThis !== 'undefined' ? globalThis : this);

  </script>
  <!-- 意图路由与模糊兜底层（只依赖 data.js + nlp.js，必须在 app.js 之前） -->
<script>
/**
 * intent.js — 会话意图分类层 + 模糊兜底文案引擎（纯函数，可 Node 直接测试）
 *
 * 设计依据：「意图路由与模糊兜底设计方案.md」
 *   §2.1 意图枚举 / §2.2 18 个信号判据 / §2.3 权重矩阵 / §2.4 仲裁规则（V1-V4 + R1/R3a/R3b）
 *   §2.5 classifyIntent 伪代码 / §3.2 L0-L5 阶梯文案 / §3.3 pending 状态机 / §3.4 反死循环硬规则
 *
 * 对外主函数：
 *   classifyIntent(text, ctx)        -> Result
 *   detectSignals(text, ctx)         -> {SIG_XXX:boolean}
 *   extractSlots(text, signals, ctx) -> Slots
 *   scoreIntents(signals)            -> {record, query, howto, advice, dataop, chitchat}
 *   applyVeto(scores, signals)       -> scores（V1-V4 之后）
 *   arbitrate(scores, signals, slots)-> {intent, score, second, confidence, margin, tier}
 *   rankIntents(scores)              -> [{intent, score}] 降序
 *   resolveQueryKind(signals, slots) -> 'balance'|'pie'|'category'|'detail'|null
 *   missingSlots(intent, slots)      -> string[]
 *   resolveLevel(pending, intent, missing) -> {level, formType, promptKey, allowed}
 *   mustEscalate(promptKey, recentKeys)    -> boolean（同 isAntiLoopViolation）
 *   buildPrompt(state, viewCtx)      -> {html, promptKey, formType, level}（只产出 HTML 片段，不碰 DOM）
 *   amountHints(slots, viewCtx)      -> [{label, value, source}]
 *   mergeVerdict(local, verdict)     -> Result（云端只在本地 top2 内改判）
 *
 * 约束（硬性）：
 *   1) 只用 ES5 语法（var / function / 字符串拼接）；禁止 ES6 声明关键字、箭头函数、
 *      模板字符串、class、解构，以及 includes / padStart 这类新方法；
 *   2) 零第三方依赖，只 require('./data.js') 与 require('./nlp.js')；
 *   3) 双导出：Node 用 module.exports，浏览器挂到 global.AJ.intent（写法照抄 nlp.js）。
 */
(function (global) {
  'use strict';

  var isNode = (typeof module !== 'undefined' && module.exports);
  var DATA, NLP;
  if (isNode) {
    DATA = require('./data.js');
    NLP = require('./nlp.js');
  } else {
    global.AJ = global.AJ || {};
    DATA = global.AJ.data;
    NLP = global.AJ.nlp;
  }

  /* ================================================================== */
  /* 一、常量（全部导出，便于单测逐格断言）                              */
  /* ================================================================== */

  /** 7 个顶层意图（command 由 app.js 的 commandMatch 在分类之前短路，不在此枚举内） */
  var INTENTS = ['record', 'query', 'howto', 'advice', 'dataop', 'chitchat', 'unknown'];

  /** 平手时的稳定排序依据（record 优先，保证「什么都不像」时偏向记账缺槽位） */
  var INTENT_ORDER = INTENTS;

  /** 每个意图的必需槽位（缺则走 L2 / L3 澄清） */
  var REQUIRED_SLOTS = {
    record: ['amount'],
    query: ['queryKind'],
    dataop: ['target'],
    howto: [],
    advice: [],
    chitchat: [],
    unknown: []
  };

  /* ---- 仲裁阈值（§2.4 常量，照抄，不做二次拍脑袋） ---- */
  var SCORE_LOW = 30;             // 低于此分且无兜底证据 -> unknown
  var SCORE_HIGH = 55;            // 高置信线（保留常量，供调参）
  var MARGIN_MIN = 15;            // 冠军与亚军的最小分差
  var CONF_HIGH = 0.75;
  var CONF_LOW = 0.45;
  var RECORD_DOMINANCE = 0.70;    // record 单极豁免
  var FORCE_RECORD_MIN = 70;      // 「带金额 + 无疑问」强制 record 的下限

  /** pending 单轮待补全上下文的存活时间（毫秒）：刷新即清空，刻意不写 localStorage */
  var PENDING_TTL_MS = 120000;
  var MAX_TRIES = 3;
  var LEVELS = [0, 1, 2, 3, 4, 5];

  /** 阶梯层 -> 交互形式 */
  var FORM_OF_LEVEL = {
    0: 'confirm', 1: 'infer', 2: 'chip_group', 3: 'form', 4: 'choice', 5: 'giveup'
  };

  /** 反死循环硬规则（§3.4） */
  var ANTI_LOOP = {
    SAME_PROMPT_FORBIDDEN: true,   // 同一 promptKey 不得连续出现两次
    MAX_TRIES: 3,                  // tries>=3 禁止再追问
    FORCE_FORM_CHANGE_AT: 2        // tries>=2 必须换 formType（按钮 -> 表单/选择）
  };

  /**
   * 权重矩阵：信号 × 意图（正整数加分 / 负整数扣分）。
   * §2.3 数字逐个照抄，可被单测逐格断言；只允许调参，不允许改结构。
   */
  var WEIGHTS = {
    SIG_AMOUNT:       { record: 62, query: 0, howto: 0, advice: 6, dataop: -10, chitchat: -15 },
    SIG_AMOUNT_FUZZY: { record: 26, query: 4, howto: 2, advice: 4, dataop: -8, chitchat: 0 },
    SIG_SPEND_VERB:   { record: 30, query: 0, howto: 0, advice: 0, dataop: 6, chitchat: -6 },
    SIG_PLAN_VERB:    { record: 16, query: 2, howto: 2, advice: 12, dataop: 0, chitchat: 4 },
    SIG_TIME_PAST:    { record: 10, query: 8, howto: 6, advice: 0, dataop: 6, chitchat: 0 },
    SIG_CATEGORY:     { record: 18, query: 10, howto: 0, advice: 2, dataop: 0, chitchat: 0 },
    SIG_HOWTO:        { record: -55, query: 10, howto: 58, advice: 8, dataop: 6, chitchat: 0 },
    SIG_YESNO:        { record: -28, query: 12, howto: 20, advice: 6, dataop: 0, chitchat: 0 },
    SIG_WH:           { record: -22, query: 26, howto: 16, advice: 6, dataop: 0, chitchat: 0 },
    SIG_QMARK:        { record: -12, query: 8, howto: 10, advice: 4, dataop: 0, chitchat: 0 },
    SIG_Q_BALANCE:    { record: -25, query: 64, howto: 0, advice: 0, dataop: 0, chitchat: 0 },
    SIG_Q_PIE:        { record: -25, query: 60, howto: 0, advice: 0, dataop: 0, chitchat: 0 },
    SIG_Q_STAT:       { record: -18, query: 44, howto: 0, advice: 0, dataop: 0, chitchat: 0 },
    SIG_ANAPHORA:     { record: -10, query: 14, howto: 4, advice: 0, dataop: 12, chitchat: 0 },
    SIG_DATAOP:       { record: -34, query: 6, howto: 8, advice: 0, dataop: 60, chitchat: 0 },
    SIG_EMOTION:      { record: -12, query: 0, howto: 0, advice: 4, dataop: 0, chitchat: 42 },
    SIG_ADVICE:       { record: -12, query: 0, howto: 4, advice: 46, dataop: 0, chitchat: 4 },
    SIG_EMPTY:        { record: -60, query: -60, howto: -60, advice: -60, dataop: -60, chitchat: 50 }
  };

  /* ================================================================== */
  /* 二、词表（内聚在本模块，不污染 data.js，保证可独立单测）            */
  /* ================================================================== */

  var LEX = {
    /** 怎么办式求助 */
    HOW_TO: ['怎么办', '咋办', '怎么弄', '怎么搞', '如何', '怎么补', '怎么改', '怎么删',
      '教我', '能不能补', '忘记记', '漏记'],
    /** 求助的具体话题（补记 / 改 / 删 / 找不到入口） */
    HOWTO_TOPIC: [
      { topic: 'backfill', words: ['补', '忘记', '漏', '补记'] },
      { topic: 'edit', words: ['改', '修改'] },
      { topic: 'delete', words: ['删', '撤销', '撤回'] },
      { topic: 'where', words: ['在哪', '哪里', '怎么打开'] }
    ],
    /** 是否式疑问 */
    YES_NO: ['吗', '能不能', '可不可以', '是不是', '行不行', '有没有', '贵吗', '划算吗'],
    /** 疑问词（刻意不含「怎么」，归 HOW_TO，避免双重计数） */
    WH_WORDS: ['多少', '几', '哪', '啥', '什么', '为什么', '咋'],
    /** 余额查询 */
    Q_BALANCE: ['余额', '还剩', '还能花', '剩多少', '够花'],
    /** 结构查询 */
    Q_PIE: ['饼图', '占比', '结构', '大头', '花在哪些', '分布'],
    /** 统计查询（强证据） */
    Q_STAT: ['花了多少', '一共花', '总共花', '这周花', '本月花', '上个月花'],
    /** 统计查询（弱证据：必须配合查询对象才成立，「帮我看看」不能算查询） */
    Q_STAT_WEAK: ['统计', '汇总', '查一下', '看看'],
    /** 明细查询 */
    QUERY_DETAIL: ['那笔', '这笔', '哪笔', '明细', '记录', '刚才那笔'],
    /** 改 / 删 / 撤 */
    DATA_OP: ['改一下', '修改', '改掉', '改成', '改为', '删掉', '删除', '删了', '撤销', '撤回', '取消', '记错', '应该是', '输错', '录错', '写错', '打错', '不是这个', '不对'],
    /** 纠错（改金额）：刻意不含「不对」「不是」，避免与「对不对/是不是」疑问相撞 */
    CORRECTION: ['记错', '改成', '应该是', '写错', '输错', '录错', '打错', '改一下', '修改'],
    /** 指代（刻意不含「这个」：会与「这个月」撞车，误判成指代） */
    ANAPHORA: ['那笔', '这笔', '那个', '它', '刚才那', '上一条', '上一笔'],
    /** 情绪词（补集：DATA.EMOTION_KEYWORDS 是「情绪型消费」，这里是「人本身的心情」） */
    MOOD: ['累', '烦', 'emo', '难受', '难过', '焦虑', '穷', '吃土', '压力', '崩溃', '无语',
      '开心', '爽', '烦死', '心累', '烦躁'],
    /** 求建议 */
    ADVICE: ['想买', '该不该', '值不值', '要不要', '值得吗', '怎么省', '省钱', '剁手', '忍不住', '冲动'],
    /** 求建议：省钱向 */
    ADVICE_SAVE: ['怎么省', '省钱', '少花', '节流', '省点'],
    /** 求建议：赚钱向 */
    ADVICE_EARN: ['赚钱', '搞钱', '兼职', '攒钱', '开源'],
    /** 已发生消费动词（刻意不含裸「吃/喝/买」，否则与计划语气冲突） */
    SPEND_VERB: ['买了', '花了', '付了', '充了', '交了', '吃了', '喝了', '下单了', '打车', '转账', '请客'],
    /** 计划语气 */
    PLAN_VERB: ['想买', '要买', '要去', '打算', '准备', '计划', '约', '明天', '后天', '下周',
      '周末', '一会', '待会'],
    /** 模糊金额（区间词优先，修饰词次之） */
    FUZZY_AMOUNT: ['十几', '几十', '百来', '小一百', '差不多', '大概', '大约', '左右', '不到',
      '半百', '一杯', '一顿'],
    /** 时间范围（用于查询聚合口径） */
    PERIOD: [
      { period: 'today', words: ['今天', '今日', '今天花'] },
      { period: 'week', words: ['这周', '本周', '一周', '这星期'] },
      { period: 'week', words: ['上周', '上星期'] },
      { period: 'month', words: ['这个月', '本月', '这月'] },
      { period: 'lastMonth', words: ['上个月', '上月'] },
      { period: 'all', words: ['一共', '总共', '累计'] }
    ],
    /** 问候短路（同时是 R3b 的守卫：防止把「你好」问成「你好多少钱」） */
    GREETING: ['你好', '您好', '嗨', 'hi', 'hello', '在吗', '在不在', '在么', '谢谢', '谢啦',
      '好的', '好嘞', '收到', '晚安', '早上好', '早', '哈喽', '嘿嘿', '嗯嗯']
  };

  /** 模糊金额区间表（可解释来源：文本里的模糊量词） */
  var FUZZY_RANGES = [
    { label: '十几', min: 10, max: 19, guess: 15 },
    { label: '几十', min: 20, max: 99, guess: 40 },
    { label: '小一百', min: 80, max: 100, guess: 99 },
    { label: '百来', min: 80, max: 120, guess: 100 },
    { label: '半百', min: 40, max: 60, guess: 50 }
  ];

  /** 模糊金额修饰词（无区间，仅表示不精确） */
  var FUZZY_MODIFIERS = ['差不多', '大概', '大约', '左右', '不到', '一杯', '一顿'];

  /** 饮品词：用于金额建议的「同品类参考价」 */
  var DRINK_WORDS = ['奶茶', '咖啡', '饮料', '果茶', '豆浆', '柠檬水', '可乐', '雪糕', '冰淇淋'];

  /** 冷启动金额建议（无历史数据时的可解释参考价；有历史时优先用近 30 天均值） */
  var DEFAULT_HINTS = {
    '餐饮': [10, 15, 20],
    '社交': [60, 80, 120],
    '购物': [30, 60, 100],
    '学习': [10, 20, 50],
    '交通': [3, 10, 20],
    '娱乐': [20, 50, 100],
    '居住': [50, 100, 200],
    '医疗': [10, 30, 80],
    '其他': [6, 10, 15]
  };

  /** 餐段参考价（比品类更精确时优先） */
  var MEAL_HINTS = {
    '早餐': [4, 6, 10],
    '午餐': [10, 15, 20],
    '晚餐': [12, 18, 25],
    '夜宵': [10, 20, 30]
  };

  /** 饮品参考价（doc §3.5 的「奶茶」示例：8 / 12 / 18） */
  var DRINK_HINTS = [8, 12, 18];

  /* ================================================================== */
  /* 三、文本预处理                                                      */
  /* ================================================================== */

  var RE_EMOJI = /[\u2190-\u21FF\u2300-\u23FF\u25A0-\u27BF\u2B00-\u2BFF\u3000-\u303F\uFE00-\uFE0F\uFE30-\uFE4F\uFF00-\uFFEF\uD800-\uDBFF\uDC00-\uDFFF]/g;
  var RE_PUNCT = /[\s，。；、,;:!?？!！~～…—\-_+*\/\\|@#$%^&()（）\[\]{}<>《》「」『』"'"'·、]/g;

  /**
   * 全角归一化 + 去首尾空白（1:1 字符替换，不改变语义）。
   * @param {*} text
   * @return {string}
   */
  function normalize(text) {
    var t = (typeof text === 'string') ? text : String(text === undefined || text === null ? '' : text);
    return NLP.normalizeWidth(t).trim();
  }

  /**
   * 去掉 emoji / 标点 / 空白，只留「有信息量」的字符。
   * @param {string} text
   * @return {string}
   */
  function stripNoise(text) {
    return String(text === undefined || text === null ? '' : text)
      .replace(RE_EMOJI, '')
      .replace(RE_PUNCT, '')
      .replace(/\s+/g, '');
  }

  /**
   * 是否「纯标点 / 纯表情 / 只有空白」。
   * @param {string} text
   * @return {boolean}
   */
  function isPurePunct(text) {
    var s = String(text === undefined || text === null ? '' : text);
    var visible = s.replace(/\s+/g, '');
    return visible.length > 0 && stripNoise(s).length === 0;
  }

  /** HTML 转义（intent.js 不依赖 app.js 的 esc） */
  function escHtml(text) {
    return String(text === undefined || text === null ? '' : text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /**
   * 词表命中判定（子串包含）。
   * @param {string} text
   * @param {Array<string>} words
   * @return {boolean}
   */
  function anyHit(text, words) {
    var i;
    for (i = 0; i < words.length; i++) {
      if (text.indexOf(words[i]) !== -1) { return true; }
    }
    return false;
  }

  /**
   * 取第一个命中的词（用于 slots.topic / adviceKind 这类单值槽位）。
   * @param {string} text
   * @param {Array<string>} words
   * @return {?string}
   */
  function firstHit(text, words) {
    var i;
    for (i = 0; i < words.length; i++) {
      if (text.indexOf(words[i]) !== -1) { return words[i]; }
    }
    return null;
  }

  /**
   * 问候短路。只认「整句就是一个问候」或「问候 + 1 个字」，
   * 避免「谢谢，午饭15」这类正常记账句被误判为闲聊。
   * @param {string} text
   * @return {boolean}
   */
  function isGreeting(text) {
    var s = stripNoise(text);
    if (!s) { return false; }
    if (s.length > 6) { return false; }
    var i;
    for (i = 0; i < LEX.GREETING.length; i++) {
      var g = LEX.GREETING[i];
      if (s === g) { return true; }
      if (s.indexOf(g) === 0 && (s.length - g.length) <= 1) { return true; }
    }
    return false;
  }

  /**
   * 规范类目名（去掉「其他」）。
   *
   * 背景：NLP.classify 只认「奶茶 / 打车 / 黄焖鸡」这类**口语词**
   * （data.js 的 CATEGORY_KEYWORDS），不认 data.js 里的**规范类目名本身**，
   * 于是「上个月餐饮花了多少」里的「餐饮」被判成「其他」，
   * SIG_CATEGORY 检测不到，queryKind 落到 detail —— 用户问「餐饮花了多少」
   * 拿到的是上月全部账单。这里补一条规范名通道，不动 nlp.js。
   */
  var CANON_KEYS = (function () {
    var src = (DATA && DATA.CATEGORY_KEYS) ? DATA.CATEGORY_KEYS : [];
    var out = [];
    var i;
    for (i = 0; i < src.length; i++) {
      if (src[i] && src[i] !== '其他') { out.push(src[i]); }
    }
    return out;
  })();

  /* ================================================================== */
  /* 四、信号检测（18 个 bool，§2.2）                                    */
  /* ================================================================== */

  /** 统计查询的强正则（「这个月…多少」这类带范围的问法） */
  var RE_Q_STAT_STRONG = /(这个月|这周|本周|上周|上个月|本月).{0,8}(多少|几|花|支出|消费)/;
  /**
   * 模糊量词（含「几」的那些）必须在判疑问词之前剔掉。
   * 否则「十几块的奶茶」里的「几」会被 SIG_WH 当成疑问词，把要记的账抢成查询（P0 丢单）。
   */
  var RE_FUZZY_QTY = /(十几|几十|几百|几千|几万|好几十|好几|[十百千万]\s*几|几\s*[十百千万]|几块|几块钱|几元|第几|几乎|几岁)/g;
  /** 纯时间指代词表（昨天/今天/上周…）。整句剥掉这些词后若什么都不剩，说明只说了一个时间点。 */
  var PURE_TIME_WORDS = ['大前天','大后天','前天','后天','昨天','今天','今日','明天','上星期','上周','下星期','下周','这星期','这周','本周','上个月','上月','下个月','下月','本月','这个月','这月','去年','今年','前年','后年','周末','周','星期','早上','上午','中午','下午','傍晚','晚上','夜里','凌晨','半夜','刚才','刚刚','最近','前一阵','这会儿','那时候','当天'];
  function isPureTimeReference(text) {
    var s = stripNoise(text);
    if (!s || s.length > 12) { return false; }
    var i;
    for (i = 0; i < PURE_TIME_WORDS.length; i++) { s = s.split(PURE_TIME_WORDS[i]).join(''); }
    s = s.replace(/[早中晚上下大个号日月年那会儿刚才最近当天]/g, '');
    return stripNoise(s).length === 0;
  }
  /** 是否式问句的句尾「么」 */
  var RE_YESNO_TAIL = /么$/;
  /** 问号 */
  var RE_QMARK = /[?？]/;

  /**
   * 检测 18 个意图信号。
   * @param {string} text 用户原句
   * @param {Object} [ctx] {now, lastBill, pending}
   * @return {Object<string, boolean>}
   */
  function detectSignals(text, ctx) {
    var t = normalize(text);
    var amounts = NLP.findAmounts(t);
    var hasAmount = amounts.length > 0;
    var category = NLP.classify(t);
    var time = NLP.parseTime(t, (ctx && ctx.now) ? new Date(ctx.now) : new Date());
    var hasMeal = !!time.meal;
    var hasCanon = !!firstHit(t, CANON_KEYS);
    var hasCategory = (category && category !== '其他') || hasMeal || hasCanon;
    var moodHit = anyHit(t, LEX.MOOD);

    var sig = {};
    /* R0：空 / 纯表情（长度 <= 1 或去掉噪声后为空） */
    sig.SIG_EMPTY = (t.length <= 1) || (t.length > 0 && stripNoise(t).length === 0);
    /* 精确金额：不做第二套实现，直接用 NLP.findAmounts */
    sig.SIG_AMOUNT = hasAmount;
    /* 模糊金额：无精确金额 + 区间词/修饰词 */
    sig.SIG_AMOUNT_FUZZY = !hasAmount && hasFuzzyWord(t);
    sig.SIG_SPEND_VERB = anyHit(t, LEX.SPEND_VERB);
    sig.SIG_PLAN_VERB = anyHit(t, LEX.PLAN_VERB);
    sig.SIG_TIME_PAST = time.hasDate;
    sig.SIG_CATEGORY = hasCategory;
    sig.SIG_HOWTO = anyHit(t, LEX.HOW_TO);
    sig.SIG_YESNO = anyHit(t, LEX.YES_NO) || RE_YESNO_TAIL.test(t);
    sig.SIG_WH = anyHit(t.replace(RE_FUZZY_QTY, ''), LEX.WH_WORDS);
    sig.SIG_QMARK = RE_QMARK.test(t);
    sig.SIG_Q_BALANCE = anyHit(t, LEX.Q_BALANCE);
    sig.SIG_Q_PIE = anyHit(t, LEX.Q_PIE);
    sig.SIG_Q_STAT = anyHit(t, LEX.Q_STAT) || anyHit(t, LEX.Q_STAT_WEAK) || RE_Q_STAT_STRONG.test(t);
    sig.SIG_ANAPHORA = anyHit(t, LEX.ANAPHORA);
    sig.SIG_DATAOP = anyHit(t, LEX.DATA_OP);
    sig.SIG_CORRECTION = anyHit(t, LEX.CORRECTION);
    /* 情绪：MOOD 直接成立；DATA.EMOTION_KEYWORDS 是「情绪型消费词」（奶茶/皮肤…），
       只在本句没有任何品类证据时才当作情绪信号，否则「奶茶」会被压成闲聊。
       这是对 §2.2 的一处必要收紧，见回传的「偏离说明」。 */
    sig.SIG_EMOTION = moodHit || (!hasCategory && anyHit(t, DATA.EMOTION_KEYWORDS || []));
    sig.SIG_ADVICE = anyHit(t, LEX.ADVICE);

    /* ---- 以下几个是内部辅助位（不在 18 个里，无权重，不参与打分） ---- */
    sig.SIG_GREET = isGreeting(t);
    sig.SIG_Q_STAT_STRONG = anyHit(t, LEX.Q_STAT) || RE_Q_STAT_STRONG.test(t);
    sig.SIG_MOOD = moodHit;
    return sig;
  }

  /**
   * 是否含模糊金额表达（区间词 / 修饰词）。
   * @param {string} text
   * @return {boolean}
   */
  function hasFuzzyWord(text) {
    var i;
    for (i = 0; i < FUZZY_RANGES.length; i++) {
      if (text.indexOf(FUZZY_RANGES[i].label) !== -1) { return true; }
    }
    for (i = 0; i < FUZZY_MODIFIERS.length; i++) {
      if (text.indexOf(FUZZY_MODIFIERS[i]) !== -1) { return true; }
    }
    return false;
  }

  /**
   * 解析模糊金额，得到可解释的区间与猜测值。
   * @param {string} text
   * @return {?{label:string, min:?number, max:?number, guess:?number}}
   */
  function fuzzyAmountOf(text) {
    var i;
    for (i = 0; i < FUZZY_RANGES.length; i++) {
      if (text.indexOf(FUZZY_RANGES[i].label) !== -1) {
        return {
          label: FUZZY_RANGES[i].label,
          min: FUZZY_RANGES[i].min,
          max: FUZZY_RANGES[i].max,
          guess: FUZZY_RANGES[i].guess
        };
      }
    }
    var mod = firstHit(text, FUZZY_MODIFIERS);
    if (mod) { return { label: mod, min: null, max: null, guess: null }; }
    return null;
  }

  /* ================================================================== */
  /* 五、槽位抽取                                                        */
  /* ================================================================== */

  /**
   * 抽取槽位（先抽全，再按意图求差）。
   * @param {string} text
   * @param {Object} signals detectSignals 的结果
   * @param {Object} [ctx]
   * @return {Object} {amount, amountFuzzy, date, category, meal, plan, target, mood, topic, period, adviceKind, drink, detailHint}
   */
  function extractSlots(text, signals, ctx) {
    var t = normalize(text);
    var sig = signals || detectSignals(t, ctx);
    var now = (ctx && ctx.now) ? new Date(ctx.now) : new Date();
    var slots = {};
    var amounts = NLP.findAmounts(t);
    var time = NLP.parseTime(t, now);
    var category = NLP.classify(t);
    var i;

    if (amounts.length === 0) {
      slots.amount = null;
    } else {
      /* 缺省取第一个金额 */
      slots.amount = NLP.round2(amounts[0].value);
      /* 纠错句（金额>1 个）分辨「被否定的旧值」与「要改成的新值」：
         含「不是」-> 取第一个（「是18不是15」->18）；否则含「应该是/改成/改到」-> 取最后一个（「奶茶18…应该是15」->15） */
      var corr = sig.SIG_CORRECTION === true;
      if (corr && amounts.length > 1) {
        var hasNeg = /不是|而不是/.test(t);
        var hasMark = /应该是|改成|改到/.test(t);
        if (hasNeg) {
          slots.amount = NLP.round2(amounts[0].value);
        } else if (hasMark) {
          slots.amount = NLP.round2(amounts[amounts.length - 1].value);
        }
      }
    }
    slots.amountFuzzy = sig.SIG_AMOUNT_FUZZY ? fuzzyAmountOf(t) : null;
    slots.date = time.hasDate ? time.date : null;
    slots.meal = time.meal || null;
    /* 规范类目名（餐饮/交通/购物…）优先，其次退回 NLP.classify 的口语词判定。
       顺序不能反：「这个月餐饮花了多少」里 classify 返回「其他」，
       只有规范名通道能给出 slots.category，answerCategoryQuery 才不会答非所问。 */
    var canonKey = firstHit(t, CANON_KEYS);
    if (canonKey) {
      slots.category = canonKey;
    } else {
      slots.category = (category && category !== '其他') ? category : null;
    }
    slots.plan = sig.SIG_PLAN_VERB === true;
    slots.target = sig.SIG_ANAPHORA ? 'last' : null;
    /* 纠错（改上一笔金额）：带预算/收入字样不算纠错，避免误改账 */
    slots.correction = sig.SIG_CORRECTION === true && !/预算|收入|工资|生活费/.test(t);
    if (slots.correction) { slots.target = 'last'; }

    /* 情绪 */
    if (sig.SIG_EMPTY) {
      slots.mood = 'empty';
    } else if (sig.SIG_GREET) {
      slots.mood = 'greeting';
    } else {
      slots.mood = firstHit(t, LEX.MOOD);
    }

    /* 求助话题 */
    if (sig.SIG_HOWTO) {
      slots.topic = null;
      for (i = 0; i < LEX.HOWTO_TOPIC.length; i++) {
        if (anyHit(t, LEX.HOWTO_TOPIC[i].words)) {
          slots.topic = LEX.HOWTO_TOPIC[i].topic;
          break;
        }
      }
      if (!slots.topic) { slots.topic = 'where'; }
    } else {
      slots.topic = null;
    }

    /* 查询范围 */
    slots.period = null;
    for (i = 0; i < LEX.PERIOD.length; i++) {
      if (anyHit(t, LEX.PERIOD[i].words)) {
        slots.period = LEX.PERIOD[i].period;
        break;
      }
    }

    /* 建议倾向 */
    slots.adviceKind = null;
    if (sig.SIG_ADVICE) {
      if (anyHit(t, LEX.ADVICE_EARN)) { slots.adviceKind = 'earn'; }
      else if (anyHit(t, LEX.ADVICE_SAVE)) { slots.adviceKind = 'save'; }
      else { slots.adviceKind = 'wantbuy'; }
    }

    slots.drink = anyHit(t, DRINK_WORDS);
    slots.detailHint = anyHit(t, LEX.QUERY_DETAIL);
    slots.queryKind = null;   // 由 resolveQueryKind 统一算
    return slots;
  }

  /* ================================================================== */
  /* 六、打分 / 否决 / 仲裁                                              */
  /* ================================================================== */

  /**
   * 按权重矩阵累加 6 个意图分。
   * @param {Object} signals
   * @return {Object} scores
   */
  function scoreIntents(signals) {
    var scores = { record: 0, query: 0, howto: 0, advice: 0, dataop: 0, chitchat: 0 };
    var sig = signals || {};
    var k, it, row;
    for (k in sig) {
      if (!Object.prototype.hasOwnProperty.call(sig, k)) { continue; }
      if (sig[k] !== true) { continue; }
      row = WEIGHTS[k];
      if (!row) { continue; }          // SIG_GREET 等内部辅助信号无权重
      for (it in row) {
        if (!Object.prototype.hasOwnProperty.call(row, it)) { continue; }
        scores[it] += row[it];
      }
    }
    return scores;
  }

  /**
   * 4 条否决规则（V1-V4），先于 argmax 生效。
   * V1 疑问式求助 / V2 查询词 / V3 改删撤 -> record 压到 ≤ -1
   * V4 带金额且无疑问结构 -> record 抬到 ≥ 70（保留现有「带金额一律记账」规则，禁止改动）
   * @param {Object} scores
   * @param {Object} signals
   * @return {Object} 新 scores
   */
  function applyVeto(scores, signals) {
    var s = {};
    var k;
    for (k in scores) {
      if (Object.prototype.hasOwnProperty.call(scores, k)) { s[k] = scores[k]; }
    }
    var sig = signals || {};
    var hasAmount = sig.SIG_AMOUNT === true;
    /* V1：疑问式求助永远不当成记账 */
    if (sig.SIG_HOWTO && !hasAmount) { s.record = Math.min(s.record, -1); }
    /* V2：查询句不当记账 */
    if ((sig.SIG_Q_BALANCE || sig.SIG_Q_PIE || sig.SIG_Q_STAT) && !hasAmount) {
      s.record = Math.min(s.record, -1);
    }
    /* V3：改删撤不当记账 */
    if (sig.SIG_DATAOP && !hasAmount && !sig.SIG_HOWTO) { s.record = Math.min(s.record, -1); }
    /* V4：带金额 + 无疑问结构 -> 强制记账（唯一一条抬分规则，为不破坏现有业务而存在） */
    if (isForceRecord(sig)) { s.record = Math.max(s.record, FORCE_RECORD_MIN); }
    /* V5：纠错句永不记账（改金额由 dataop 通道处理；isForceRecord 已排除 SIG_CORRECTION，V4 不会抬起） */
    if (sig.SIG_CORRECTION) { s.record = Math.min(s.record, -1); }
    return s;
  }

  /**
   * V4 规则的唯一实现判据：句子里有精确金额，且没有疑问结构。
   * 「肯德基疯狂星期四 25」「我想买个耳机 500」都必须记账。
   * @param {Object} signals
   * @return {boolean}
   */
  function isForceRecord(signals) {
    var sig = signals || {};
    if (sig.SIG_CORRECTION) { return false; }
    if (sig.SIG_AMOUNT !== true) { return false; }
    return !(sig.SIG_HOWTO || sig.SIG_YESNO || sig.SIG_WH || sig.SIG_QMARK || sig.SIG_Q_BALANCE);
  }

  /**
   * 排序：按分数降序，平手按 INTENT_ORDER 稳定排序。
   * @param {Object} scores
   * @return {Array<{intent:string, score:number}>}
   */
  function rankIntents(scores) {
    var arr = [];
    var i;
    for (i = 0; i < INTENT_ORDER.length; i++) {
      var k = INTENT_ORDER[i];
      if (k === 'unknown') { continue; }
      arr.push({
        intent: k,
        score: (scores && typeof scores[k] === 'number') ? scores[k] : 0
      });
    }
    arr.sort(function (a, b) {
      if (b.score !== a.score) { return b.score - a.score; }
      return INTENT_ORDER.indexOf(a.intent) - INTENT_ORDER.indexOf(b.intent);
    });
    return arr;
  }

  /**
   * confidence 归一化（分差 + 40 基线，可解释、无魔法）。
   * @param {number} top
   * @param {number} second
   * @return {number} 0 ~ 0.99
   */
  function toConfidence(top, second) {
    var v = ((top - Math.max(0, second)) + 40) / 100;
    return Math.max(0, Math.min(0.99, v));
  }

  /**
   * argmax + confidence/margin/tier 判定 + R1（record 单极豁免）。
   * @param {Object} scores 已过 V1-V4
   * @param {Object} signals
   * @param {Object} slots
   * @return {{intent:string, score:number, second:Object, confidence:number, margin:number, tier:string, rank:Array}}
   */
  function arbitrate(scores, signals, slots) {
    var rank = rankIntents(scores);
    var top = rank[0];
    var second = rank[1] || { intent: 'unknown', score: 0 };
    var conf = toConfidence(top.score, second.score);
    var margin = top.score - second.score;
    var tier;
    if (conf >= CONF_HIGH && margin >= MARGIN_MIN) { tier = 'high'; }
    else if (top.score >= SCORE_LOW || conf >= CONF_LOW) { tier = 'low'; }
    else { tier = 'verylow'; }

    /* R1：record 单极豁免——不必等云端 3 秒，本地立刻按「缺金额」承接 */
    if (top.intent === 'record' && second.score < top.score * RECORD_DOMINANCE) { tier = 'high'; }

    /* R1b：chitchat 单极豁免（同 R1 理由）。情绪承接必须秒回，不能为了 0.01 的
       confidence 差去等云端 3 秒裁决。只对 chitchat 生效，不影响 query 的「低置信」
       （「昨天那笔是什么」仍需保持 low，见 §4.5 第 14 行）。 */
    if (top.intent === 'chitchat' && second.score < top.score * RECORD_DOMINANCE) { tier = 'high'; }

    return {
      intent: top.intent,
      score: top.score,
      second: second,
      confidence: conf,
      margin: margin,
      tier: tier,
      rank: rank
    };
  }

  /**
   * 解析 query 的子槽位 queryKind。
   * @param {Object} signals
   * @param {Object} slots
   * @return {?string} 'balance'|'pie'|'category'|'detail'|null
   */
  function resolveQueryKind(signals, slots) {
    var sig = signals || {};
    var s = slots || {};
    if (sig.SIG_Q_BALANCE) { return 'balance'; }
    if (sig.SIG_Q_PIE) { return 'pie'; }
    if (sig.SIG_Q_STAT) {
      /* 有品类词就按品类统计（「这个月奶茶花了多少」）；
         只有指代 / 明细词时才退化成明细列表（「昨天那个」）。 */
      if (sig.SIG_CATEGORY) { return 'category'; }
      if (sig.SIG_ANAPHORA || s.detailHint || s.period) { return 'detail'; }
      return 'detail';
    }
    if (sig.SIG_ANAPHORA || s.detailHint) { return 'detail'; }
    if (sig.SIG_WH && sig.SIG_CATEGORY) { return 'category'; }
    if (sig.SIG_WH && s.period) { return 'category'; }
    return null;
  }

  /**
   * 必需槽位求差。
   * @param {string} intent
   * @param {Object} slots
   * @return {string[]}
   */
  function missingSlots(intent, slots) {
    var req = REQUIRED_SLOTS[intent] || [];
    var s = slots || {};
    var out = [];
    var i;
    for (i = 0; i < req.length; i++) {
      var v = s[req[i]];
      if (v === undefined || v === null || v === '') { out.push(req[i]); }
    }
    return out;
  }

  /**
   * 弱查询证据判定：只有一个空泛的「看看 / 查一下」，没有任何查询对象。
   * @param {Object} signals
   * @param {Object} slots
   * @return {boolean}
   */
  function isWeakQueryOnly(signals, slots) {
    var sig = signals || {};
    var s = slots || {};
    if (!sig.SIG_Q_STAT) { return false; }
    if (sig.SIG_Q_STAT_STRONG) { return false; }
    if (sig.SIG_Q_BALANCE || sig.SIG_Q_PIE || sig.SIG_CATEGORY || sig.SIG_WH ||
      sig.SIG_ANAPHORA || sig.SIG_AMOUNT) { return false; }
    if (s.period || s.detailHint) { return false; }
    return true;
  }

  /* ================================================================== */
  /* 七、反死循环：阶梯解析                                              */
  /* ================================================================== */

  /**
   * 计算本次该用哪一层，并给出 promptKey（同一 promptKey 绝不连续出现）。
   * @param {?Object} pending {tries, level, formType, promptKey}
   * @param {string} intent
   * @param {string[]} missing
   * @return {{level:number, formType:string, promptKey:string, allowed:boolean}}
   */
  function resolveLevel(pending, intent, missing) {
    var p = pending || { tries: 0, level: 2, promptKey: null, formType: null };
    var miss = (missing && missing.length) ? missing.slice().sort().join(',') : '';
    var tries = Number(p.tries) || 0;
    var level;

    if (tries >= ANTI_LOOP.MAX_TRIES) { level = 5; }          // 硬规则：tries>=3 -> L5
    else if (tries >= 2) { level = 4; }                        // 硬规则：tries>=2 -> L4
    else if (tries >= 1) { level = 3; }                        // 硬规则：tries>=1 -> L3
    else { level = 2; if (missing && missing.length >= 2) { level = 3; } }  // 缺 >=2 槽位直接 L3

    var formType = FORM_OF_LEVEL[level];
    var promptKey = keyOf(intent, miss, level, tries);

    /* 硬规则：同一 promptKey 不得连续出现 -> 逐级上抬直到不同或到 5 */
    var guard = 0;
    while (ANTI_LOOP.SAME_PROMPT_FORBIDDEN && promptKey === p.promptKey && level < 5 && guard < 4) {
      level++;
      formType = FORM_OF_LEVEL[level];
      promptKey = keyOf(intent, miss, level, tries);
      guard++;
    }
    /* 硬规则：tries>=2 时 formType 必须与上次不同（按钮 -> 表单/选择） */
    if (tries >= ANTI_LOOP.FORCE_FORM_CHANGE_AT && formType === p.formType) {
      level = Math.min(5, level + 1);
      formType = FORM_OF_LEVEL[level];
      promptKey = keyOf(intent, miss, level, tries);
    }
    /* L5 是终点：文案固定，但 promptKey 追加尝试序号，
       保证「连续 5 次无法解析」产生的 key 两两不等（§3.4 验收断言）。 */
    return { level: level, formType: formType, promptKey: promptKey, allowed: true };
  }

  /**
   * 生成 promptKey。L5 追加尝试序号，避免「永远同一个放弃卡」被当成重复。
   * @param {string} intent
   * @param {string} miss 已排序逗号串
   * @param {number} level
   * @param {number} tries
   * @return {string}
   */
  function keyOf(intent, miss, level, tries) {
    var key = intent + '|' + miss + '|' + level;
    if (level >= 5) { key += '#' + Math.min(tries, 9); }
    return key;
  }

  /**
   * 发送前最后一道闸：最近已发 promptKey 命中即视为重复，需升级。
   * @param {string} promptKey
   * @param {string[]} recentKeys
   * @return {boolean}
   */
  function mustEscalate(promptKey, recentKeys) {
    var list = recentKeys || [];
    var i;
    for (i = 0; i < list.length; i++) {
      if (list[i] === promptKey) { return true; }
    }
    return false;
  }

  /* ================================================================== */
  /* 八、金额建议（L2 的按钮值必须来自可解释来源，不允许编造）            */
  /* ================================================================== */

  /**
   * 分位数（线性插值），用于把「该品类近 30 天金额」变成 P25/P50/P75 三个按钮值。
   * @param {Array<number>} sorted 升序数组
   * @param {number} p 0~1
   * @return {number}
   */
  function pctValue(sorted, p) {
    var n = sorted.length;
    if (n === 0) { return 0; }
    if (n === 1) { return Number(sorted[0]); }
    var idx = (n - 1) * p;
    var lo = Math.floor(idx);
    var hi = Math.ceil(idx);
    if (lo === hi) { return Number(sorted[lo]); }
    return Number(sorted[lo]) + (Number(sorted[hi]) - Number(sorted[lo])) * (idx - lo);
  }

  /**
   * 生成 3 个金额候选。
   * 来源优先级（全部可解释，不编造）：
   *   ① 文本模糊量词区间 ② 饮品参考价带 ③ 该品类近 30 天 P25/P50/P75
   *   ④ 该餐段历史均值 ⑤ 冷启动参考价
   * @param {Object} slots
   * @param {Object} [viewCtx] {categoryAvg, categoryCount, categoryAmounts, mealAvg, mealCount, mealAmounts}
   * @return {Array<{label:string, value:number, source:string}>}
   */
  function amountHints(slots, viewCtx) {
    var s = slots || {};
    var ctx = viewCtx || {};
    var out = [];
    var i;

    function push(value, source) {
      var v = Math.round(Number(value));
      if (!isFinite(v) || v <= 0) { return; }
      for (var j = 0; j < out.length; j++) {
        if (out[j].value === v) { return; }
      }
      if (out.length >= 3) { return; }
      out.push({ label: String(v), value: v, source: source });
    }

    /* ① 模糊量词：十几 -> 15 / 12 / 18 */
    if (s.amountFuzzy && isFinite(s.amountFuzzy.guess) && s.amountFuzzy.guess > 0) {
      var g = s.amountFuzzy.guess;
      push(g, 'fuzzy');
      push(g * 0.8, 'fuzzy');
      push(g * 1.2, 'fuzzy');
    } else if (s.drink) {
      /* ② 饮品价带：奶茶 / 咖啡的合理区间和大类均值差一个量级，
         用大类均值会给出「奶茶 72 元」这种荒谬按钮，因此饮品优先取价带。 */
      for (i = 0; i < DRINK_HINTS.length; i++) { push(DRINK_HINTS[i], 'drink-band'); }
    } else if (ctx.categoryAmounts && ctx.categoryAmounts.length >= 3) {
      /* ③ 该品类近 30 天的 P25 / P50 / P75 */
      var cs = ctx.categoryAmounts.slice().sort(function (a, b) { return a - b; });
      push(pctValue(cs, 0.25), 'category-30d');
      push(pctValue(cs, 0.5), 'category-30d');
      push(pctValue(cs, 0.75), 'category-30d');
    } else if (Number(ctx.categoryAvg) > 0 && Number(ctx.categoryCount) >= 3) {
      push(Number(ctx.categoryAvg), 'category-avg');
      push(Number(ctx.categoryAvg) * 0.8, 'category-avg');
      push(Number(ctx.categoryAvg) * 1.2, 'category-avg');
    } else if (Number(ctx.mealAvg) > 0 && Number(ctx.mealCount) >= 3) {
      /* ④ 该餐段历史均值 */
      push(Number(ctx.mealAvg), 'meal-avg');
      push(Number(ctx.mealAvg) * 0.8, 'meal-avg');
      push(Number(ctx.mealAvg) * 1.2, 'meal-avg');
    }

    if (out.length < 3) {
      /* ⑤ 冷启动参考价：餐段只在「餐饮 / 无分类」时更精确（社交聚餐用饭堂价会离谱）；
         其余按品类参考价，最后兜底「其他」。 */
      var base = null;
      if (s.meal && MEAL_HINTS[s.meal] && (!s.category || s.category === '餐饮')) {
        base = MEAL_HINTS[s.meal];
      } else {
        base = DEFAULT_HINTS[s.category || '其他'] || DEFAULT_HINTS['其他'];
      }
      for (i = 0; i < base.length && out.length < 3; i++) { push(base[i], 'default'); }
    }
    /* 保底：任何异常都给 3 个正数，避免出现空按钮组 */
    var fallback = DEFAULT_HINTS['其他'];
    for (i = 0; i < fallback.length && out.length < 3; i++) { push(fallback[i], 'default'); }
    return out;
  }

  /* ================================================================== */
  /* 九、文案引擎（只产出 HTML 片段，不碰 DOM）                          */
  /* ================================================================== */

  /**
   * 单个「待补全」按钮。
   * @param {string} pendId pendingCtx.id（防串味）
   * @param {string} val 值
   * @param {string} label 文案
   * @param {boolean} primary 是否主按钮
   * @return {string}
   */
  function pendBtn(pendId, val, label, primary) {
    return '<button type="button" class="btn-mini' + (primary ? ' primary' : '') +
      '" data-act="pend" data-pend="' + escHtml(pendId) + '" data-val="' + escHtml(val) + '">' +
      escHtml(label) + '</button>';
  }

  /** 通用快捷出口按钮（走既有 data-cmd -> handleSend） */
  function cmdBtn(cmd, label, primary) {
    return '<button type="button" class="btn-mini' + (primary ? ' primary' : '') +
      '" data-cmd="' + escHtml(cmd) + '">' + escHtml(label) + '</button>';
  }

  function actionsHtml(inner) {
    return '<div class="msg-actions">' + inner + '</div>';
  }

  /** L2：单槽位澄清（缺 amount 的默认层） */
  function level2Html(state, hints, pendId) {
    var slots = state.slots || {};
    var last = String(state.lastText || '').trim();
    var cat = slots.category || '';
    var head;
    var i;
    var btns = '';

    if (slots.plan) {
      head = '还没发生吧？先记个预计也行，等真花了再改。<br>大概准备花多少？';
    } else if (slots.amountFuzzy) {
      var g = hints.length ? hints[0].value : '';
      head = '「' + escHtml(slots.amountFuzzy.label || '差不多') + '」我猜你花了 <b>' +
        escHtml(g) + '</b> 左右，点一下我就记上（记错能撤回）。';
    } else if (last && cat && cat !== '其他' && last.length <= 6) {
      head = escHtml(last) + '多少钱？点一下就行：';
    } else if (last && cat && cat !== '其他') {
      head = '多少<b>' + escHtml(cat) + '</b>钱？点一下就行：';
    } else if (last) {
      head = '「' + escHtml(last) + '」多少钱？我按<b>' + escHtml(cat || '其他') + '</b>给你记。';
    } else {
      head = '记多少？点一下就行：';
    }

    for (i = 0; i < hints.length; i++) {
      btns += pendBtn(pendId, String(hints[i].value), String(hints[i].value), false);
    }
    btns += pendBtn(pendId, 'form', '自己填', false);
    if (slots.plan) { btns += pendBtn(pendId, 'skip', '等吃完再记', false); }

    return '<div class="bubble ai">' + head + '</div>' + actionsHtml(btns);
  }

  /** L3：换交互形式（表单 / 意图二选一） */
  function level3Html(state, pendId) {
    if (state.formType === 'choice' || state.intent === 'unknown') {
      return '<div class="bubble ai">这句话我拿不准是<b>记账</b>还是<b>问事</b>，你要哪个？</div>' +
        actionsHtml(pendBtn(pendId, 'form', '我要记一笔', true) +
          pendBtn(pendId, 'ask', '我在问事', false));
    }
    return '<div class="bubble ai">不猜了，直接把表单给你，填个金额就完事。</div>' +
      actionsHtml(pendBtn(pendId, 'form', '帮我填', true));
  }

  /** 行内小图标（与 app.js 的 ic 同义；各模块独立闭包不能跨文件取名） */
  function itIcon(name, cls, label) {
    return DATA.inlineIcon('i-' + name, cls, label);
  }

  /** L4：降级换通道（示例引导，不再问同一件事） */
  function level4Html() {
    return '<div class="bubble ai">' + itIcon('chat', 'bico-brand', '提示') + '换个说法我就能听懂，比如这几句：</div>' +
      actionsHtml(cmdBtn('午饭食堂 15', '午饭食堂 15', false) +
        cmdBtn('昨天打车 15', '昨天打车 15', false) +
        cmdBtn('这个月奶茶花了多少', '这个月奶茶花了多少', false));
  }

  /**
   * unknown 的第一层承接（§3.5 第 11 行）：把三个最常用的入口直接给出去，
   * 而不是一上来就「没辙了」。L5 只留给连续第 4 次仍判不出的情况。
   */
  function unknownClarifyHtml() {
    return '<div class="bubble ai">' + itIcon('bulb', 'bico-brand', '提示') + '想看啥？我给你三个最常用的：</div>' +
      actionsHtml(cmdBtn('查余额', '查余额', false) +
        cmdBtn('本月花销饼图', '本月饼图', false) +
        cmdBtn('这个月奶茶花了多少', '这个月奶茶花了多少', false));
  }

  /** L5：彻底放弃 + 3 个明确出口（禁止再追问，不含问号） */
  function giveUpHtml() {
    return '<div class="bubble ai">这句我是真没辙了（不再猜，免得给你记错）。你直接选：</div>' +
      actionsHtml('<button type="button" class="btn-mini primary" data-act="quick-add">手动记一笔</button>' +
        cmdBtn('查余额', '查余额', false) +
        cmdBtn('记一笔', '怎么记账', false));
  }

  /**
   * 按「意图 + 缺槽位 + 阶梯层」产出提示语 HTML。
   * @param {Object} state {intent, slots, missing, level, formType, lastText, hints, pendId, promptKey}
   * @param {Object} [viewCtx]
   * @return {{html:string, promptKey:string, formType:string, level:number}}
   */
  function buildPrompt(state, viewCtx) {
    var s = state || {};
    var intent = s.intent || 'record';
    var missing = s.missing || ['amount'];
    var level = typeof s.level === 'number' ? s.level : 2;
    var formType = s.formType || FORM_OF_LEVEL[level] || 'chip_group';
    var pendId = s.pendId || s.id || '';
    var hints = s.hints || amountHints(s.slots || {}, viewCtx || {});
    var miss = missing.slice().sort().join(',');
    var promptKey = s.promptKey || (intent + '|' + miss + '|' + level);
    var html;

    if (level >= 5) {
      html = giveUpHtml();
      formType = 'giveup';
    } else if (level === 4) {
      /* unknown 的第四层不是「举例引导」，而是「把三个最常用入口给出去」 */
      html = (intent === 'unknown') ? unknownClarifyHtml() : level4Html();
      formType = 'choice';
    } else if (level === 3) {
      html = level3Html(s, pendId);
      formType = (s.formType === 'choice') ? 'choice' : 'form';
    } else {
      html = level2Html(s, hints, pendId);
      formType = 'chip_group';
    }
    return { html: html, promptKey: promptKey, formType: formType, level: level };
  }

  /* ================================================================== */
  /* 十、主入口：classifyIntent（§2.5 伪代码落地）                       */
  /* ================================================================== */

  /**
   * 组装返回结果（统一收口，保证字段齐全）。
   * @return {Object}
   */
  function packFinal(intent, confidence, tier, scores, signals, slots, missing, queryKind, plan, reason) {
    var miss = missing || [];
    /* 槽位齐 = L0（直接执行），只有「还缺东西」才谈阶梯层 */
    var lv = (miss.length === 0)
      ? { level: 0, formType: FORM_OF_LEVEL[0], promptKey: intent + '||0', allowed: true }
      : resolveLevel(null, intent, miss);
    return {
      intent: intent,
      confidence: Math.round(Number(confidence) * 100) / 100,
      tier: tier,
      scores: scores || {},
      signals: signals || {},
      slots: slots || {},
      missing: miss,
      queryKind: queryKind || null,
      plan: plan === true,
      reason: reason || '',
      level: lv.level,
      formType: lv.formType,
      promptKey: lv.promptKey
    };
  }

  /**
   * 意图分类主入口（纯函数，无 DOM 依赖，< 1ms）。
   * @param {string} text 用户原句
   * @param {{now?:Date, lastBill?:Object, pending?:Object}} [ctx]
   * @return {{intent:string, confidence:number, tier:string, scores:Object, signals:Object,
   *   slots:Object, missing:string[], queryKind:?string, plan:boolean, reason:string,
   *   level:number, formType:string, promptKey:string}}
   */
  function classifyIntent(text, ctx) {
    var t = normalize(text);
    var opt = ctx || {};

    /* ---- step 0：空输入 / 纯表情 ---- */
    if (!t || stripNoise(t).length === 0 || isPurePunct(t)) {
      return packFinal('chitchat', 0.90, 'high', {}, {},
        { mood: 'empty' }, [], null, false, 'R0 空输入');
    }
    /* ---- step 0.5：问候短路（R3b 的守卫） ---- */
    if (isGreeting(t)) {
      return packFinal('chitchat', 0.92, 'high', {}, { SIG_GREET: true },
        { mood: 'greeting' }, [], null, false, 'R0.5 问候');
    }

    /* ---- step 1：18 个信号 ---- */
    var sig = detectSignals(t, opt);
    /* ---- step 2：槽位 ---- */
    var slots = extractSlots(t, sig, opt);
    /* ---- step 3：打分 ---- */
    var scores = scoreIntents(sig);
    /* ---- step 4：否决 V1-V4 ---- */
    scores = applyVeto(scores, sig);
    /* ---- step 5/6：argmax + tier + R1 ---- */
    var arb = arbitrate(scores, sig, slots);

    var intent = arb.intent;
    var conf = arb.confidence;
    var tier = arb.tier;
    var topScore = arb.score;
    var reason = 'argmax';

    /* ---- step 6.5：V4 是硬规则，自带高置信（同 R2 的理由） ----
       命中 V4 说明「句子带金额 + 无疑问结构」，业务规则已直接判定为记账，
       这不是分数竞争，因此不需要云端二次裁决。 */
    if (isForceRecord(sig) && intent === 'record') { tier = 'high'; }

    /* ---- step 7：R2 疑问覆盖改删（「记错了怎么删掉」是在问方法） ---- */
    if (sig.SIG_HOWTO && sig.SIG_DATAOP) {
      intent = 'howto';
      topScore = scores.howto;
      conf = Math.max(conf, 0.80);
      tier = 'high';
      reason = 'R2 疑问覆盖改删';
    }

    /* ---- step 7.5：弱查询证据降级（「帮我看看」没有任何查询对象） ---- */
    if (intent === 'query' && isWeakQueryOnly(sig, slots)) {
      intent = 'unknown';
      topScore = 0;
      conf = Math.min(conf, 0.40);
      tier = 'verylow';
      reason = '弱查询证据';
    }

    /* ---- step 7.8：R4 指代兜底 ----
       「昨天那个」「那笔」这类只给了指代、没给金额也没给改删动词的句子，
       应该按「明细查询」处理并让用户点选，而不是反问「昨天那个多少钱」。
       （P1 修复：此前 NLP.classify('那笔') 会命中「笔」-> 学习，R3a 把它错判成记账） */
    if (topScore < SCORE_LOW && sig.SIG_ANAPHORA && !sig.SIG_AMOUNT &&
      !sig.SIG_DATAOP && !sig.SIG_HOWTO && !sig.SIG_Q_BALANCE && !sig.SIG_Q_PIE) {
      slots.queryKind = 'detail';
      return packFinal('query', Math.max(conf, 0.45), 'low', scores, sig, slots,
        [], 'detail', false, 'R4 指代兜底');
    }

    /* step 7.95：纯时间指代（昨天/今天/上周…）不能当成消费项目。整句剥掉时间词后若什么都不剩，说明用户只说了一个时间点，按查询该时段处理（无损，不编造账单）。 */
    if (isPureTimeReference(t) && !sig.SIG_AMOUNT && !sig.SIG_SPEND_VERB) {
      slots.queryKind = 'detail';
      return packFinal('query', Math.max(conf, 0.55), 'low', scores, sig, slots, [], 'detail', false, '纯时间指代到查询');
    }

    /* ---- step 8：R3 兜底（R3a 品类 / R3b 短名词） ---- */
    if (topScore < SCORE_LOW) {
      /* 指代也算「有明确语义线索」：不许再被 R3a 拽回记账 */
      var noVeto = !(sig.SIG_HOWTO || sig.SIG_YESNO || sig.SIG_WH || sig.SIG_QMARK ||
        sig.SIG_Q_BALANCE || sig.SIG_Q_PIE || sig.SIG_Q_STAT || sig.SIG_ANAPHORA ||
        sig.SIG_EMOTION || sig.SIG_ADVICE || sig.SIG_DATAOP);
      if (noVeto && (sig.SIG_CATEGORY || sig.SIG_SPEND_VERB)) {
        /* R3a：品类词 / 消费动词，但分数不够 -> 记账缺金额 */
        return packFinal('record', 0.40, 'low', scores, sig, slots,
          ['amount'], null, slots.plan === true, 'R3a 品类兜底');
      }
      var bare = String(t).replace(/\s+/g, '');
      var looksLikeNoun = noVeto && !/\d/.test(bare) && bare.length >= 2 && bare.length <= 8;
      if (looksLikeNoun) {
        /* R3b：「红糖糍粑」这类连 classify 都打不出分类的短名词 -> 仍问金额 */
        if (!slots.category) { slots.category = '其他'; }
        return packFinal('record', 0.30, 'verylow', scores, sig, slots,
          ['amount'], null, false, 'R3b 短名词兜底');
      }
      return packFinal('unknown', conf, 'verylow', scores, sig, slots,
        ['intent'], null, false, reason === 'argmax' ? '无证据' : reason);
    }

    /* ---- step 9：必需槽位求差 ---- */
    slots.queryKind = resolveQueryKind(sig, slots);
    var missing = missingSlots(intent, slots);
    return packFinal(intent, conf, tier, scores, sig, slots, missing,
      slots.queryKind, slots.plan === true, reason);
  }

  /* ================================================================== */
  /* 十一、端云协同：云端裁决的合流（只允许在本地 top2 内改判）           */
  /* ================================================================== */

  /**
   * 合并云端裁决结果。
   * 保护逻辑：① 越界改判拒收；② 本地 record + 有金额时拒收（V4 保护）；
   *          ③ 云端 confidence < 0.6 不采信；④ 合并后 tier 记 low（本地已确认的部分保留）。
   * @param {Object} local classifyIntent 的结果
   * @param {Object} verdict {intent, confidence, missing, queryKind}
   * @return {Object} 合并后的结果（结构同 classifyIntent）
   */
  function mergeVerdict(local, verdict) {
    if (!local) { return local; }
    if (!verdict || !verdict.intent) { return local; }
    var ranked = rankIntents(local.scores || {});
    var top2 = [];
    if (ranked[0]) { top2.push(ranked[0].intent); }
    if (ranked[1]) { top2.push(ranked[1].intent); }
    /* ① 只允许在本地 top2 内改判 */
    if (top2.indexOf(verdict.intent) === -1) { return local; }
    /* ② V4 保护：本地已判定 record 且句子里有金额 -> 不接受任何改判 */
    if (local.signals && local.signals.SIG_AMOUNT && local.intent === 'record') { return local; }
    /* ③ 云端低置信不采信 */
    var cf = Number(verdict.confidence);
    if (isFinite(cf) && cf < 0.6) { return local; }

    var slots = local.slots || {};
    var missing = verdict.missing || missingSlots(verdict.intent, slots);
    var lv = resolveLevel(null, verdict.intent, missing);
    return {
      intent: verdict.intent,
      confidence: Math.round(Math.max(Number(local.confidence) || 0, 0.6) * 100) / 100,
      tier: 'low',
      scores: local.scores || {},
      signals: local.signals || {},
      slots: slots,
      missing: missing,
      queryKind: verdict.queryKind || local.queryKind || null,
      plan: local.plan === true,
      reason: 'cloud-verdict',
      level: lv.level,
      formType: lv.formType,
      promptKey: lv.promptKey
    };
  }

  /* ================================================================== */
  /* 十二、导出                                                          */
  /* ================================================================== */

  var API = {
    classifyIntent: classifyIntent,
    detectSignals: detectSignals,
    extractSlots: extractSlots,
    scoreIntents: scoreIntents,
    applyVeto: applyVeto,
    arbitrate: arbitrate,
    rankIntents: rankIntents,
    resolveQueryKind: resolveQueryKind,
    missingSlots: missingSlots,
    resolveLevel: resolveLevel,
    mustEscalate: mustEscalate,
    isAntiLoopViolation: mustEscalate,
    buildPrompt: buildPrompt,
    amountHints: amountHints,
    fuzzyAmountOf: fuzzyAmountOf,
    isGreeting: isGreeting,
    mergeVerdict: mergeVerdict,
    normalize: normalize,
    CONST: {
      INTENTS: INTENTS,
      INTENT_ORDER: INTENT_ORDER,
      REQUIRED_SLOTS: REQUIRED_SLOTS,
      WEIGHTS: WEIGHTS,
      LEX: LEX,
      SCORE_LOW: SCORE_LOW,
      SCORE_HIGH: SCORE_HIGH,
      MARGIN_MIN: MARGIN_MIN,
      CONF_HIGH: CONF_HIGH,
      CONF_LOW: CONF_LOW,
      RECORD_DOMINANCE: RECORD_DOMINANCE,
      FORCE_RECORD_MIN: FORCE_RECORD_MIN,
      PENDING_TTL_MS: PENDING_TTL_MS,
      MAX_TRIES: MAX_TRIES,
      LEVELS: LEVELS,
      FORM_OF_LEVEL: FORM_OF_LEVEL,
      ANTI_LOOP: ANTI_LOOP
    }
  };

  if (isNode) {
    module.exports = API;
  } else {
    global.AJ = global.AJ || {};
    global.AJ.intent = API;
  }
})(typeof globalThis !== 'undefined' ? globalThis : this);

  </script>
  <!-- WorkBuddy 云服务 SDK（免密钥大模型）：CDN 形式，运行时从 jsdelivr 加载 -->
  <script src="https://cdn.jsdelivr.net/npm/@tencent-ai/workbuddy-cloud-sdk@dev/lib/index.global.js"></script>
<script>
/* WorkBuddy 云服务公开配置（由开通后生成，仅含前端可用的公开字段，不含任何密钥）。
   这串 publishableKey 本就会下发到浏览器，可安全提交。endpoint 由云服务生命周期返回。 */
window.AJ_CLOUD_CONFIG = {
  endpoint: 'https://ai-expense-tracker-91800.app.workbuddy.host',
  oauthRelayBaseUrl: 'https://www.workbuddy.cn/v2/as/genie-baas/oauth',
  publishableKey: 'wbpk_MNCgGVz1qLbMkTIbyPB7e1_Fg6f4OdW4v5QBR6S0wWtiMnAIKypVKxe',
  appId: 'wbapp_MNCgGVz1qLbMkTIbyPB7e1'
