  }

  /**
   * 最常用入口：一次给出声音 + 震动。
   * @param {string} name  save|income|focus|spend|error|poke
   * @param {Object} [opts] {cents: 金额（分），仅 save 用于分档}
   */
  function both(name, opts) {
