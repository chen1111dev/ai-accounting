    '  <rect x="30" y="105" width="60" height="5" fill="#EAF8FF"/>' +
    '  <circle cx="42" cy="102" r="1.8" fill="#EAF8FF"/>' +
    '  <circle cx="60" cy="91.5" r="1.8" fill="#EAF8FF"/>' +
    '  <circle cx="78" cy="102" r="1.8" fill="#EAF8FF"/>' +
