      <symbol id="i-dna" viewBox="0 0 24 24">
        <path d="M8 3c0 4.5 8 4.5 8 9s-8 4.5-8 9"/>
        <path d="M16 3c0 4.5-8 4.5-8 9s8 4.5 8 9"/>
        <path d="M9.5 8.5h5M9.5 15.5h5"/>
      </symbol>

      <!-- 省钱图谱的 10 个分类图标（v1.3）：茶饮 / 食堂 / 外卖 / 零食 / 商超 / 券 -->
      <symbol id="i-bowl" viewBox="0 0 24 24"><path d="M3.5 11.5h17a8.5 8.5 0 0 1-8.5 8.2 8.5 8.5 0 0 1-8.5-8.2z"/><path d="M9.2 8.4c0-1.1 1.1-1.1 1.1-2.2M14 7.6c0-1 1-1 1-2"/></symbol>
      <symbol id="i-tray" viewBox="0 0 24 24"><path d="M3.6 17.6h16.8"/><path d="M5.8 17.6a6.2 6.2 0 0 1 12.4 0"/><path d="M12 11.4V8.2"/><path d="M10.6 8.2h2.8"/></symbol>
      <symbol id="i-cup" viewBox="0 0 24 24"><path d="M7 9h10l-1 10.4a2 2 0 0 1-2 1.6h-4a2 2 0 0 1-2-1.6L7 9z"/><path d="M6.2 5.4h11.6V9H6.2z"/></symbol>
      <symbol id="i-snack" viewBox="0 0 24 24"><rect x="8.4" y="7.4" width="7.2" height="3.7" rx="1"/><rect x="8.4" y="12.4" width="7.2" height="3.7" rx="1"/><path d="M12 3.2v3.6M12 11.1v1.3M12 16.1v4.6"/></symbol>
      <symbol id="i-bag" viewBox="0 0 24 24"><path d="M5.2 8.4h13.6l-1 11.2a1.4 1.4 0 0 1-1.4 1.2H7.6a1.4 1.4 0 0 1-1.4-1.2L5.2 8.4z"/><path d="M9.2 8.4V6.2a2.8 2.8 0 0 1 5.6 0v2.2"/></symbol>
      <symbol id="i-ticket" viewBox="0 0 24 24"><path d="M3.6 7.4h16.8v2.7a1.9 1.9 0 0 0 0 3.8v2.7H3.6v-2.7a1.9 1.9 0 0 0 0-3.8V7.4z"/><path d="M12 9.2v1.4M12 12.6v1.4M12 15.9v.6"/></symbol>
    </defs>
  </svg>

  <div class="app" id="app">

    <header class="topbar">
      <div class="brand">
        <span class="logo">账</span>
        <div class="brand-text">
          <strong>AI 校园记账管家</strong>
          <small>月末防吃土 · 一句话记账</small>
        </div>
      </div>
      <div class="topbar-actions">
        <button class="btn-quick-add" id="btnQuickAdd" type="button" title="快捷记账">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          <span>记一笔</span>
        </button>
        <button class="btn-ghost btn-feature" id="btnOcr" type="button" aria-label="截屏记账" title="截屏记账">
          <svg class="ico"><use href="#i-camera"/></svg><span class="txt">截屏记账</span>
        </button>
        <button class="btn-ghost btn-feature" id="btnAnalysis" type="button" aria-label="账单分析" title="账单分析">
          <svg class="ico"><use href="#i-bar"/></svg><span class="txt">账单分析</span>
        </button>
        <button class="btn-ghost btn-feature" id="btnCoach" type="button" aria-label="理财专家" title="理财专家">
          <svg class="ico"><use href="#i-cap"/></svg><span class="txt">理财专家</span>
        </button>
        <button class="btn-ghost btn-feature" id="btnSaveHub" type="button" aria-label="省钱助手" title="省钱助手：省钱雷达 + 省钱图谱">
          <svg class="ico"><use href="#i-wallet"/></svg><span class="txt">省钱助手</span>
        </button>
        <button class="btn-ghost btn-feature" id="btnPiggyTop" type="button" aria-label="存钱罐" title="存钱罐">
          <svg class="ico"><use href="#i-piggy"/></svg><span class="txt">存钱罐</span>
        </button>
        <button class="btn-ghost btn-feature" id="btnWishTop" type="button" aria-label="心愿单" title="心愿单：冷静期清单">
          <svg class="ico"><use href="#i-clock"/></svg><span class="txt">心愿单</span>
        </button>
        <button class="btn-icon btn-more" id="btnMore" type="button" title="更多" aria-label="更多">⋯</button>
        <button class="btn-icon" id="btnSettings" type="button" title="设置" aria-label="设置">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7zm7.4-2.6c.04-.3.06-.6.06-.9s-.02-.6-.06-.9l2-1.55a.5.5 0 0 0 .12-.64l-1.9-3.3a.5.5 0 0 0-.6-.22l-2.36.95a6.9 6.9 0 0 0-1.55-.9l-.36-2.5a.5.5 0 0 0-.5-.42h-3.8a.5.5 0 0 0-.5.42l-.36 2.5c-.55.24-1.07.54-1.55.9l-2.36-.95a.5.5 0 0 0-.6.22l-1.9 3.3a.5.5 0 0 0 .12.64l2 1.55c-.04.3-.06.6-.06.9s.02.6.06.9l-2 1.55a.5.5 0 0 0-.12.64l1.9 3.3c.13.22.39.31.6.22l2.36-.95c.48.36 1 .66 1.55.9l.36 2.5c.04.24.25.42.5.42h3.8c.25 0 .46-.18.5-.42l.36-2.5c.55-.24 1.07-.54 1.55-.9l2.36.95c.21.09.47 0 .6-.22l1.9-3.3a.5.5 0 0 0-.12-.64l-2-1.55z"/>
          </svg>
        </button>
        <div class="more-menu" id="moreMenu" hidden>
          <button type="button" data-act="piggy">存钱罐</button>
          <button type="button" data-act="wish">心愿单</button>
          <button type="button" data-act="import">导入账单</button>
          <button type="button" data-act="export">导出 CSV</button>
          <button type="button" data-act="reset">重置演示数据</button>
        </div>
      </div>
    </header>

    <!-- 常驻预算状态条：任何视图下都可见剩余预算 / 日均可用 / 剩余天数（设计稿核心优化） -->
    <div class="budget-bar" id="budgetBar" role="button" tabindex="0" aria-label="查看周期预算详情">
      <div class="bb-left">
        <span class="bb-dot"></span>
        <span class="bb-label">剩余预算</span>
        <span class="bb-amount" id="bbAmount">¥0.00</span>
      </div>
      <div class="bb-mid">
        <span>日均 <b id="bbDaily">¥0.00</b></span>
        <span>剩 <b id="bbDays">0 天</b></span>
      </div>
      <span class="bb-status" id="bbStatus">安全</span>
      <div class="bb-progress"><i id="bbFill"></i></div>
    </div>

    <div class="storage-tip" id="storageTip" hidden>当前为临时模式，关闭页面数据不保留</div>

    <main class="layout">

      <!-- ============================ 聊天 ============================ -->
      <section class="panel panel-chat" id="panelChat">
        <div class="chat-head">
          <button class="chat-back" id="btnAiBack" type="button" title="返回" aria-label="返回">‹</button>
          <span class="dot-live"></span>
          <span>账小助 · 在线</span>
          <button class="btn-mini chat-undo" id="btnUndo" type="button" title="撤回最近一笔记账">↩ 撤回上一步</button>
          <span class="chat-head-hint">支持一句话多笔，例如「中午黄焖鸡18，晚上聚餐50」</span>
        </div>
        <div class="chat-list" id="chatList"></div>
        <div class="chat-composer">
          <div class="quick-chips" id="quickChips">
            <button class="chip" type="button" data-cmd="查余额">查余额</button>
            <button class="chip" type="button" data-cmd="本月花销饼图">本月花销饼图</button>
            <button class="chip" type="button" data-cmd="记一笔">记一笔</button>
            <button class="chip" type="button" data-cmd="记收入">记收入</button>
            <button class="chip" type="button" data-cmd="我想攒钱">我想攒钱</button>
            <button class="chip coach-chip" type="button" data-cmd="怎么省钱">怎么省钱</button>
            <button class="chip coach-chip" type="button" data-cmd="怎么赚钱">怎么赚钱</button>
            <button class="chip coach-chip" type="button" data-cmd="剁手冷静法">剁手冷静法</button>
            <button class="chip coach-chip" type="button" data-cmd="理财课">理财课</button>
            <button class="chip" type="button" data-cmd="今天有什么优惠">今天有啥优惠</button>
            <button class="chip" type="button" data-cmd="疯狂星期四">疯狂星期四</button>
            <button class="chip" type="button" data-cmd="比价 充电宝">比价</button>
            <button class="chip" type="button" data-cmd="设置预算">设置预算</button>
          </div>
          <div class="input-row">
            <button class="btn-mic" id="btnMic" type="button" title="语音输入" aria-label="语音输入">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2z"/>
              </svg>
            </button>
            <input id="chatInput" type="text" autocomplete="off" enterkeyhint="send"
                   placeholder="说一句话，比如：中午食堂 15" />
            <button class="btn-send" id="btnSend" type="button">发送</button>
          </div>
        </div>
      </section>

      <!-- ============================ 看板 ============================ -->
      <aside class="panel panel-dash" id="panelDash">
        <div class="dash-scroll">

          <div class="dash-sec"><span>L1 预算焦点</span><i></i></div>

          <div class="card card-budget">
            <div class="card-head">
              <h3>周期预算</h3>
              <span class="badge state-safe" id="budgetStateChip">安全</span>
              <span class="badge" id="cycleBadge">—</span>
            </div>
            <div class="ring-wrap">
              <svg class="ring" viewBox="0 0 140 140" aria-hidden="true">
                <circle class="ring-track" cx="70" cy="70" r="58"></circle>
                <circle class="ring-bar" id="ringBar" cx="70" cy="70" r="58"></circle>
              </svg>
              <div class="ring-center">
                <span class="ring-amount" id="ringRemaining">¥0.00</span>
                <span class="ring-label" id="ringPercent">剩余 0%</span>
              </div>
            </div>
            <div class="mini-stats">
              <div><b id="statDaily">¥0.00</b><small>日均可用</small></div>
              <div><b id="statToday">¥0.00</b><small>今日已花</small></div>
              <div><b id="statDays">0 天</b><small>剩余天数</small></div>
            </div>
            <div class="forecast-kpi" id="forecastKpi" hidden></div>
            <div class="budget-cycle" id="budgetCycle">—</div>
          </div>

          <div class="dash-sec"><span>L2 收支总览</span><i></i></div>

          <div class="card card-income" id="incomeCard">
            <div class="card-head">
              <h3>收支概览</h3>
              <span class="hint" id="incomeHint">本周期</span>
            </div>
            <div class="income-grid">
              <div><b id="incIncome">¥0.00</b><small>收入</small></div>
              <div><b id="incExpense">¥0.00</b><small>支出</small></div>
              <div><b id="incBalance">¥0.00</b><small>结余</small></div>
              <div><b id="incRate">—</b><small>储蓄率</small></div>
            </div>
          </div>

          <div class="card card-piggy ui-full-only" id="piggyCard" hidden>
            <div class="card-head">
              <h3><svg class="title-ico"><use href="#i-piggy"/></svg>存钱罐</h3>
              <button class="btn-mini" id="btnPiggyCard" type="button">存一笔</button>
            </div>
            <div class="piggy-mini" id="piggyMini"></div>
          </div>

          <div class="card card-learn ui-full-only" id="learnCard">
            <div class="card-head">
              <h3><svg class="title-ico" aria-hidden="true"><use href="#i-cap"/></svg>理财课 · 视频与博主</h3>
              <button class="btn-mini" id="btnLearnAll" type="button">全部 ›</button>
            </div>
            <div class="learn-mini" id="learnMini"></div>
          </div>

          <div class="dash-sec"><span>L3 消费洞察</span><i></i></div>

          <div class="card card-engel ui-full-only" id="engelCard">
            <div class="card-head">
              <h3>恩格尔系数预警</h3>
              <span class="badge badge-soft" id="engelBadge">—</span>
            </div>
            <div class="engel-bar"><i id="engelFill"></i></div>
            <p class="engel-text" id="engelText">—</p>
          </div>

          <div class="card card-diag ui-full-only" id="diagCard" hidden>
            <div class="card-head">
              <h3>消费诊断</h3>
              <span class="badge badge-soft" id="diagBadge">—</span>
            </div>
            <div class="diag-list" id="diagList"></div>
          </div>

          <div class="card card-deals ui-full-only" id="dealsCard">
            <div class="card-head">
              <h3><svg class="title-ico"><use href="#i-radar"/></svg>省钱雷达</h3>
              <button class="btn-mini" id="btnDealsCard" type="button">查看</button>
            </div>
            <div class="deals-mini" id="dealsMini"></div>
          </div>

          <div class="card card-savings ui-full-only" id="savingsCard">
            <div class="card-head">
              <h3><svg class="title-ico"><use href="#i-bulb"/></svg>今天怎么省</h3>
              <button class="btn-mini" id="btnSavingsCard" type="button">查看</button>
            </div>
            <div class="savings-mini" id="savingsMini"></div>
          </div>

          <div class="card card-wish ui-full-only" id="wishCard" hidden>
            <div class="card-head">
              <h3><svg class="title-ico"><use href="#i-clock"/></svg>心愿单 · 冷静期</h3>
              <button class="btn-mini" id="btnWishCard" type="button">查看</button>
            </div>
            <div class="wish-mini" id="wishMini"></div>
          </div>

          <div class="card">
            <div class="card-head">
              <h3>分类占比</h3>
              <span class="hint">点图例高亮</span>
            </div>
            <div class="donut-wrap">
              <svg class="donut" id="donutChart" viewBox="0 0 160 160" aria-hidden="true"></svg>
              <div class="donut-center">
                <b id="donutTotal">¥0.00</b>
                <small>本周期支出</small>
              </div>
            </div>
            <ul class="legend" id="legendList"></ul>
          </div>

          <div class="card">
            <div class="card-head">
              <h3>近 7 日趋势</h3>
              <span class="hint" id="trendSum">—</span>
            </div>
            <div class="trend-wrap">
              <svg id="trendChart" viewBox="0 0 320 150" preserveAspectRatio="xMidYMid meet" aria-hidden="true"></svg>
            </div>
          </div>

          <div class="dash-sec"><span>L4 支出统计</span><i></i></div>

          <!-- 月份切换 + 本月收支：三张统计图共用一个月份，左右箭头翻月 -->
          <div class="card card-stat-month">
            <div class="stat-month-nav">
              <button class="stat-nav" id="statPrev" type="button" aria-label="上一月">‹</button>
              <span class="stat-month-label" id="statMonthLabel">—</span>
              <button class="stat-nav" id="statNext" type="button" aria-label="下一月">›</button>
            </div>
            <div class="stat-sum-grid">
              <div class="stat-sum is-expense"><b id="statMonthExpense">¥0.00</b><small>本月支出</small></div>
              <div class="stat-sum is-income"><b id="statMonthIncome">¥0.00</b><small>本月收入</small></div>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <h3><svg class="title-ico" aria-hidden="true"><use href="#i-split"/></svg>支出类目排行</h3>
              <span class="hint" id="catRankHint">本月</span>
            </div>
            <ul class="rank-list" id="catRankList"></ul>
            <button class="rank-more" id="catRankMore" type="button" hidden>
              展开 <svg class="rank-caret" aria-hidden="true"><use href="#i-caret"/></svg>
            </button>
          </div>

          <div class="card">
            <div class="card-head">
              <h3><svg class="title-ico" aria-hidden="true"><use href="#i-trend"/></svg>支出趋势</h3>
              <span class="hint" id="trendMonthHint">本月</span>
            </div>
            <p class="trend-peak" id="trendPeak">本月还没有支出记录，趋势图空着。</p>
            <div class="trend-kv">
              <div><b id="trendAvg">¥0.00</b><small>本月平均每日支出</small></div>
              <div><b id="trendCount">0 笔</b><small>本月累计支出笔数</small></div>
            </div>
            <div class="trend-wrap trend-wrap-line">
              <svg id="monthTrendChart" viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet" aria-hidden="true"></svg>
            </div>
            <ul class="chart-legend">
              <li><i class="lg-ring exp"></i>支出</li>
              <li><i class="lg-ring inc"></i>收入</li>
              <li><i class="lg-ring bal"></i>结余</li>
            </ul>
          </div>

          <div class="card">
            <div class="card-head">
              <h3><svg class="title-ico" aria-hidden="true"><use href="#i-receipt"/></svg>支出明细排行</h3>
              <span class="hint" id="topSpendHint">Top 5</span>
            </div>
            <ul class="top-list" id="topSpendList"></ul>
            <button class="rank-more" id="topSpendMore" type="button" hidden>
              展开 <svg class="rank-caret" aria-hidden="true"><use href="#i-caret"/></svg>
            </button>
          </div>

          <div class="dash-sec"><span>L5 流水与成就</span><i></i></div>

          <div class="card">
            <div class="card-head">
              <h3>本月账单流水</h3>
              <button class="btn-mini btn-filter" id="btnBillFilter" type="button">
                <svg class="bf-btn-ico" aria-hidden="true"><use href="#i-filter"/></svg><span>筛选</span>
              </button>
            </div>
            <div class="bf-bar" id="billFilterBar" hidden></div>
            <ul class="bill-list" id="billList"></ul>
          </div>

          <div class="card card-achieve ui-full-only" id="achieveCard"></div>

          <div class="card" id="goalCard">
            <div class="card-head">
              <h3>理财目标池</h3>
              <button class="btn-mini" id="btnAddGoal" type="button">+ 新目标</button>
            </div>
            <div class="goal-list" id="goalList"></div>
          </div>

        </div>
      </aside>

      <!-- 理财专家是核心附加能力，两种 UI 模式下都应可达，故不带 ui-full-only -->
      <aside class="panel panel-coach" id="panelCoach">
        <div class="coach-scroll">

          <div class="card coach-hero">
            <div class="coach-hero-avatar"><svg class="cap-ico"><use href="#i-cap"/></svg></div>
            <div class="coach-hero-text">
              <b>理财专家 · 小衡</b>
              <small>懂校园生活的省钱搞钱顾问</small>
            </div>
            <button class="btn-mini coach-back" id="btnCoachBack" type="button" title="返回上一页">‹ 返回</button>
            <button class="btn-mini" id="btnAskCoach" type="button">问专家</button>
          </div>

          <!-- 消费性格测试（persona.js）：#personaBody 只放「上次结果 + 进入测试」入口，
               答题与完整结果都在 #personaSheet 弹窗里；
               教练面板在完整版 / 简洁版共享同一节点，两种 UI 下都可达。
               位置：紧挨专家头图下方、专属建议之上——新功能先露脸，建议类内容跟在后面 -->
          <div class="dash-sec"><span>消费性格</span><i></i></div>
          <div class="card card-persona" id="personaCard">
            <div class="card-head">
              <h3><svg class="title-ico" aria-hidden="true"><use href="#i-dna"/></svg>消费性格测试</h3>
            </div>
            <div class="persona-body" id="personaBody" aria-live="polite"></div>
          </div>

          <div class="dash-sec"><span>专属建议</span><i></i></div>
          <div class="coach-tips" id="coachTips"></div>

          <!-- 团购省钱（coach.js: groupBuyPanelHtml）：校外吃玩先搜券再下单。
               #groupBuyBody 只放容器，规则文案全部由 JS 生成，
               与聊天气泡里的团购答案共用同一份常量，避免两处措辞漂移 -->
          <div class="dash-sec"><span>团购省钱</span><i></i></div>
          <div class="card card-groupbuy" id="groupBuyCard">
            <div class="card-head">
              <h3><svg class="title-ico" aria-hidden="true"><use href="#i-ticket"/></svg>校外吃玩先搜券</h3>
            </div>
            <div class="gb-body" id="groupBuyBody" aria-live="polite"></div>
          </div>

          <div class="dash-sec"><span>理财学院</span><i></i></div>
          <div class="coach-academy" id="coachAcademy"></div>

          <p class="coach-disclaimer">专家建议基于你的本机账单生成，仅供参考，不构成投资建议。</p>
        </div>
      </aside>
    </main>

    <nav class="tabbar" id="tabbar">
      <button class="tab active" type="button" data-view="chat">聊天</button>
      <button class="tab" type="button" data-view="dash">看板</button>
      <button class="tab" type="button" data-view="coach">理财专家</button>
      <button class="tab ui-full-only" type="button" data-view="goals">目标</button>
    </nav>
  </div>

  <!-- ======================= 简洁版 · 日常型（单功能单屏） ======================= -->
  <div class="simple-shell" id="simpleShell">
    <!-- 记账（首页） -->
    <section class="sp-screen sp-home" id="panelSimpleHome">
      <header class="sp-top">
        <div class="sp-hi">
          <h2 id="spGreet">嗨，记账小助手</h2>
          <p id="spDateLine">今天想记点什么？</p>
        </div>
        <button class="sp-me" id="spBtnMe" type="button" aria-label="我的">我</button>
      </header>
      <div class="sp-body">
        <div class="sp-hero">
          <div class="sp-hero-num" id="spRemain">¥0.00</div>
          <div class="sp-hero-sub">本月剩余金额 · 日均可用 <b id="spDaily">¥0.00</b></div>
          <button class="sp-hero-btn" id="spBtnAdd" type="button">＋ 记一笔</button>
        </div>
        <button class="sp-ai" id="spBtnAi" type="button">
          <span class="sp-ai-ico"><svg><use href="#i-spark"/></svg></span>
          <span class="sp-ai-main"><b>AI 对话记账</b><small>说一句话就记上，比如「午饭 15」</small></span>
          <span class="sp-ai-go">›</span>
        </button>
        <button class="sp-ai sp-piggy-entry" id="spBtnPiggyQuick" type="button">
          <span class="sp-ai-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-piggy"/></svg></span>
          <span class="sp-ai-main"><b>存钱罐</b><small>把闲钱锁进来，攒得更快 · 随时可取</small></span>
          <span class="sp-ai-go">›</span>
        </button>
        <div class="sp-quick" id="spQuick"></div>
        <div class="sp-wishcard" id="spWishCard" role="button" tabindex="0" aria-label="打开心愿单" hidden></div>
        <div class="sp-sec">今日流水 <span class="sp-sec-sub">最近账单</span></div>
        <ul class="sp-bills" id="spTodayBills"></ul>
      </div>
    </section>

    <!-- 明细 -->
    <section class="sp-screen sp-list" id="panelSimpleList">
      <header class="sp-top sp-top-plain"><h2>明细</h2>
        <button class="btn-mini btn-filter sp-head-filter" id="btnSpBillFilter" type="button">
          <svg class="bf-btn-ico" aria-hidden="true"><use href="#i-filter"/></svg><span>筛选</span>
        </button>
      </header>
      <div class="sp-month">
        <button class="sp-mnav" id="spMonthPrev" type="button" aria-label="上个月">‹</button>
        <span id="spMonthLabel">本月</span>
        <button class="sp-mnav" id="spMonthNext" type="button" aria-label="下个月">›</button>
      </div>
      <div class="sp-month-sum">
        <div><b id="spMExpense">¥0.00</b><small>本月支出</small></div>
        <div class="sp-inc"><b id="spMIncome">¥0.00</b><small>本月收入</small></div>
      </div>
      <div class="bf-bar sp-filter-bar" id="spFilterBar" hidden></div>
      <div class="sp-body" id="spListBody"></div>
    </section>

    <!-- 预算 -->
    <section class="sp-screen sp-budget" id="panelSimpleBudget">
      <header class="sp-top sp-top-plain"><h2>本月预算</h2></header>
      <div class="sp-body">
        <div class="sp-ringbox">
          <svg class="sp-ring" viewBox="0 0 140 140" aria-hidden="true">
            <circle class="sp-ring-track" cx="70" cy="70" r="58"></circle>
            <circle class="sp-ring-bar" id="spRingBar" cx="70" cy="70" r="58"></circle>
          </svg>
          <div class="sp-ring-center">
            <b id="spRingPct">0%</b><small>已用</small>
          </div>
        </div>
        <div class="sp-ring-amt">已花 <b id="spSpent">¥0.00</b> / 预算 <span id="spTotal">¥0.00</span><span class="sp-ring-piggy" id="spPiggyNote" hidden></span></div>
        <div class="sp-stats3">
          <div><b id="spBRemain">¥0.00</b><small>剩余</small></div>
          <div><b id="spBDaily">¥0.00</b><small>日均可用</small></div>
          <div><b id="spBDays">0 天</b><small>剩余天数</small></div>
        </div>
        <div class="sp-forecast" id="spForecast" hidden></div>
        <div class="sp-diag" id="spDiag" aria-live="polite" hidden></div>
        <div class="sp-sec">分类占比</div>
        <ul class="sp-catbars" id="spCatBars"></ul>
        <button class="sp-blockbtn" id="spBtnBudget" type="button">调整预算 / 设置发钱日</button>
      </div>
    </section>

    <!-- 攒钱目标（#goalCard 由 JS 在简洁版模式下移入本屏） -->
    <section class="sp-screen sp-goals" id="panelSimpleGoals">
      <header class="sp-top sp-top-back">
        <button class="sp-back" id="spGoalsBack" type="button" aria-label="返回">‹</button>
        <h2>攒钱目标</h2>
      </header>
      <div class="sp-body" id="spGoalsBody"></div>
    </section>

    <!-- 存钱罐（#spPiggyBody 由 renderSimplePiggy 渲染） -->
    <section class="sp-screen sp-piggy" id="panelSimplePiggy" aria-label="存钱罐">
      <header class="sp-top sp-top-back">
        <button class="sp-back" id="spPiggyBack" type="button" aria-label="返回">‹</button>
        <h2>存钱罐</h2>
      </header>
      <div class="sp-body" id="spPiggyBody"></div>
    </section>

    <!-- 省钱（雷达 + 图谱）：#saveHubSheet 由 JS 在简洁版模式下移入 #spSaveBody，作为独立页面而非弹层 -->
    <section class="sp-screen sp-save" id="panelSimpleSave" aria-label="省钱助手">
      <header class="sp-top">
        <div class="sp-hi"><h2>省钱助手</h2><p>哪天有活动、怎么操作才省</p></div>
      </header>
      <div class="sp-save-body" id="spSaveBody"></div>
    </section>

    <!-- 我的 -->
    <section class="sp-screen sp-profile" id="panelSimpleProfile">
      <header class="sp-top sp-top-plain"><h2>我的</h2></header>
      <div class="sp-body">
        <div class="sp-pcard">
          <div class="sp-pava" id="spPAva">我</div>
          <div class="sp-pmeta">
            <b id="spPName">记账小助手</b>
            <small id="spPSub">校园记账 · 一起攒钱</small>
          </div>
        </div>
        <div class="sp-pstats">
          <div><b id="spStatDays">0</b><small>记账天数</small></div>
          <div><b id="spStatCount">0</b><small>本月笔数</small></div>
          <div><b id="spStatSaved">¥0</b><small>冷静期省下</small></div>
        </div>
        <div class="sp-sec">界面风格</div>
        <div class="sp-uicard">
          <div class="sp-uitip">日常高频用简洁版，深度分析用完整版</div>
          <div class="set-seg" id="spUiSeg">
            <label class="seg-item"><input type="radio" name="spUiMode" value="simple" /><span>简洁版</span></label>
            <label class="seg-item"><input type="radio" name="spUiMode" value="full" /><span>完整版</span></label>
          </div>
        </div>
        <ul class="sp-menu">
          <!-- 消费性格测试：简洁版也走同一套线性图标（i-dna），与菜单里其他 .mi 图标同风格；
               点开直接弹测试窗，不用先切到理财专家页。新功能放最上方。 -->
          <li><button type="button" id="spMenuPersona"><svg class="mi"><use href="#i-dna"/></svg>消费性格测试<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuAi"><svg class="mi"><use href="#i-chat"/></svg>AI 对话记账<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuSaveHub"><svg class="mi"><use href="#i-bulb"/></svg>省钱助手<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuCoach"><svg class="mi"><use href="#i-cap"/></svg>理财专家<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuGoals"><svg class="mi"><use href="#i-target"/></svg>攒钱目标<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuPiggy"><svg class="mi"><use href="#i-piggy"/></svg>存钱罐<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuWish"><svg class="mi"><use href="#i-clock"/></svg>心愿单<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuBudget"><svg class="mi"><use href="#i-wallet"/></svg>预算设置<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuExport"><svg class="mi"><use href="#i-download"/></svg>数据导出<span class="ar">›</span></button></li>
          <li><button type="button" id="spMenuAbout"><svg class="mi"><use href="#i-info"/></svg>关于我们<span class="ar">›</span></button></li>
        </ul>
      </div>
    </section>

    <nav class="tabbar tabbar-simple" id="tabbarSimple">
      <button class="tab" type="button" data-view="shome"><svg class="t-ico"><use href="#i-pencil"/></svg>记账</button>
      <button class="tab" type="button" data-view="slist"><svg class="t-ico"><use href="#i-receipt"/></svg>明细</button>
      <button class="tab" type="button" data-view="sbudget"><svg class="t-ico"><use href="#i-target"/></svg>预算</button>
      <button class="tab" type="button" data-view="ssave"><svg class="t-ico"><use href="#i-wallet"/></svg>省钱助手</button>
      <button class="tab" type="button" data-view="scoach"><svg class="t-ico"><use href="#i-cap"/></svg>理财专家</button>
      <button class="tab" type="button" data-view="sprofile"><svg class="t-ico"><use href="#i-user"/></svg>我的</button>
    </nav>
  </div>

  <div class="drawer-mask" id="drawerMask" hidden></div>
  <aside class="drawer" id="settingsDrawer" aria-hidden="true">
    <div class="drawer-head">
      <h3>设置</h3>
      <button class="btn-icon" id="btnCloseDrawer" type="button" aria-label="关闭">✕</button>
    </div>

    <section class="drawer-group">
      <h4 class="drawer-group-title">预算设置</h4>
      <label class="field">
        <span>每月生活费（¥）</span>
        <input type="number" id="setTotal" min="0" step="50" inputmode="decimal" />
      </label>
      <label class="field">
        <span>每月生活费到账日（1-28，以此为周期起点）</span>
        <input type="number" id="setPayday" min="1" max="28" step="1" inputmode="numeric" />
      </label>
      <label class="field">
        <span>单笔冷静期阈值（¥）</span>
        <input type="number" id="setCooldown" min="0" step="10" inputmode="decimal" />
      </label>
      <div class="drawer-cycle">
        <span id="cycleInfo">—</span>
        <button class="btn-mini" id="btnCycleReset" type="button">恢复按发钱日算</button>
      </div>
      <button class="btn-primary" id="btnSaveSettings" type="button">保存并重算</button>
      <p class="drawer-note">预算周期按发钱日计算：发钱日为 15 号时，本周期是 15 号到次月 14 号，而不是自然月。生活费等大额收入到账时可选择从现在重新起算。</p>
    </section>

    <section class="drawer-group">
      <h4 class="drawer-group-title">截图识别（可选）</h4>
      <p class="drawer-note">Key 存在本机浏览器，仅本地调用，勿在公用电脑填写。不填时不会发任何网络请求；截屏自动识别还需要浏览器自带本地文字识别能力。</p>
      <label class="field">
        <span>SecretId</span>
        <input type="text" id="setOcrId" autocomplete="off" spellcheck="false" />
      </label>
      <label class="field">
        <span>SecretKey</span>
        <input type="password" id="setOcrKey" autocomplete="off" />
      </label>
      <label class="field">
        <span>地域 Region</span>
        <input type="text" id="setOcrRegion" placeholder="ap-guangzhou" autocomplete="off" />
      </label>
      <div class="ocr-cred-actions">
        <button class="btn-mini primary" id="btnSaveOcr" type="button">保存凭据</button>
        <button class="btn-mini" id="btnClearOcr" type="button">清除凭据</button>
      </div>
      <p class="drawer-note" id="ocrState">当前：未配置云 OCR（不会发网络请求）。不配置时，截屏识别只能用示例小票或手动录入。</p>
    </section>

    <section class="drawer-group">
      <h4 class="drawer-group-title">数据管理</h4>
      <div class="drawer-actions">
        <button class="btn-mini" id="btnDrawerExport" type="button">导出 CSV</button>
        <button class="btn-mini" id="btnDrawerImport" type="button">导入账单</button>
        <button class="btn-mini danger" id="btnDrawerReset" type="button">重置演示数据</button>
      </div>
      <p class="drawer-note">账本数据只保存在本机浏览器；导出 CSV 可用于备份或在「账单分析」中重新导入。重置会清空当前演示数据，不可恢复。</p>
    </section>
  </aside>

  <div class="modal-mask" id="modalMask" hidden>
    <div class="modal" id="modalBox" role="dialog" aria-modal="true"></div>
  </div>

  <!-- ==================== 账单分析（全屏 sheet） ==================== -->
  <div class="sheet-mask" id="analysisMask" hidden>
    <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="analysisTitle">
      <header class="sheet-head">
        <h3 id="analysisTitle"><svg class="title-ico"><use href="#i-bar"/></svg>账单分析</h3>
        <button class="btn-icon" id="btnCloseAnalysis" type="button" aria-label="关闭">✕</button>
      </header>
      <div class="sheet-body" id="analysisBody">
        <div class="analysis-tabs" id="analysisTabs">
          <button type="button" class="atab active" data-act="an-mode" data-mode="current">当前账本</button>
          <button type="button" class="atab" data-act="an-mode" data-mode="imported">导入 CSV</button>
        </div>
        <div class="analysis-current-banner" id="analysisCurrentBanner" hidden></div>
        <div class="drop-zone" id="analysisDrop">
          <div class="drop-icon"><svg class="di-ico"><use href="#i-receipt"/></svg></div>
          <div class="drop-title">点击选择，或把支付宝 / 微信 / 银行导出的 CSV 拖进来</div>
          <div class="drop-sub">支持多选 · .csv / .txt · 默认只分析，不写入账本</div>
          <input type="file" id="analysisFile" accept=".csv,.txt,text/csv" multiple hidden />
        </div>
        <div class="analysis-status" id="analysisStatus">还没有导入文件。导出账单时请选择「CSV」，不要用 PDF。</div>
        <div class="analysis-toolbar" id="analysisToolbar" hidden>
          <label class="checkbox-line">
            <input type="checkbox" id="analysisExcludeDup" />
            <span>排除疑似重复项重新统计</span>
          </label>
          <span class="hint" id="analysisMonthHint">—</span>
        </div>
        <div class="analysis-report" id="analysisReport"></div>
      </div>
      <footer class="sheet-foot">
        <button class="btn-mini" id="btnAnalysisExport" type="button">导出 Markdown</button>
        <button class="btn-mini primary" id="btnAnalysisImport" type="button">把导入记录并入账本</button>
        <button class="btn-mini danger" id="btnAnalysisClear" type="button">清空导入</button>
      </footer>
  </section>
</div>

<!-- ==================== 导入账单（微信 / 支付宝 / 银行 CSV） ==================== -->
<div class="sheet-mask" id="importMask" hidden>
  <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="importTitle">
    <header class="sheet-head">
      <h3 id="importTitle"><svg class="title-ico"><use href="#i-download"/></svg>导入账单</h3>
      <button class="btn-icon" id="btnCloseImport" type="button" aria-label="关闭">✕</button>
    </header>
    <div class="sheet-body" id="importBody">
      <div class="import-guide" id="importGuide">
        <div class="ig-item"><b>微信</b>：我 → 服务 → 钱包 → 账单 → 常见问题 → 下载账单（选「用于个人对账」）→ 得到 CSV</div>
        <div class="ig-item"><b>支付宝</b>：我的 → 账单 → 右上角 ⋯ → 开具交易流水证明 / 导出 → 选 CSV（不要用 PDF）</div>
        <div class="ig-sub">支持多选文件；转账 / 还款 / 提现会自动排除；导入后可在聊天里给每笔「值不值」打分。数据只在本机，不上传。</div>
      </div>
      <div class="drop-zone" id="importDrop">
        <div class="drop-icon"><svg class="di-ico"><use href="#i-receipt"/></svg></div>
        <div class="drop-title">点击选择，或把微信 / 支付宝 / 银行导出的 CSV 拖进来</div>
        <div class="drop-sub">支持多选 · .csv / .txt</div>
        <input type="file" id="importFile" accept=".csv,.txt,text/csv" multiple hidden />
      </div>
      <div class="analysis-status" id="importStatus">还没有选择文件。</div>
      <div class="import-controls" id="importControls" hidden>
        <label class="checkbox-line">
          <input type="checkbox" id="importExcludeDup" checked />
          <span>排除与账本重复的记录（按 日期 + 金额 + 备注 判断）</span>
        </label>
        <label class="checkbox-line">
          <input type="checkbox" id="importExcludeFileDup" />
          <span>同时排除导入文件内部的重复项</span>
        </label>
        <label class="select-line">
          <span>只导入月份</span>
          <select id="importMonth"></select>
        </label>
      </div>
      <div class="analysis-report" id="importReport"></div>
    </div>
    <footer class="sheet-foot">
      <button class="btn-mini" id="btnImportClear" type="button">清空</button>
      <button class="btn-mini primary" id="btnImportConfirm" type="button">确认导入到账本</button>
    </footer>
  </section>
</div>

<!-- ==================== 设置（完整设置界面） ==================== -->
<div class="sheet-mask" id="settingsMask" hidden>
  <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="setPageTitle">
    <header class="sheet-head">
      <h3 id="setPageTitle"><svg class="title-ico"><use href="#i-gear"/></svg>设置</h3>
      <button class="btn-icon" id="btnCloseSetPage" type="button" aria-label="关闭">✕</button>
    </header>
    <div class="sheet-body" id="setPageBody">

      <!-- 账号与安全 -->
      <section class="set-group" id="setGroupAccount">
        <h4 class="set-group-title">账号与安全</h4>
        <div class="set-card">
          <button type="button" class="set-row" id="rowSetProfile">
            <svg class="set-ico"><use href="#i-user"/></svg>
            <span class="set-main"><b>头像与昵称</b><small id="setProfileDesc">点击修改头像和昵称</small></span>
            <span class="set-value" id="setProfileValue">同学</span>
            <span class="set-arrow">›</span>
          </button>
          <button type="button" class="set-row" id="rowSetBind">
            <svg class="set-ico"><use href="#i-link"/></svg>
            <span class="set-main"><b>账号绑定</b><small>微信 / 手机号 / 邮箱</small></span>
            <span class="set-value">未绑定</span>
            <span class="set-arrow">›</span>
          </button>
          <button type="button" class="set-row" id="rowSetPassword">
            <svg class="set-ico"><use href="#i-lock"/></svg>
            <span class="set-main"><b>登录密码</b><small>定期修改更安全</small></span>
            <span class="set-value">未设置</span>
            <span class="set-arrow">›</span>
          </button>
        </div>
      </section>

      <!-- 界面风格 -->
      <section class="set-group" id="setGroupUi">
        <h4 class="set-group-title">界面风格</h4>
        <div class="set-card">
          <div class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-spark"/></svg>
            <span class="set-main"><b>UI 类型</b><small>简洁版日常高频，完整版报表详尽</small></span>
            <div class="set-seg" id="setUiModeSeg">
              <label class="seg-item"><input type="radio" name="setUiMode" value="simple" /><span>简洁版</span></label>
              <label class="seg-item"><input type="radio" name="setUiMode" value="full" checked /><span>完整版</span></label>
            </div>
          </div>
          <div class="set-sub">两种类型共用同一套账单数据，切换即时生效、互不丢失。</div>
        </div>
      </section>

      <!-- 通用与偏好 -->
      <section class="set-group" id="setGroupGeneral">
        <h4 class="set-group-title">通用与偏好</h4>
        <div class="set-card">
          <div class="set-sub">消息通知</div>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-bell"/></svg>
            <span class="set-main"><b>系统推送</b><small>重要公告与更新提醒</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchPush" checked />
          </label>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-clock"/></svg>
            <span class="set-main"><b>记账提醒</b><small>每天晚上提醒记一笔</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchRemind" checked />
          </label>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-alert"/></svg>
            <span class="set-main"><b>超支提醒</b><small>预算快花完时提醒我</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchOverspend" checked />
          </label>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-spark"/></svg>
            <span class="set-main"><b>戳一戳宠物</b><small>点击宠物时随机聊一句（关闭后点击静默）</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchPoke" checked />
          </label>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-spark"/></svg>
            <span class="set-main"><b>桌面宠物</b><small>右下角常驻可拖动的小家伙，记账 / 超支自动变脸</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchPet" checked />
          </label>
          <div class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-piggy"/></svg>
            <span class="set-main"><b>宠物形象</b><small>阿账播报预算心情，存钱罐精灵更活泼，记账小管家能自定义形象</small></span>
            <div class="set-seg" id="setSkinSeg">
              <label class="seg-item"><input type="radio" name="setPetSkin" value="azhang" checked /><span>阿账</span></label>
              <label class="seg-item"><input type="radio" name="setPetSkin" value="sprite" /><span>存钱罐精灵</span></label>
              <label class="seg-item"><input type="radio" name="setPetSkin" value="pro" /><span>记账小管家</span></label>
            </div>
          </div>
          <button type="button" class="set-row" id="rowPetStudio">
            <svg class="set-ico"><use href="#i-camera"/></svg>
            <span class="set-main"><b>自定义我的形象</b><small>上传一张照片生成专属小人，选它之后自动切到记账小管家</small></span>
            <span class="set-chev" aria-hidden="true">›</span>
          </button>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-bell"/></svg>
            <span class="set-main"><b>互动反馈</b><small>记账 / 存钱时的音效与震动</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchFx" checked />
          </label>
          <div class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-moon"/></svg>
            <span class="set-main"><b>深色模式</b><small>跟随系统或手动选择</small></span>
            <div class="set-seg" id="setThemeSeg">
              <label class="seg-item"><input type="radio" name="setThemeMode" value="system" checked /><span>跟随系统</span></label>
              <label class="seg-item"><input type="radio" name="setThemeMode" value="light" /><span>浅色</span></label>
              <label class="seg-item"><input type="radio" name="setThemeMode" value="dark" /><span>深色</span></label>
            </div>
          </div>
          <div class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-font"/></svg>
            <span class="set-main"><b>字体大小</b><small>放大聊天与看板文字</small></span>
            <div class="set-seg" id="setFontSeg">
              <label class="seg-item"><input type="radio" name="setFontScale" value="sm" /><span>小</span></label>
              <label class="seg-item"><input type="radio" name="setFontScale" value="md" checked /><span>标准</span></label>
              <label class="seg-item"><input type="radio" name="setFontScale" value="lg" /><span>大</span></label>
              <label class="seg-item"><input type="radio" name="setFontScale" value="xl" /><span>特大</span></label>
            </div>
          </div>
          <div class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-globe"/></svg>
            <span class="set-main"><b>语言</b><small>Language</small></span>
            <div class="set-seg" id="setLangSeg">
              <label class="seg-item"><input type="radio" name="setLang" value="zh" checked /><span>简体中文</span></label>
              <label class="seg-item"><input type="radio" name="setLang" value="en" /><span>English</span></label>
            </div>
          </div>
        </div>
      </section>

      <!-- 消费诊断 -->
      <section class="set-group" id="setGroupDiag">
        <h4 class="set-group-title">消费诊断</h4>
        <div class="set-card">
          <div class="set-sub">诊断卡按这几条规则给你提示</div>
          <label class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-alert"/></svg>
            <span class="set-main"><b>单日支出上限</b><small>某一天花超这个数就会被点名（0 = 关闭该规则）</small></span>
            <div class="set-cap-input">
              <span class="sci-unit">¥</span>
              <input id="setDailyCap" type="number" inputmode="numeric" min="0" max="99999" step="10"
                     aria-label="单日支出上限（元）" />
            </div>
          </label>
        </div>
      </section>

      <!-- 说话风格 -->
      <section class="set-group" id="setGroupTone">
        <h4 class="set-group-title">说话风格</h4>
        <div class="set-card" id="setToneGroup">
          <div class="set-sub">AI 提醒你时的语气，切换立即生效</div>
          <label class="set-tone-card">
            <input type="radio" name="setTone" value="gentle" />
            <span class="stc-main"><b>温柔学姐</b><small>先接住情绪，再给建议</small></span>
            <span class="stc-sample" data-tone-sample="gentle"></span>
          </label>
          <label class="set-tone-card">
            <input type="radio" name="setTone" value="strict" />
            <span class="stc-main"><b>铁面教练</b><small>不哄你，只说问题</small></span>
            <span class="stc-sample" data-tone-sample="strict"></span>
          </label>
          <label class="set-tone-card">
            <input type="radio" name="setTone" value="rational" />
            <span class="stc-main"><b>理性分析官</b><small>只讲数据和结论</small></span>
            <span class="stc-sample" data-tone-sample="rational"></span>
          </label>
        </div>
      </section>

      <!-- 数据与隐私 -->
      <section class="set-group" id="setGroupData">
        <h4 class="set-group-title">数据与隐私</h4>
        <div class="set-card">
          <button type="button" class="set-row" id="rowSetCache">
            <svg class="set-ico"><use href="#i-broom"/></svg>
            <span class="set-main"><b>清理缓存</b><small>只清缓存，不动账本数据</small></span>
            <span class="set-value" id="setCacheValue">0 B</span>
            <span class="set-arrow">›</span>
          </button>
          <div class="set-sub">隐私设置</div>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-camera"/></svg>
            <span class="set-main"><b>允许读取相册</b><small>截屏记账需要选择图片</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchAlbum" checked />
          </label>
          <label class="set-row set-row-switch">
            <svg class="set-ico"><use href="#i-clipboard"/></svg>
            <span class="set-main"><b>允许读取剪贴板</b><small>支持粘贴截图快速记账</small></span>
            <input type="checkbox" class="set-switch" id="setSwitchClipboard" checked />
          </label>
          <button type="button" class="set-row" id="rowSetTerms">
            <svg class="set-ico"><use href="#i-doc"/></svg>
            <span class="set-main"><b>用户协议与隐私政策</b><small>了解数据如何存放与使用</small></span>
            <span class="set-arrow">›</span>
          </button>
          <button type="button" class="set-row" id="rowSetExport">
            <svg class="set-ico"><use href="#i-download"/></svg>
            <span class="set-main"><b>个人信息导出</b><small>下载账本统计概览与设置（JSON）</small></span>
            <span class="set-arrow">›</span>
          </button>
          <button type="button" class="set-row set-row-danger" id="rowSetDeleteAccount">
            <svg class="set-ico"><use href="#i-trash"/></svg>
            <span class="set-main"><b>注销账号</b><small>清空本机全部数据，不可恢复</small></span>
            <span class="set-arrow">›</span>
          </button>
        </div>
      </section>

      <!-- 帮助与反馈 -->
      <section class="set-group" id="setGroupHelp">
        <h4 class="set-group-title">帮助与反馈</h4>
        <div class="set-card">
          <div class="set-faq-list" id="setFaqList">
            <details class="set-faq">
              <summary>新手怎么用？</summary>
              <p>直接在聊天框输入一句话，比如「中午食堂 15」，我就会记下来。也可以点顶部的「截屏记账」识别小票，或用「导入账单」批量导入微信 / 支付宝账单 CSV。</p>
            </details>
            <details class="set-faq">
              <summary>怎么修改 / 删除账单？</summary>
              <p>在聊天里点「撤回上一步」可以撤销最近一笔记账；看板的「本月账单流水」能看到最近的记录。演示版本暂不支持单笔编辑。</p>
            </details>
            <details class="set-faq">
              <summary>怎么导入微信 / 支付宝账单？</summary>
              <p>点顶部「导入账单」，选择账单导出里的 CSV 文件（不要用 PDF）。支持多选，导入前可以预览、按月份筛选，确认后才会写入账本。</p>
            </details>
            <details class="set-faq">
              <summary>「撤回」和「值不值」是什么？</summary>
              <p>「撤回」用于撤销误记的账；每笔支出记账后可以给它打「值不值」，帮你复盘哪些钱花得开心、哪些后悔。</p>
            </details>
          </div>
          <div class="set-row set-row-col">
            <svg class="set-ico"><use href="#i-pencil"/></svg>
            <span class="set-main"><b>意见反馈</b><small>遇到问题或有好建议，告诉我们</small></span>
            <textarea class="set-textarea" id="setFeedbackInput" rows="3" maxlength="500" placeholder="写下你的建议（500 字以内，仅保存在本机）"></textarea>
            <button type="button" class="btn-mini primary set-feedback-btn" id="btnSetFeedback">提交反馈</button>
          </div>
          <div class="set-row set-row-static">
            <svg class="set-ico"><use href="#i-mail"/></svg>
            <span class="set-main"><b>联系我们</b><small>客服邮箱：support@zhangxiaozhu.app</small></span>
            <span class="set-value">工作日 9:00-18:00</span>
          </div>
        </div>
      </section>

      <!-- 关于 -->
      <section class="set-group" id="setGroupAbout">
        <h4 class="set-group-title">关于</h4>
        <div class="set-card">
          <div class="set-row set-row-static">
            <svg class="set-ico"><use href="#i-info"/></svg>
            <span class="set-main"><b>关于我们</b><small>AI 校园记账管家：一句话记账、月末防吃土，陪你看清每一笔花销。「AI 记账 · 创新应用大赛作品」</small></span>
          </div>
          <div class="set-row set-row-static">
            <svg class="set-ico"><use href="#i-update"/></svg>
            <span class="set-main"><b>检查更新</b><small>当前版本 v1.0.0</small></span>
            <button type="button" class="btn-mini" id="btnSetCheckUpdate">检查更新</button>
          </div>
          <div class="set-row set-row-static">
            <svg class="set-ico"><use href="#i-scale"/></svg>
            <span class="set-main"><b>免责声明</b><small>AI 建议仅供参考，不构成专业理财投资建议</small></span>
          </div>
        </div>
      </section>

    </div>
  </section>
</div>

<!-- ==================== 截屏记账 ==================== -->
  <div class="modal-mask" id="ocrMask" hidden>
    <div class="modal modal-ocr" id="ocrBox" role="dialog" aria-modal="true" aria-labelledby="ocrTitle">
      <div class="modal-head">
        <h4 id="ocrTitle"><svg class="title-ico"><use href="#i-camera"/></svg>截屏记账</h4>
        <button class="btn-icon" id="btnCloseOcr" type="button" aria-label="关闭">✕</button>
      </div>
      <div class="ocr-body">
        <div class="drop-zone drop-zone-sm" id="ocrDrop">
          <div class="drop-icon"><svg class="di-ico"><use href="#i-camera"/></svg></div>
          <div class="drop-title">点击选择 / 拖拽 / Ctrl+V 粘贴截图</div>
          <div class="drop-sub">截图会发送给 WorkBuddy 云服务做视觉识别（免密钥）；也可直接用示例小票或手动录入</div>
          <input type="file" id="ocrFile" accept="image/*" hidden />
        </div>
        <img class="ocr-preview" id="ocrPreview" alt="截图预览" hidden />
        <div class="ocr-demo" id="ocrDemoList"></div>
        <div class="ocr-status" id="ocrStatus"></div>
        <div class="ocr-result" id="ocrResult"></div>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" id="btnOcrCancel" type="button">关闭</button>
        <button class="btn-ok" id="btnOcrRun" type="button">开始识别</button>
      </div>
    </div>
  </div>

  <!-- ==================== 存钱罐（完整版弹层 / 简洁版整页共用同一段渲染） ==================== -->
  <div class="sheet-mask" id="piggyMask" hidden>
    <section class="sheet sheet-piggy" id="piggySheet" role="dialog" aria-modal="true" aria-labelledby="piggyTitle">
      <header class="sheet-head">
        <h3 id="piggyTitle"><svg class="title-ico"><use href="#i-piggy"/></svg>存钱罐</h3>
        <button class="btn-icon" id="btnClosePiggy" type="button" aria-label="关闭">✕</button>
      </header>
      <div class="sheet-body" id="piggyBody"></div>
      <footer class="sheet-foot">
        <span class="piggy-foot-note">存入的钱从账面可用余额挪进罐子，会计入「已用」，但不算消费支出</span>
      </footer>
    </section>
  </div>

  <!-- ==================== 心愿单（冷静期清单 · 独立存储键，弹层形式） ==================== -->
  <div class="sheet-mask" id="wishMask" hidden>
    <section class="sheet sheet-wish" id="wishSheet" role="dialog" aria-modal="true" aria-labelledby="wishTitle">
      <header class="sheet-head">
        <h3 id="wishTitle"><svg class="title-ico"><use href="#i-clock"/></svg>心愿单</h3>
        <button class="btn-icon" id="btnCloseWish" type="button" aria-label="关闭">✕</button>
      </header>
      <div class="sheet-body" id="wishBody"></div>
    </section>
  </div>

  <!-- ==================== 消费性格测试（弹窗：选题量 → 答题 → 结果 + 分点建议） ==================== -->
  <div class="sheet-mask" id="personaMask" hidden>
    <section class="sheet sheet-persona" id="personaSheet" role="dialog" aria-modal="true" aria-labelledby="personaTitle">
      <header class="sheet-head">
        <h3 id="personaTitle"><svg class="title-ico"><use href="#i-dna"/></svg>消费性格测试</h3>
        <button class="btn-icon" id="btnClosePersona" type="button" aria-label="关闭">✕</button>
      </header>
      <div class="sheet-body" id="personaSheetBody"></div>
    </section>
  </div>

  <!-- ==================== 账单筛选（完整版 / 简洁版共用同一抽屉） ==================== -->
  <div class="sheet-mask" id="billFilterMask" hidden>
    <section class="sheet sheet-billfilter" id="billFilterSheet" role="dialog" aria-modal="true" aria-labelledby="billFilterTitle">
      <header class="sheet-head">
        <h3 id="billFilterTitle"><svg class="title-ico" aria-hidden="true"><use href="#i-filter"/></svg>账单筛选</h3>
        <button class="btn-icon" id="btnCloseBillFilter" type="button" aria-label="关闭">✕</button>
      </header>
      <div class="sheet-body" id="billFilterBody">
        <div class="bf-section">
          <div class="bf-label">金额区间（元）</div>
          <div class="bf-range">
            <input type="number" class="bf-input" id="bfMin" placeholder="最小" inputmode="decimal" />
            <span class="bf-tilde">~</span>
            <input type="number" class="bf-input" id="bfMax" placeholder="最大" inputmode="decimal" />
          </div>
        </div>
        <div class="bf-section">
          <div class="bf-label-row">
            <span class="bf-label">支出分类</span>
            <button type="button" class="bf-selectall" data-bf-all="cats">全选</button>
          </div>
          <div class="bf-caps" id="bfCats"></div>
        </div>
        <div class="bf-section">
          <div class="bf-label-row">
            <span class="bf-label">收入分类</span>
            <button type="button" class="bf-selectall" data-bf-all="sources">全选</button>
          </div>
          <div class="bf-caps" id="bfSources"></div>
        </div>
        <div class="bf-section">
          <div class="bf-label">备注关键词</div>
          <input type="text" class="bf-input bf-input-full" id="bfNote" placeholder="如：奶茶" />
        </div>
      </div>
      <footer class="sheet-foot bf-foot">
        <button class="btn-cancel" id="btnResetBillFilter" type="button">重置</button>
        <button class="btn-ok" id="btnConfirmBillFilter" type="button">确认</button>
      </footer>
    </section>
  </div>

  <div class="toast-root" id="toastRoot" aria-live="polite"></div>

  <!-- ==================== 省钱（省钱雷达 + 省钱图谱，一个面板一级分段切换） ==================== -->
  <div class="sheet-mask" id="saveHubMask" hidden>
    <section class="sheet sheet-savehub" id="saveHubSheet" role="dialog" aria-modal="true" aria-labelledby="saveHubTitle" data-hub="radar">
      <header class="sheet-head">
        <h3 id="saveHubTitle"><svg class="title-ico"><use href="#i-wallet"/></svg>省钱助手</h3>
        <span class="deals-head-date" id="dealsHeadDate">—</span>
        <span class="savings-head-stat" id="savingsHeadStat">—</span>
        <button class="btn-icon" id="btnCloseSaveHub" type="button" aria-label="关闭">✕</button>
      </header>
      <div class="savehub-seg" id="saveHubSeg" role="tablist" aria-label="省钱助手模块">
        <button type="button" class="shs active" role="tab" aria-selected="true" data-hub="radar">
          <b><svg class="hub-ico"><use href="#i-radar"/></svg>省钱雷达</b><i>哪天有活动、谁更便宜</i>
        </button>
        <button type="button" class="shs" role="tab" aria-selected="false" data-hub="graph">
          <b><svg class="hub-ico"><use href="#i-bulb"/></svg>省钱图谱</b><i>具体怎么操作才省</i>
        </button>
      </div>
      <div class="savehub-views">
        <div class="savehub-view" id="saveHubViewRadar">
          <div class="sheet-body">
            <div class="analysis-tabs" id="dealsTabs">
              <button type="button" class="atab active" data-deal-tab="today">今天</button>
              <button type="button" class="atab" data-deal-tab="calendar">14 天日历</button>
              <button type="button" class="atab" data-deal-tab="compare">比价计算器</button>
              <button type="button" class="atab" data-deal-tab="about">数据说明</button>
            </div>
            <div class="deals-pane" id="dealsPane"></div>
          </div>
          <footer class="sheet-foot">
            <button class="btn-mini" id="btnDealsCsv" type="button">下载真实商家日历.csv</button>
            <button class="btn-mini" id="btnDealsAskKfc" type="button">下一次疯狂星期四</button>
            <span class="deals-foot-note">活动日期本地计算 · 价格只做口径计算，不抓电商页面</span>
          </footer>
        </div>
        <div class="savehub-view" id="saveHubViewGraph" hidden>
          <div class="sheet-body">
            <div class="analysis-tabs" id="savingsTabs">
              <button type="button" class="atab active" data-sv-tab="today">今天</button>
              <button type="button" class="atab" data-sv-tab="map">图谱</button>
              <button type="button" class="atab" data-sv-tab="index">大全</button>
              <button type="button" class="atab" data-sv-tab="book">省钱账</button>
              <button type="button" class="atab" data-sv-tab="about">说明</button>
            </div>
            <div class="savings-pane" id="savingsPane"></div>
          </div>
          <footer class="sheet-foot">
            <button class="btn-mini" id="btnSavingsCsv" type="button">导出省钱记录.csv</button>
            <button class="btn-mini" id="btnSavingsAsk" type="button">今天怎么省</button>
            <span class="savings-foot-note">动作来自《大学生全网省钱图谱》· 金额是估算区间，不保证商家当期价</span>
          </footer>
        </div>
      </div>
    </section>
  </div>

<script>
/**
 * data.js — 全局配置、分类词典、平替词典、演示种子数据
 *
 * 浏览器：通过 <script src="data.js"> 加载，挂载到 window.AJ.data
 * Node  ：require('./data.js') 直接返回 DATA 对象（便于单元测试）
 */
(function (global) {
  'use strict';

  /** localStorage 统一 key */
  var STORAGE_KEY = 'ai_jizhang_v1';

  /** 数据版本号，结构变更时用于迁移 */
  var DATA_VERSION = 1;

  /**
   * 固定分类（"其他" 为兜底分类）
   * color = 品牌淡色，用于比例条 / 圆点 / 淡底（12% 透明度）
   * ink   = 同色系"深墨色"，专用于淡底小方块里的线性图标描边。
   *         实测在各自 12% 淡底上对比度 4.5:1 以上（WCAG AA），
   *         浅色分类（餐饮绿 / 交通青）用原色只有 2:1，会糊在底上看不清。
   * essential = 是否「必需消费」，只给消费诊断卡用：
   *         true  → 餐饮 / 学习 / 交通 / 居住 / 医疗（吃饭、上课、通勤、住宿、看病）
   *         false → 社交 / 购物 / 娱乐 / 其他（可压缩的「想要」）
   *         注意：这是**追加字段**，key / 顺序 / color / ink 一律不动。
   */
  var CATEGORIES = [
    { key: '餐饮', color: '#07C160', ink: '#047A3E', essential: true },
    { key: '社交', color: '#FF8A3D', ink: '#AF5410', essential: false },
    { key: '购物', color: '#7C6CF0', ink: '#5748B8', essential: false },
    { key: '学习', color: '#3D9CFF', ink: '#1C6CBF', essential: true },
    { key: '交通', color: '#2AC6C0', ink: '#0A7570', essential: true },
    { key: '娱乐', color: '#EF5350', ink: '#C0352C', essential: false },
    { key: '居住', color: '#B0803C', ink: '#7D5722', essential: true },
    { key: '电费', color: '#DBA514', ink: '#8A6206', essential: true },
    { key: '燃气费', color: '#D64570', ink: '#8E2444', essential: true },
    { key: '医疗', color: '#E0629A', ink: '#A93765', essential: true },
    { key: '其他', color: '#9AA3AD', ink: '#5E6771', essential: false }
  ];

  /**
   * 分类关键词词典。
   * 打分规则见 nlp.js classify()：最长命中词长度 * 10 + 命中词个数。
   */
  var CATEGORY_KEYWORDS = {
    '餐饮': [
      '食堂', '外卖', '美团', '饿了么', '黄焖鸡', '麻辣烫', '火锅', '烧烤', '米线', '拉面',
      '面条', '饭团', '便当', '奶茶', '咖啡', '星巴克', '瑞幸', '库迪', '蜜雪', '喜茶',
      '霸王茶姬', '奈雪', '茶百道', '古茗', '零食', '水果', '泡面', '饮料', '早餐', '午餐',
      '晚餐', '早饭', '午饭', '晚饭', '夜宵', '宵夜', '吃饭', '米饭', '包子', '馒头', '饺子', '馄饨',
      '粥', '饼', '汉堡', '披萨', '炸鸡', '麻辣香锅', '酸菜鱼', '螺蛳粉', '自助', '可乐',
      '矿泉水', '雪糕', '冰淇淋', '蛋糕', '面包', '食堂饭卡', '饭卡', '肉', '菜', '汤', '面'
    ],
    '社交': [
      '聚餐', 'AA制', 'AA', '请客', '舍友', '室友', '同学', '朋友', '生日', '聚会', '剧本杀', 'KTV',
      '唱歌', '送礼', '份子', '随礼', '红包', '社团', '联谊', '约会', '礼物', '团建', '串门',
      '请吃饭', '聚会', '酒', '啤酒'
    ],
    '购物': [
      '衣服', '鞋', '裤子', '裙子', '卫衣', '外套', '化妆', '护肤', '洗面奶', '洗发水',
      '沐浴露', '纸巾', '日用', '淘宝', '拼多多', '京东', '快递', '耳机', '口红', '面膜',
      '牙膏', '牙刷', '毛巾', '袜子', '充电宝', '数据线', '水杯', '台灯', '床单', '被套',
      '超市', '商场', '优衣库', '香水', '首饰', '手表', '包'
    ],
