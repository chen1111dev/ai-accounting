  }

  /* ------------------------------------------------------------------ */
  /* 首次手势解锁（一次性，绑在 document 上，任何点击都算）                  */
  /* ------------------------------------------------------------------ */

  var unlockedOnce = false;
  function bindUnlockOnce() {
