  }

  global.AJ.petSprite = {
    setActive: setActive,
    isActive: isActive,
    react: react,
    greet: greet,
    poke: poke,
    say: say,
    setSleep: setSleep,
    getPos: getPos,
    setPos: setPos,
    /* 仅暴露给排障/测试用 */
    _tierOf: tierOf
