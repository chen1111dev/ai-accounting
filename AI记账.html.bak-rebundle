    flipBubble = false;
    store.pos = null;
    persist();
    setFace('focus');
    showBubble('我回来啦～');
    feedback('poke');
  }

  /** 睡帽小互动：搬起时紧张，放下时说一句（6s 节流，别每次放下都唠叨） */
  var lastDropLine = 0;

  function enableDrag(pig) {
    var dragging = false;
    var moved = false;
    var suppressClick = false;
    var startX = 0, startY = 0, origLeft = 0, origTop = 0;
    var resetTimer = 0;

    pig.addEventListener('pointerdown', function (e) {
      dragging = true;
      moved = false;
      startX = e.clientX;
      startY = e.clientY;
