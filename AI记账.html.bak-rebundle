  var faceState = 'idle';
  var bubbleOn = false;
  var flipBubble = false;   // 精灵贴左屏时气泡翻向右展开
  var userPlaced = false;   // 被用户拖拽过 → 不再跟随界面默认停靠位

  function syncClass() {
