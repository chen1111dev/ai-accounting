      '  <span class="mascot-coin">¥</span>' +
      '  <span class="mascot-coin">¥</span>' +
      '  <div class="mascot-pig">' + SPRITE_SVG + '</div>' +
      '</div>' +
      /* ⇄ 换一只：和阿账身上那颗是同一个 class（见 app.js 的 setupFloatingPet）。
